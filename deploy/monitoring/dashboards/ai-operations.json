        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(zerosweep_ai_policy_blocks_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
