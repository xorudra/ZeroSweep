# ZeroSweep production environment — TEMPLATE WITH PLACEHOLDERS ONLY.
# Copy to `.env.production` OUTSIDE version control (or inject via your
# secret manager) and replace every value. Never commit a filled copy.
# The API and worker REFUSE to boot in production mode while any value
# still looks like a placeholder (packages/config: validateProductionConfig).

DSRCLONE_VERSION=25.0.0

# Database (external/managed PostgreSQL is equally supported — point
# DATABASE_URL at it and drop the bundled postgres service).
POSTGRES_USER=dsrclone
POSTGRES_PASSWORD=REPLACE-FROM-SECRET-STORE
POSTGRES_DB=dsrclone
DATABASE_URL=postgresql://dsrclone:REPLACE-FROM-SECRET-STORE@postgres:5432/dsrclone?schema=public
DATABASE_CONNECTION_LIMIT=10
DATABASE_REQUIRE_TLS=false

# Redis (password is mandatory in this profile; use rediss:// + set
# REDIS_REQUIRE_TLS=true when fronted by a TLS endpoint).
REDIS_PASSWORD=REPLACE-FROM-SECRET-STORE
REDIS_URL=redis://:REPLACE-FROM-SECRET-STORE@redis:6379
REDIS_REQUIRE_TLS=false

# Object storage (S3-compatible).
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=REPLACE-FROM-SECRET-STORE
MINIO_ROOT_PASSWORD=REPLACE-FROM-SECRET-STORE

# Application secrets.
JWT_SECRET=REPLACE-WITH-AT-LEAST-32-RANDOM-CHARS
API_CORS_ORIGIN=https://app.example.com

# Platform operations (Prompt 38 §160/§166/§27): backup location,
# optional backup-encryption passphrase file (a Docker/K8s secret mount —
# the passphrase itself never lives in this file), and the database
# connection budget used by the production-config gate.
PLATFORM_BACKUP_DIR=/backups
PLATFORM_BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase
DB_CONNECTION_BUDGET=100
PLANNED_REPLICAS=6
# Secret references (§21–§24): production secrets may be given as
# references instead of values. Accepted: env: / file: / docker-secret:
# / k8s-secret: / vault: / aws-sm: / gcp-sm: / azure-kv:
DB_SECRET_REF=env:PROD_DB_PASSWORD
