# Example: single-node production values (Prompt 38 §3). Copy into the
# operator's external env file (deploy/compose/.env.production) — never
# commit a filled copy. Every secret is a placeholder or a reference.
ZEROSWEEP_VERSION=38.0.0
POSTGRES_USER=zerosweep
POSTGRES_PASSWORD=<redacted>
POSTGRES_DB=zerosweep
DATABASE_URL=<redacted>
DATABASE_CONNECTION_LIMIT=10
DATABASE_REQUIRE_TLS=false
REDIS_PASSWORD=<redacted>
REDIS_URL=redis://:REPLACE-FROM-SECRET-STORE@redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=REPLACE-FROM-SECRET-STORE
MINIO_ROOT_PASSWORD=<redacted>
JWT_SECRET=<redacted>
API_CORS_ORIGIN=https://app.example.com
# Platform operations (Prompt 38): backups land here; encryption is ON
# when the passphrase file exists (§166).
PLATFORM_BACKUP_DIR=/backups
PLATFORM_BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase
DB_CONNECTION_BUDGET=100
PLANNED_REPLICAS=6
