{
  "name": "dsrclone",
  "version": "0.1.0",
  "private": true,
  "description": "DSRclone — authorized automated VAPT & security-assessment orchestration platform (GUI-first)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ai": "cd apps/ai && python3 -m pytest -q",
    "db:validate": "pnpm --filter @dsrclone/database prisma:validate",
    "db:generate": "pnpm --filter @dsrclone/database prisma:generate",
    "db:migrate": "pnpm --filter @dsrclone/database prisma:migrate",
    "db:seed": "pnpm --filter @dsrclone/database prisma:seed"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=20" }
}
