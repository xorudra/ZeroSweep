# ZeroSweep local development environment — copy to .env and fill in LOCAL values only.
# Never commit a real .env. Never put production credentials here.
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zerosweep
POSTGRES_USER=zerosweep
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://zerosweep:change-me-local-only@localhost:5432/zerosweep?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=zerosweep-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=zerosweep-artifacts

# API (apps/api)
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

# Web (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# AI service (apps/ai)
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Worker (apps/worker)
WORKER_HEARTBEAT_FILE=/tmp/zerosweep-worker-heartbeat.json
