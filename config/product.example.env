# ZeroSweep product configuration example (Prompt 40 §253–§255).
# Copy the values you need into your deployment environment / .env.
# Secrets are NEVER committed; this file contains no real values.

# Product mode for this deployment (one codebase, §3–§5):
# COMMUNITY | SELF_HOSTED | SAAS | ENTERPRISE
PRODUCT_MODE=SELF_HOSTED

# Release identity reported by health/diagnostics.
RELEASE_VERSION=1.0.0

# Billing (§19–§27). Leave unset for NOT_CONFIGURED (no payment flow
# is simulated). "test" enables the TEST provider only outside
# production NODE_ENV. Card data is never accepted or stored (§26).
# PRODUCT_BILLING_PROVIDER=test
# PRODUCT_BILLING_WEBHOOK_SECRET=

# Licensing (§28–§37). Ed25519 PUBLIC key (PEM) for license
# verification. The application ships/verifies with the public key
# only; the signing private key lives outside the product and outside
# backups (§248).
# PRODUCT_LICENSE_PUBLIC_KEY=
PRODUCT_LICENSE_GRACE_DAYS=14

# Trials (§54).
PRODUCT_TRIAL_DAYS=14

# Platform administrator bootstrap (§96) — comma-separated emails.
# Only accounts whose email appears here AT REGISTRATION TIME receive
# the platform-admin flag. Tenant roles never imply platform access.
# PRODUCT_PLATFORM_ADMIN_EMAILS=

# Product telemetry (§145–§147): aggregate product events only, OFF by
# default, configurable, documented in docs/product/analytics.md.
PRODUCT_TELEMETRY_ENABLED=false

# Update metadata checks (§187): disabled by default; metadata is
# signature-verified and updates are never auto-executed.
PRODUCT_UPDATE_CHECKS_ENABLED=false
