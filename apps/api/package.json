{
  "name": "@dsrclone/api",
  "version": "1.0.0-rc.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:scheduler": "node dist/scheduler-main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@dsrclone/config": "workspace:*",
    "@dsrclone/database": "workspace:*",
    "@dsrclone/logger": "workspace:*",
    "@dsrclone/security-sdk": "workspace:*",
    "@dsrclone/types": "workspace:*",
    "@dsrclone/validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "@dsrclone/orchestration": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "moduleNameMapper": {
      "^@dsrclone/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@dsrclone/validation$": "<rootDir>/../../../packages/validation/src/index.ts",
      "^@dsrclone/config$": "<rootDir>/../../../packages/config/src/index.ts",
      "^@dsrclone/logger$": "<rootDir>/../../../packages/logger/src/index.ts"
    }
  }
}
