    "ioredis": "^5.4.2",
    "@zerosweep/database": "workspace:*",
    "@zerosweep/orchestration": "workspace:*",
    "@zerosweep/types": "workspace:*",
    "@zerosweep/validation": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
