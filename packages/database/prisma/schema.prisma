// DSRclone — single Prisma schema (packages/database owns it; no competing schemas).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- Enums -------------------------------
enum Role {
  OWNER
  ADMIN
  SECURITY_ENGINEER
  ANALYST
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TargetType {
  DOMAIN
  WEB_APPLICATION
  IP_ADDRESS
  CIDR
  API
  GRAPHQL
  SOURCE_REPOSITORY
  APK
  CONTAINER_IMAGE
  DOCKER
  KUBERNETES
  AWS
  AZURE
  GCP
  ACTIVE_DIRECTORY
  BINARY
  WIRELESS_LAB
}

enum TargetStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ARCHIVED
}

enum VerificationMethod {
  DNS_TXT
  HTTP_FILE
  MANUAL_APPROVAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

enum AssessmentProfile {
  PASSIVE_RECON
  WEB_BASELINE
  WEB_COMPREHENSIVE
  API_ASSESSMENT
  NETWORK_ASSESSMENT
  SOURCE_CODE
  CONTAINER
  CLOUD
  MOBILE
  CUSTOM
}

enum AssessmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ScanStatus {
  CREATED
  QUEUED
  PREPARING
  RUNNING
  PAUSING
  PAUSED
  CANCELLING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ScanStageType {
  AUTHORIZATION_CHECK
  SCOPE_VALIDATION
  PASSIVE_RECON
  ASSET_DISCOVERY
  DNS_RESOLUTION
  HTTP_DISCOVERY
  TECHNOLOGY_DETECTION
  PORT_DISCOVERY
  CRAWLING
  CONTENT_DISCOVERY
  ENDPOINT_DISCOVERY
  PARAMETER_DISCOVERY
  WEB_SURFACE_NORMALIZATION
  SAFE_VULNERABILITY_SCAN
  NORMALIZATION
  CORRELATION
  RISK_ANALYSIS
  REPORT_GENERATION
}

enum ScanStageStatus {
  PENDING
  BLOCKED
  READY
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
  CANCELLED
}

enum ToolCategory {
  RECON
  WEB
  NETWORK
  API
  ACTIVE_DIRECTORY
  PASSWORD_AUDIT
  MOBILE
  CLOUD
  CONTAINER
  SOURCE_CODE
  BINARY
  WIRELESS
  REPORTING
}

enum ToolHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
  MISCONFIGURED
}

enum RiskLevel {
  PASSIVE
  LOW
  MODERATE
  INTRUSIVE
  RESTRICTED
}

enum ExecutionMode {
  CONTAINER
  EXTERNAL_API
  ADMIN_PROVIDED
  MOCK
}

enum LicenseType {
  OPEN_SOURCE
  COMMERCIAL
  EXTERNAL_API
  ADMIN_PROVIDED
}

enum ToolExecutionStatus {
  QUEUED
  PREPARING
  RUNNING
  PARSING
  NORMALIZING
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
  TIMED_OUT
}

enum WorkerStatus {
  ONLINE
  BUSY
  DEGRADED
  OFFLINE
  DRAINING
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum FindingStatus {
  OPEN
  CONFIRMED
  ACCEPTED_RISK
  RESOLVED
  FALSE_POSITIVE
}

enum FindingVerificationStatus {
  UNVERIFIED
  LIKELY
  CONFIRMED
  REJECTED
}

enum ReportFormat {
  PDF
  HTML
  JSON
  CSV
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum CredentialType {
  API_KEY
  CLOUD
  SCM_TOKEN
  TOOL_LICENSE
  OTHER
}

enum IntegrationType {
  DEFECTDOJO
  FARADAY
  DRADIS
  PLEXTRAC
  SERPICO
  SHODAN
  CENSYS
  CUSTOM
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  TARGET_CREATED
  TARGET_UPDATED
  TARGET_VERIFIED
  SCOPE_CHANGED
  ASSESSMENT_CREATED
  ASSESSMENT_APPROVED
  SCAN_PLANNED
  SCAN_REQUESTED
  SCAN_STARTED
  SCAN_PAUSED
  SCAN_RESUMED
  SCAN_CANCELLED
  SCAN_COMPLETED
  POLICY_DENIED
  SCOPE_VIOLATION
  REPORT_GENERATED
  CREDENTIAL_CREATED
  ROLE_CHANGED
  TOOL_UPDATED
}

enum NotificationType {
  SCAN_COMPLETED
  SCAN_FAILED
  FINDING_CRITICAL
  APPROVAL_REQUESTED
  SYSTEM
}

// ------------------------------- Identity & tenancy -------------------------------
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String // bcrypt hash only — never a plaintext password
  isActive     Boolean      @default(true)
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([email])
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  memberships Membership[]
  workspaces  Workspace[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets        Target[]
  assessments    Assessment[]
  credentials    Credential[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

// ------------------------------- Targets, verification, scope -------------------------------
model Target {
  id            String               @id @default(uuid())
  workspaceId   String
  name          String
  type          TargetType
  value         String
  description   String?
  status        TargetStatus         @default(DRAFT)
  verified      Boolean              @default(false)
  createdBy     String
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  verifications TargetVerification[]
  scopes        Scope[]
  assets        Asset[]
  assessments   Assessment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([workspaceId])
  @@index([workspaceId, type])
}

model TargetVerification {
  id         String             @id @default(uuid())
  targetId   String
  method     VerificationMethod
  challenge  String // e.g. the DNS TXT value the owner must publish
  status     VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  expiresAt  DateTime?
  target     Target             @relation(fields: [targetId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([targetId])
}

model Scope {
  id          String       @id @default(uuid())
  workspaceId String
  targetId    String
  name        String
  // Structured rules only (validated by @dsrclone/validation): includeHosts,
  // excludeHosts, includeCidrs, allowedPorts, allowedPaths, excludedPaths.
  rules       Json
  target      Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([targetId])
  @@index([workspaceId])
}

// ------------------------------- Discovered surface -------------------------------
model Asset {
  id                 String       @id @default(uuid())
  workspaceId        String
  targetId           String
  host               String
  ip                 String?
  type               String       @default("HOST")
  // Discovered-asset scope verdict (Prompt 4 §33): IN_SCOPE | OUT_OF_SCOPE |
  // PENDING_REVIEW. Out-of-scope assets never become scan targets on their own.
  scopeStatus        String       @default("IN_SCOPE")
  // Provenance (Prompt 5 §18): adapter slugs that discovered this asset —
  // one asset, many sources, never duplicate rows per tool.
  sources            String[]     @default([])
  // Live HTTP status when httpx probed this host (Prompt 5 §32); metadata,
  // never a finding by itself.
  httpStatus         Int?
  // Scan that most recently discovered/refresh this asset — powers the
  // per-scan recon summary (Prompt 5 §46) without inventing a join table.
  discoveredByScanId String?
  target             Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  services           Service[]
  endpoints          Endpoint[]
  technologies       Technology[]
  findings           Finding[]
  firstSeen          DateTime     @default(now())
  lastSeen           DateTime     @updatedAt
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([workspaceId])
  @@index([targetId, host])
}

model Service {
  id        String   @id @default(uuid())
  assetId   String
  port      Int
  protocol  String   @default("tcp")
  name      String?
  product   String?
  version   String?
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetId, port, protocol])
  @@index([assetId])
}

model Endpoint {
  id             String   @id @default(uuid())
  assetId        String
  url            String
  method         String   @default("GET")
  statusCode     Int?
  // Prompt 5 §21/§33: parameter NAMES only (values are redacted before
  // persistence), the discovering adapter, and this endpoint's own scope
  // verdict — third-party historical URLs are stored OUT_OF_SCOPE.
  parameterNames String[] @default([])
  source         String?
  scopeStatus    String   @default("IN_SCOPE")
  // Prompt 6 §16/§26/§41-§42: response-classification metadata (safe fields
  // only — never bodies), route classification label (SENSITIVE_ROUTE is an
  // inventory label, not a finding), full provenance, and resource typing.
  contentType     String?
  contentLength   Int?
  title           String?
  redirectLocation String?
  endpointType    String   @default("UNKNOWN")
  classification  String?
  sources         String[] @default([])
  parameters      EndpointParameter[]
  forms           EndpointForm[]
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assetId])
}

// Prompt 6 §27: discovered parameters as first-class inventory. Only the
// NAME, its location and provenance/confidence are ever stored — sensitive
// parameter VALUES are never persisted anywhere in this schema.
model EndpointParameter {
  id         String   @id @default(uuid())
  endpointId String
  name       String
  location   String   @default("QUERY")
  sources    String[] @default([])
  confidence Float?
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([endpointId, name, location])
  @@index([endpointId])
}

// Prompt 6 §33: form STRUCTURE metadata (action/method/field names) so
// later safe-testing phases can reason about forms. No submitted data, no
// credentials, and nothing here auto-submits anything.
model EndpointForm {
  id           String   @id @default(uuid())
  endpointId   String
  method       String   @default("GET")
  fieldNames   String[] @default([])
  encodingType String?
  source       String?
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([endpointId])
}

// Prompt 6 §10: wordlists are governed PLATFORM data. Administrators manage
// metadata + controlled-storage references; users select wordlists by id or
// profile only — a filesystem path can never enter a scan through this
// table or any API built on it.
model Wordlist {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  category        String
  storageLocation String
  checksum        String
  entryCount      Int      @default(0)
  sizeBytes       Int      @default(0)
  enabled         Boolean  @default(true)
  version         String?
  profiles        String[] @default([])
  technologies    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Technology {
  id         String   @id @default(uuid())
  assetId    String
  name       String
  version    String?
  category   String?
  // Prompt 5 §31: which adapter detected it and with what confidence (0..1).
  // Detection alone never implies a vulnerability.
  source     String?
  confidence Float?
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([assetId])
}

// ------------------------------- Assessments & scans -------------------------------
model Assessment {
  id          String            @id @default(uuid())
  workspaceId String
  targetId    String
  scopeId     String?
  name        String
  profile     AssessmentProfile
  status      AssessmentStatus  @default(DRAFT)
  createdBy   String
  approvedBy  String?
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target      Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  scope       Scope?            @relation(fields: [scopeId], references: [id])
  scans       Scan[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId])
  @@index([targetId])
}

model Scan {
  id           String          @id @default(uuid())
  workspaceId  String
  assessmentId String
  status       ScanStatus      @default(QUEUED)
  currentStage ScanStageType?
  progress     Int             @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  errorSummary String?
  requestedBy  String
  assessment   Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  stages       ScanStage[]
  executions   ToolExecution[]
  findings     Finding[]
  reports      Report[]
  plan         ScanPlan?
  events       ScanEvent[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([workspaceId])
  @@index([assessmentId])
  @@index([status])
}

model ScanStage {
  id           String          @id @default(uuid())
  scanId       String
  type         ScanStageType
  status       ScanStageStatus @default(QUEUED)
  progress     Int             @default(0)
  // DAG edges (stage types within the same scan) + weighted-progress share.
  dependencies String[]        @default([])
  weight       Int             @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  metadata     Json?
  scan         Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  executions   ToolExecution[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([scanId, type])
  @@index([scanId])
}

// ------------------------------- Tools -------------------------------
model Tool {
  id               String           @id @default(uuid())
  slug             String           @unique
  name             String
  category         ToolCategory
  description      String?
  version          String?
  enabled          Boolean          @default(true)
  installed        Boolean          @default(false)
  healthStatus     ToolHealthStatus @default(UNKNOWN)
  riskLevel        RiskLevel        @default(LOW)
  requiresApproval Boolean          @default(false)
  licenseType      LicenseType      @default(OPEN_SOURCE)
  adapters         ToolAdapter[]
  executions       ToolExecution[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([category])
}

model ToolAdapter {
  id               String          @id @default(uuid())
  toolId           String
  adapterVersion   String
  executionMode    ExecutionMode   @default(CONTAINER)
  dockerImage      String?
  supportedTargets Json // TargetType[]
  capabilities     Json // Capability[]
  inputSchema      Json?
  outputFormat     String          @default("JSON")
  parser           String?
  defaultTimeout   Int             @default(600) // seconds
  cpuLimit         String          @default("1")
  memoryLimit      String          @default("512Mi")
  networkPolicy    String          @default("SCOPE_ONLY")
  enabled          Boolean         @default(true)
  tool             Tool            @relation(fields: [toolId], references: [id], onDelete: Cascade)
  executions       ToolExecution[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([toolId, adapterVersion])
  @@index([toolId])
}

model ToolExecution {
  id             String              @id @default(uuid())
  scanId         String
  scanStageId    String?
  toolId         String
  toolAdapterId  String?
  worker         String?
  status         ToolExecutionStatus @default(QUEUED)
  // Deterministic idempotency key: scanId + stageId + attempt (Prompt 4 §15).
  idempotencyKey String?             @unique
  attempt        Int                 @default(1)
  startedAt      DateTime?
  completedAt    DateTime?
  exitCode       Int?
  timeoutSeconds Int?
  outputLocation String? // object-storage key — never bulk raw output in Postgres
  error          String?
  metrics        Json?
  scan           Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanStage      ScanStage?          @relation(fields: [scanStageId], references: [id])
  tool           Tool                @relation(fields: [toolId], references: [id])
  toolAdapter    ToolAdapter?        @relation(fields: [toolAdapterId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([scanId])
  @@index([toolId])
}

// ------------------------------- Findings -------------------------------
model Finding {
  id                 String                    @id @default(uuid())
  workspaceId        String
  scanId             String
  assetId            String?
  title              String
  description        String
  severity           Severity
  confidence         Float                     @default(0.5)
  cvssScore          Float?
  cvssVector         String?
  cve                String?
  cwe                String?
  owaspCategory      String?
  endpoint           String?
  host               String?
  port               Int?
  protocol           String?
  parameter          String?
  technicalImpact    String?
  businessImpact     String?
  remediation        String?
  status             FindingStatus             @default(OPEN)
  verificationStatus FindingVerificationStatus @default(UNVERIFIED)
  duplicateOfId      String?
  fingerprint        String?
  // Provenance (Prompt 4 §35): fixture findings are permanently flagged so
  // they can never be presented as real security results.
  isMock             Boolean                   @default(false)
  toolExecutionId    String?
  firstSeen          DateTime                  @default(now())
  lastSeen           DateTime                  @updatedAt
  scan               Scan                      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset              Asset?                    @relation(fields: [assetId], references: [id])
  duplicateOf        Finding?                  @relation("FindingDuplicates", fields: [duplicateOfId], references: [id])
  duplicates         Finding[]                 @relation("FindingDuplicates")
  evidence           FindingEvidence[]
  references         FindingReference[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([workspaceId])
  @@index([scanId])
  @@index([severity])
  @@index([fingerprint])
}

model FindingEvidence {
  id               String   @id @default(uuid())
  findingId        String
  sourceTool       String
  evidenceType     String   @default("TEXT")
  requestRef       String? // object-storage reference, redacted before display
  responseRef      String?
  artifactLocation String?
  summary          String?
  fingerprint      String?
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([findingId])
}

model FindingReference {
  id        String   @id @default(uuid())
  findingId String
  type      String   @default("URL") // CVE | CWE | OWASP | VENDOR | URL
  label     String
  url       String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([findingId])
}

// ------------------------------- Reports, credentials, integrations -------------------------------
model Report {
  id              String       @id @default(uuid())
  workspaceId     String
  scanId          String
  format          ReportFormat @default(PDF)
  status          ReportStatus @default(PENDING)
  storageLocation String?
  checksum        String?
  generatedBy     String
  generatedAt     DateTime?
  scan            Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId])
  @@index([scanId])
}

model Credential {
  id              String         @id @default(uuid())
  workspaceId     String
  name            String
  type            CredentialType @default(API_KEY)
  provider        String
  // METADATA ONLY: a reference into a secret manager. Secret values are never
  // stored in this table and never returned by the API.
  secretReference String
  createdBy       String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([workspaceId])
}

model Integration {
  id          String          @id @default(uuid())
  workspaceId String
  type        IntegrationType
  name        String
  config      Json? // non-secret configuration only
  enabled     Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId])
}

// ------------------------------- Audit & notifications -------------------------------
model AuditLog {
  id             String      @id @default(uuid())
  actorId        String?
  organizationId String?
  workspaceId    String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  metadata       Json? // never contains passwords, tokens or raw credentials
  ipAddress      String?
  createdAt      DateTime    @default(now())

  @@index([organizationId, createdAt])
  @@index([workspaceId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String?
  type        NotificationType @default(SYSTEM)
  title       String
  body        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, read])
}

// --------------------------- Orchestration (Prompt 4) ---------------------------

// Immutable scan plan (Prompt 4 §4): stages, dependencies, selected tools and
// the frozen policy snapshot, JSON-persisted for auditability. State/progress
// live on Scan/ScanStage, never by mutating this document.
model ScanPlan {
  id             String            @id @default(uuid())
  scanId         String            @unique
  assessmentId   String
  profile        AssessmentProfile
  planVersion    Int               @default(1)
  plan           Json
  policySnapshot Json
  scan           Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([assessmentId])
}

// Durable lifecycle event (Prompt 4 §40/§55) — the timeline source of truth.
// Payloads carry safe metadata only; SSE/WebSocket is presentation transport.
model ScanEvent {
  id          String   @id @default(uuid())
  scanId      String
  workspaceId String
  type        String
  payload     Json?
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([scanId, createdAt])
  @@index([workspaceId])
}

// Registered worker node (Prompt 4 §21–§22). Heartbeats update lastHeartbeat;
// staleness is judged against configurable thresholds, never one missed beat.
model WorkerNode {
  id            String       @id @default(uuid())
  workerId      String       @unique
  hostname      String
  version       String
  status        WorkerStatus @default(ONLINE)
  capabilities  Json // string[]
  activeJobs    Int          @default(0)
  startedAt     DateTime     @default(now())
  lastHeartbeat DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([lastHeartbeat])
}

// Dead-letter record for jobs that exhausted retries (Prompt 4 §30).
// Admin-visible metadata only — never sensitive payloads or credentials.
model DeadLetterJob {
  id            String   @id @default(uuid())
  jobId         String
  queue         String
  scanId        String?
  stageId       String?
  executionId   String?
  errorCategory String
  errorMessage  String?
  attempts      Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([queue])
  @@index([scanId])
  @@index([createdAt])
}
