enum NotificationType {
  SCAN_COMPLETED
  SCAN_FAILED
  FINDING_CRITICAL
  APPROVAL_REQUESTED
  SYSTEM
}

// ------------------------------- Identity & tenancy -------------------------------
enum UserAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  normalizedEmail String            @unique @default("")
  name            String
  passwordHash    String // bcrypt hash only — never a plaintext password
  isActive        Boolean           @default(true)
  status          UserAccountStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  memberships     Membership[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([email])
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id               String                @id @default(uuid())
  name             String
  slug             String                @unique
  status           OrganizationStatus    @default(ACTIVE)
  securityContact  String?
  dataRegion       String?
  memberships      Membership[]
  workspaces       Workspace[]
  workspaceMembers WorkspaceMembership[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
}

// OrganizationMembership (Prompt 23 §7): organization-level role + status.
// The pre-existing Membership model is this record; Prompt 23 extends it
// (invitedBy/joinedAt/REVOKED) rather than creating a parallel system.
model Membership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  invitedBy      String?
  joinedAt       DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model WorkspaceMembership {
  id             String           @id @default(uuid())
  userId         String
  workspaceId    String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  invitedBy      String?
  joinedAt       DateTime?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([organizationId])
}

model Workspace {
  id                          String                       @id @default(uuid())
  organizationId              String
  name                        String
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets                     Target[]
  assessments                 Assessment[]
  credentials                 Credential[]
  scannerInstances            ScannerInstance[]
  sessionProfiles             SessionProfile[]
  scanApprovals               ScanApproval[]
  repositories                SourceRepository[]
  mobileApplications          MobileApplication[]
  mobileDevices               MobileTestDevice[]
  wirelessEnvironments        WirelessEnvironment[]
  wirelessSensors             WirelessSensor[]
  wirelessCaptures            WirelessCapture[]
  wirelessChannelObservations WirelessChannelObservation[]
  workspaceMemberships        WorkspaceMembership[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletedAt                   DateTime?

  @@index([organizationId])
}

// ------------------------------- Targets, verification, scope -------------------------------
model Target {
  id              String               @id @default(uuid())
  workspaceId     String
  name            String
  type            TargetType
  value           String
  description     String?
  status          TargetStatus         @default(DRAFT)
  verified        Boolean              @default(false)
  createdBy       String
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  verifications   TargetVerification[]
  scopes          Scope[]
  assets          Asset[]
  assessments     Assessment[]
  binaryArtifacts BinaryArtifact[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@index([workspaceId])
  @@index([workspaceId, type])
}

model TargetVerification {
  id         String             @id @default(uuid())
  targetId   String
  method     VerificationMethod
  challenge  String // e.g. the DNS TXT value the owner must publish
  status     VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  expiresAt  DateTime?
  target     Target             @relation(fields: [targetId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([targetId])
}

model Scope {
  id          String       @id @default(uuid())
  workspaceId String
  targetId    String
  name        String
  // Structured rules only (validated by @dsrclone/validation): includeHosts,
  // excludeHosts, includeCidrs, allowedPorts, allowedPaths, excludedPaths.
  rules       Json
  target      Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([targetId])
  @@index([workspaceId])
}

// ------------------------------- Discovered surface -------------------------------
model Asset {
  id                   String                  @id @default(uuid())
  workspaceId          String
  targetId             String
  host                 String
  ip                   String?
  type                 String                  @default("HOST")
  // Discovered-asset scope verdict (Prompt 4 §33): IN_SCOPE | OUT_OF_SCOPE |
  // PENDING_REVIEW. Out-of-scope assets never become scan targets on their own.
  scopeStatus          String                  @default("IN_SCOPE")
  // Provenance (Prompt 5 §18): adapter slugs that discovered this asset —
  // one asset, many sources, never duplicate rows per tool.
  sources              String[]                @default([])
  // Live HTTP status when httpx probed this host (Prompt 5 §32); metadata,
  // never a finding by itself.
  httpStatus           Int?
  // Asset criticality for the risk engine (Prompt 7 §36): user/admin
  // classified — CRITICAL | HIGH | MEDIUM | LOW | UNSPECIFIED. Never
  // auto-raised just because a host is internet-facing.
  criticality          String                  @default("UNSPECIFIED")
  // Scan that most recently discovered/refresh this asset — powers the
  // per-scan recon summary (Prompt 5 §46) without inventing a join table.
  discoveredByScanId   String?
  // Prompt 10 §35/§50: OS HINT (never stated as fact) + confidence, and
  // the canonical network/CIDR this host belongs to when known.
  osHint               String?
  osConfidence         Float?
  network              String?
  packetCaptures       PacketCaptureArtifact[]
  wirelessAccessPoints WirelessAccessPoint[]
  target               Target                  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  services             Service[]
  endpoints            Endpoint[]
  technologies         Technology[]
  findings             Finding[]
  firstSeen            DateTime                @default(now())
  lastSeen             DateTime                @updatedAt
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([workspaceId])
  @@index([targetId, host])
}

model Service {
  id         String   @id @default(uuid())
  assetId    String
  port       Int
  protocol   String   @default("tcp")
  name       String?
  product    String?
  version    String?
  // Prompt 10 §29–§36/§49: normalized network service facts. state is
  // OPEN/CLOSED/FILTERED/OPEN_FILTERED/UNKNOWN; banner is SANITIZED at
  // parse time (control chars/escapes stripped, markup neutralized,
  // size-capped) — it is untrusted tool output, never rendered raw;
  // cpe is stored ONLY when a tool actually reported it, never
  // fabricated; sources is the aggregator provenance (adapter slugs).
  state      String   @default("OPEN")
  cpe        String?
  banner     String?
  tls        Boolean?
  confidence Float?
  sources    String[] @default([])
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([assetId, port, protocol])
  @@index([assetId])
}

// Prompt 10 §43: packet-capture artifact METADATA. The capture bytes
// themselves live in object storage (storageKey) — never in the
// database and never served without the VIEW_RAW_PCAP permission + an
// audited RAW_PCAP_ACCESSED event (§47). Retention is policy-driven
// (§48); source distinguishes IMPORTED captures from tcpdump runs.
model PacketCaptureArtifact {
  id              String    @id @default(uuid())
  workspaceId     String
  scanId          String?
  assetId         String?
  toolExecutionId String?
  format          String // PCAP | PCAPNG
  source          String // tcpdump | IMPORT | tshark
  storageKey      String
  sha256          String?
  sizeBytes       Int?
  durationSeconds Int?
  interfaceName   String?
  packetCount     Int?
  retentionUntil  DateTime?
  asset           Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
  @@index([scanId])
}

// Prompt 10 §62: distributed scan chunk bookkeeping — one row per
// bounded target chunk (never one row per host, §5). Status follows the
// chunk through PENDING → RUNNING → COMPLETED/FAILED so an interrupted
// scan resumes from checkpoints instead of restarting (§61).
model NetworkScanChunk {
  id          String    @id @default(uuid())
  workspaceId String
  scanId      String
  chunkId     String
  rangeStart  String
  rangeEnd    String
  hostCount   Int
  status      String    @default("PENDING")
  workerId    String?
  attempt     Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([scanId, chunkId])
  @@index([scanId, status])
  @@index([workspaceId])
}

model Endpoint {
  id               String              @id @default(uuid())
  assetId          String
  url              String
  method           String              @default("GET")
  statusCode       Int?
  // Prompt 5 §21/§33: parameter NAMES only (values are redacted before
  // persistence), the discovering adapter, and this endpoint's own scope
  // verdict — third-party historical URLs are stored OUT_OF_SCOPE.
  parameterNames   String[]            @default([])
  source           String?
  scopeStatus      String              @default("IN_SCOPE")
  // Prompt 6 §16/§26/§41-§42: response-classification metadata (safe fields
  // only — never bodies), route classification label (SENSITIVE_ROUTE is an
  // inventory label, not a finding), full provenance, and resource typing.
  contentType      String?
  contentLength    Int?
  title            String?
  redirectLocation String?
  endpointType     String              @default("UNKNOWN")
  classification   String?
  sources          String[]            @default([])
  // Prompt 9 §35/§37: API operation identity — the spec operationId, the
  // path TEMPLATE (with {param} placeholders, never concrete object ids),
  // declared content types, the reusable schema records this operation
  // uses (§36), and its DECLARED authentication requirement (§19).
  operationId      String?
  path             String?
  contentTypes     String[]            @default([])
  requestSchemaId  String?
  responseSchemaId String?
  authRequired     Boolean?
  authSchemes      String[]            @default([])
  parameters       EndpointParameter[]
  forms            EndpointForm[]
  asset            Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([assetId])
}

// Prompt 6 §27: discovered parameters as first-class inventory. Only the
// NAME, its location and provenance/confidence are ever stored — sensitive
// parameter VALUES are never persisted anywhere in this schema.
model EndpointParameter {
  id         String   @id @default(uuid())
  endpointId String
  name       String
  location   String   @default("QUERY")
  sources    String[] @default([])
  confidence Float?
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([endpointId, name, location])
  @@index([endpointId])
}

// Prompt 6 §33: form STRUCTURE metadata (action/method/field names) so
// later safe-testing phases can reason about forms. No submitted data, no
// credentials, and nothing here auto-submits anything.
model EndpointForm {
  id           String   @id @default(uuid())
  endpointId   String
  method       String   @default("GET")
  fieldNames   String[] @default([])
  encodingType String?
  source       String?
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([endpointId])
}

// Prompt 6 §10: wordlists are governed PLATFORM data. Administrators manage
// metadata + controlled-storage references; users select wordlists by id or
// profile only — a filesystem path can never enter a scan through this
// table or any API built on it.
model Wordlist {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  category        String
  storageLocation String
  checksum        String
  entryCount      Int      @default(0)
  sizeBytes       Int      @default(0)
  enabled         Boolean  @default(true)
  version         String?
  profiles        String[] @default([])
  technologies    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Technology {
  id         String   @id @default(uuid())
  assetId    String
  name       String
  version    String?
  category   String?
  // Prompt 5 §31: which adapter detected it and with what confidence (0..1).
  // Detection alone never implies a vulnerability.
  source     String?
  confidence Float?
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([assetId])
}

// ------------------------------- Assessments & scans -------------------------------
model Assessment {
  id          String            @id @default(uuid())
  workspaceId String
  targetId    String
  scopeId     String?
  name        String
  profile     AssessmentProfile
  status      AssessmentStatus  @default(DRAFT)
  createdBy   String
  approvedBy  String?
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target      Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  scope       Scope?            @relation(fields: [scopeId], references: [id])
  scans       Scan[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId])
  @@index([targetId])
}

model Scan {
  id                 String              @id @default(uuid())
  workspaceId        String
  assessmentId       String
  status             ScanStatus          @default(QUEUED)
  currentStage       ScanStageType?
  progress           Int                 @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  errorSummary       String?
  requestedBy        String
  assessment         Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  stages             ScanStage[]
  executions         ToolExecution[]
  findings           Finding[]
  reports            Report[]
  plan               ScanPlan?
  events             ScanEvent[]
  httpTransactions   HttpTransaction[]
  webSocketEndpoints WebSocketEndpoint[]
  scanApprovals      ScanApproval[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([workspaceId])
  @@index([assessmentId])
  @@index([status])
}

model ScanStage {
  id           String          @id @default(uuid())
  scanId       String
  type         ScanStageType
  status       ScanStageStatus @default(QUEUED)
  progress     Int             @default(0)
  // DAG edges (stage types within the same scan) + weighted-progress share.
  dependencies String[]        @default([])
  weight       Int             @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  metadata     Json?
  scan         Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  executions   ToolExecution[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([scanId, type])
  @@index([scanId])
}

// ------------------------------- Tools -------------------------------
model Tool {
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  category         ToolCategory
  description      String?
  version          String?
  enabled          Boolean           @default(true)
  installed        Boolean           @default(false)
  healthStatus     ToolHealthStatus  @default(UNKNOWN)
  riskLevel        RiskLevel         @default(LOW)
  requiresApproval Boolean           @default(false)
  licenseType      LicenseType       @default(OPEN_SOURCE)
  adapters         ToolAdapter[]
  executions       ToolExecution[]
  scannerInstances ScannerInstance[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([category])
}

model ToolAdapter {
  id               String          @id @default(uuid())
  toolId           String
  adapterVersion   String
  executionMode    ExecutionMode   @default(CONTAINER)
  dockerImage      String?
  supportedTargets Json // TargetType[]
  capabilities     Json // Capability[]
  inputSchema      Json?
  outputFormat     String          @default("JSON")
  parser           String?
  defaultTimeout   Int             @default(600) // seconds
  cpuLimit         String          @default("1")
  memoryLimit      String          @default("512Mi")
  networkPolicy    String          @default("SCOPE_ONLY")
  enabled          Boolean         @default(true)
  tool             Tool            @relation(fields: [toolId], references: [id], onDelete: Cascade)
  executions       ToolExecution[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([toolId, adapterVersion])
  @@index([toolId])
}

model ToolExecution {
  id             String              @id @default(uuid())
  scanId         String
  scanStageId    String?
  toolId         String
  toolAdapterId  String?
  worker         String?
  status         ToolExecutionStatus @default(QUEUED)
  // Deterministic idempotency key: scanId + stageId + attempt (Prompt 4 §15).
  idempotencyKey String?             @unique
  attempt        Int                 @default(1)
  startedAt      DateTime?
  completedAt    DateTime?
  exitCode       Int?
  timeoutSeconds Int?
  outputLocation String? // object-storage key — never bulk raw output in Postgres
  error          String?
  metrics        Json?
  scan           Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanStage      ScanStage?          @relation(fields: [scanStageId], references: [id])
  tool           Tool                @relation(fields: [toolId], references: [id])
  toolAdapter    ToolAdapter?        @relation(fields: [toolAdapterId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([scanId])
  @@index([toolId])
}

// ------------------------------- Findings -------------------------------
model Finding {
  id                      String                          @id @default(uuid())
  workspaceId             String
  scanId                  String
  assetId                 String?
  title                   String
  description             String
  severity                Severity
  confidence              Float                           @default(0.5)
  cvssScore               Float?
  cvssVector              String?
  cve                     String?
  cwe                     String?
  owaspCategory           String?
  endpoint                String?
  host                    String?
  port                    Int?
  protocol                String?
  parameter               String?
  technicalImpact         String?
  businessImpact          String?
  remediation             String?
  status                  FindingStatus                   @default(OPEN)
  verificationStatus      FindingVerificationStatus       @default(UNVERIFIED)
  duplicateOfId           String?
  fingerprint             String?
  // Prompt 7: curated vulnerability class + cross-tool correlation state.
  vulnClass               String?
  // Contributing tool slugs after correlation (§18/§21): one canonical
  // finding, many sources; duplicates point at it via duplicateOfId and
  // their evidence rows are re-homed here, never deleted (§20).
  sources                 String[]                        @default([])
  // Deterministic risk engine output (§34/§35): 0–100 score, band and the
  // explained inputs (JSON: base/confidence/criticality/exposure factors).
  riskScore               Float?
  riskBand                String?
  riskExplanation         Json?
  confidenceBand          String?
  // Manual review workflow (§32/§33): who reviewed, when, and why. The
  // original scanner evidence is never overwritten by a review.
  reviewStatus            String?
  reviewedBy              String?
  reviewedAt              DateTime?
  reviewNotes             String?
  // Provenance (Prompt 4 §35): fixture findings are permanently flagged so
  // they can never be presented as real security results.
  isMock                  Boolean                         @default(false)
  toolExecutionId         String?
  // Prompt 11: vulnerability-management layer (§47 lifecycle, §39/§40
  // priority separate from severity, §41–§43 SLA, §44 ownership, §46 tags).
  lifecycleStatus         VmLifecycleStatus               @default(NEW)
  detectionKind           String                          @default("DETECTED_VULNERABILITY") // DETECTED_VULNERABILITY | POTENTIAL_EXPOSURE (§34)
  cpe                     String?
  priority                String? // P0..P4 remediation priority (§40)
  riskFactors             Json? // Risk Engine V2 factor breakdown (§38)
  riskCalcVersion         String?
  intelSnapshot           Json? // intelligence snapshot/version used (§31)
  // Prompt 30 §60: point-in-time vulnerability-intelligence enrichment.
  vulnEnrichment          FindingVulnerabilityEnrichment?
  intelCvssScore          Float? // intelligence CVSS — preserved separately from the scanner score (§32)
  epssScore               Float?
  epssPercentile          Float?
  kevListed               Boolean                         @default(false)
  exploitRefExists        Boolean                         @default(false)
  assignedToId            String?
  assignedToTeam          String?
  assignedBy              String?
  assignedAt              DateTime?
  tags                    String[]                        @default([])
  slaPolicyId             String?
  dueAt                   DateTime?
  resolvedAt              DateTime?
  reopenedAt              DateTime?
  recurrenceCount         Int                             @default(0)
  riskAcceptanceReason    String?
  riskAcceptedBy          String?
  riskAcceptanceExpiresAt DateTime?
  // Prompt 12 §59: source-code finding location + dependency extensions.
  // Paths are repository-relative ONLY (§60); snippets live in evidence
  // rows (redacted, §62) — never the raw source, never a raw secret.
  repositoryId            String?
  snapshotId              String?
  filePath                String?
  startLine               Int?
  endLine                 Int?
  startColumn             Int?
  endColumn               Int?
  ruleId                  String?
  codeFlow                Json?
  componentPurl           String?
  fixedVersion            String?
  dependencyScope         String?
  reachability            String?
  baselineStatus          String? // NEW | EXISTING vs the previous snapshot (§79)
  // Prompt 13 §94/§51/§103: cloud-native finding identity. origin
  // distinguishes static configuration analysis from live cluster
  // observation; correlation preserves BOTH as observations (§103).
  // Image findings are bound to the strongest identity — the digest.
  origin                  String? // STATIC_CONFIGURATION_FINDING | LIVE_CLUSTER_FINDING | IMAGE_FINDING | DOCKER_HOST_FINDING | RUNTIME_CORRELATED
  imageDigest             String?
  imageRef                String?
  clusterRef              String?
  namespace               String?
  resourceKind            String?
  resourceName            String?
  containerName           String?
  controlId               String? // CIS / NSA-CISA control id for posture findings (§31/§41)
  // Prompt 14 §58/§61: multi-cloud finding identity. findingClass keeps
  // CLOUD_MISCONFIGURATION / IAM_RISK / PUBLIC_EXPOSURE / ENCRYPTION_GAP
  // / LOGGING_GAP / COMPLIANCE_FAILURE / POTENTIAL_VULNERABILITY /
  // CONFIRMED_VULNERABILITY distinguishable; the cloud fingerprint is
  // provider + account + region + providerResourceId + rule + class.
  cloudProvider           String? // AWS | AZURE | GCP
  cloudAccountId          String?
  cloudResourceId         String?
  providerResourceId      String?
  cloudRegion             String?
  findingClass            String?
  // Prompt 15 §61/§67: Active Directory finding identity — the domain
  // row the finding belongs to and the directory object (SID / object
  // id) it concerns. Identity metadata only: no credential material,
  // no password hashes (§19) can ever be stored on a finding.
  directoryDomainId       String?
  directoryObjectId       String?
  // Prompt 16 §36/§37: validation confidence is tracked SEPARATELY from
  // scanner confidence and from severity. A successful safe validation
  // may raise verificationStatus to CONFIRMED (deterministic proof only)
  // and stamps lastValidatedAt — original scanner evidence is never
  // overwritten (§37).
  validationConfidence    String? // UNVERIFIED | LIKELY | VERIFIED | INCONCLUSIVE (§36)
  lastValidatedAt         DateTime?
  // Prompt 17 §49–§52: mobile finding identity. The build hash is the
  // immutable build identity (§5); crossBuildFingerprint deliberately
  // EXCLUDES it so the same root issue correlates across builds while
  // build-specific observations stay separate (§51). Dynamic
  // confirmation is recorded, never merged away (§88).
  mobileApplicationId     String?
  mobileBuildId           String?
  mobileBuildHash         String?
  mobilePlatform          String? // ANDROID | IOS
  mobileFindingType       String? // MOBILE_MISCONFIGURATION | MOBILE_CODE_FINDING | MOBILE_SECRET | MOBILE_DEPENDENCY_VULNERABILITY | MOBILE_BINARY_FINDING | MOBILE_NETWORK_FINDING | MOBILE_RUNTIME_FINDING
  mobileComponent         String? // app component / file the finding concerns
  owaspMobile             String? // OWASP Mobile Top 10 category (§46)
  masvsControl            String? // OWASP MASVS control id (§47)
  crossBuildFingerprint   String?
  dynamicConfirmed        Boolean                         @default(false)
  // Prompt 18 (§50–§63): binary extension block — the registered
  // binary artifact (identity = SHA-256), §56 finding type, concerned
  // function/library/section, §62 reachability evidence state (never
  // an exploitability claim), §57 cross-build fingerprint (absolute
  // addresses excluded by construction), §63 static confidence band.
  binaryArtifactId        String?
  binaryArtifactHash      String?
  binaryFindingType       String?
  binaryComponent         String?
  binaryReachability      String?
  binaryFingerprint       String?
  staticConfidence        String?
  binaryArtifact          BinaryArtifact?                 @relation(fields: [binaryArtifactId], references: [id], onDelete: SetNull)
  // Prompt 19 (§52/§53): wireless extension block — the registered
  // wireless environment, the AP identity (BSSID, §5), the §52
  // finding type and the §53 canonical fingerprint (environment +
  // BSSID + rule + security mode + class — never the SSID alone).
  wirelessEnvironmentId   String?
  wirelessAccessPointId   String?
  wirelessBssid           String?
  wirelessFindingType     String?
  wirelessFingerprint     String?
  wirelessEnvironment     WirelessEnvironment?            @relation(fields: [wirelessEnvironmentId], references: [id], onDelete: SetNull)
  wirelessAccessPoint     WirelessAccessPoint?            @relation(fields: [wirelessAccessPointId], references: [id], onDelete: SetNull)
  // Prompt 20 §5/§6: unified finding source domain + category so every
  // engine's findings are queryable in one architecture without
  // flattening domain identity. sourceDomain: WEB | NETWORK | API |
  // RECON | SAST | SCA | SECRET | CONTAINER | KUBERNETES | CLOUD |
  // IDENTITY | MOBILE | BINARY | WIRELESS | MANUAL | EXTERNAL_IMPORT.
  // category: VULNERABILITY | MISCONFIGURATION | SECRET | IAM_RISK |
  // PUBLIC_EXPOSURE | COMPLIANCE_FAILURE | CODE_FINDING |
  // DEPENDENCY_VULNERABILITY | RUNTIME_EVENT | WIRELESS_FINDING |
  // BINARY_FINDING | MOBILE_FINDING (§6).
  sourceDomain            String?
  category                String?
  // Prompt 20 §18: non-destructive grouping of related findings.
  clusterId               String?
  // Prompt 20 §21: risk context signals consumed by Risk Engine V3.
  dataSensitivity         String? // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED (asset-owner classified)
  environment             String? // PRODUCTION | STAGING | DEVELOPMENT | LAB (as recorded, never inferred)
  // Prompt 20 §28–§30: SLA timer deadlines (triage/remediation/retest)
  // + auditable pause state. dueAt above remains the remediation
  // deadline written by the Prompt 11 engine.
  triageDueAt             DateTime?
  retestDueAt             DateTime?
  slaPausedAt             DateTime?
  slaPauseReason          String?
  cluster                 FindingCluster?                 @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  ownership               FindingOwnership?
  riskExceptions          RiskException[]
  correlationsFrom        FindingCorrelation[]            @relation("CorrelationFrom")
  correlationsTo          FindingCorrelation[]            @relation("CorrelationTo")
  externalReferences      ExternalFindingReference[]
  secretMetadata          SecretFindingMetadata?
  observations            FindingObservation[]
  comments                FindingComment[]
  exploitReferences       ExploitReference[]
  retests                 RetestRequest[]
  validationRequests      ValidationRequest[]
  manualValidations       ManualValidationRecord[]
  firstSeen               DateTime                        @default(now())
  lastSeen                DateTime                        @updatedAt
  scan                    Scan                            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset                   Asset?                          @relation(fields: [assetId], references: [id])
  duplicateOf             Finding?                        @relation("FindingDuplicates", fields: [duplicateOfId], references: [id])
  duplicates              Finding[]                       @relation("FindingDuplicates")
  evidence                FindingEvidence[]
  references              FindingReference[]
  history                 FindingHistory[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([workspaceId])
  @@index([scanId])
  @@index([assetId])
  @@index([severity])
  @@index([status])
  @@index([fingerprint])
  @@index([cve])
  @@index([cwe])
  @@index([verificationStatus])
  @@index([createdAt])
  @@index([workspaceId, lifecycleStatus])
  @@index([workspaceId, priority])
  @@index([assignedToId])
  @@index([dueAt])
  @@index([kevListed])
  @@index([firstSeen])
  @@index([lastSeen])
  @@index([cloudAccountId])
  @@index([cloudResourceId])
  @@index([providerResourceId])
  @@index([directoryDomainId])
  @@index([directoryObjectId])
  @@index([mobileApplicationId])
  @@index([mobileBuildId])
  @@index([crossBuildFingerprint])
  @@index([binaryArtifactId])
  @@index([binaryFingerprint])
  @@index([wirelessEnvironmentId])
  @@index([wirelessAccessPointId])
  @@index([wirelessFingerprint])
  @@index([workspaceId, sourceDomain])
  @@index([workspaceId, category])
  @@index([workspaceId, environment])
  @@index([clusterId])
}

// Immutable finding lifecycle events (Prompt 7 §37): created, severity
// changed, reviewed, confirmed, false positive, accepted risk, resolved,
// reopened — the audit trail retesting relies on. Rows are append-only.
model FindingHistory {
  id          String   @id @default(uuid())
  findingId   String
  workspaceId String
  event       String // CREATED | SEVERITY_CHANGED | REVIEWED | CONFIRMED | FALSE_POSITIVE | ACCEPTED_RISK | RESOLVED | REOPENED | CORRELATED | RISK_RECALCULATED
  actorId     String?
  notes       String?
  metadata    Json?
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([findingId])
  @@index([workspaceId])
}

model FindingEvidence {
  id               String   @id @default(uuid())
  findingId        String
  sourceTool       String
  evidenceType     String   @default("TEXT")
  requestRef       String? // object-storage reference, redacted before display
  responseRef      String?
  artifactLocation String?
  summary          String?
  fingerprint      String?
  // Prompt 7 §29: where the tool matched + scanner metadata (check id,
  // signature family, redacted request/response snippets, checksums).
  matchedAt        String?
  metadata         Json?
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([findingId])
}

model FindingReference {
  id        String   @id @default(uuid())
  findingId String
  type      String   @default("URL") // CVE | CWE | OWASP | VENDOR | URL
  label     String
  url       String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([findingId])
}

// ------------------------------- Vulnerability intelligence (Prompt 11) -------------------------------
// Global, shared reference data (§100): CVE/CWE/CPE/EPSS/KEV records are
// public metadata cached locally (§87) — one record per identifier, never
// one per finding (§23). Tenant-specific relationships live on Finding.

model CveRecord {
  id           String    @id @default(uuid())
  cveId        String    @unique
  description  String
  publishedAt  DateTime?
  modifiedAt   DateTime?
  cvssScore    Float?
  cvssVector   String?
  cvssVersion  String? // kept distinct — vectors are never silently converted (§26)
  cweIds       String[]  @default([])
  references   Json      @default("[]")
  source       String // e.g. NVD
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cveId])
}

model CweRecord {
  id           String    @id @default(uuid())
  cweId        String    @unique // CWE-79
  name         String
  description  String
  category     String?
  // Prompt 30 §16: weakness hierarchy + lifecycle status. Parents are
  // recorded relationships from the source catalog, never inferred.
  parentCweIds String[]  @default([])
  status       String    @default("STABLE") // STABLE | DEPRECATED | OBSOLETE
  references   Json      @default("[]")
  source       String    @default("CURATED")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CpeRecord {
  id           String    @id @default(uuid())
  canonical    String    @unique // cpe:2.3:a:vendor:product:version:*:*:*:*:*:*:*
  part         String // a | h | o
  vendor       String
  product      String
  version      String?
  cveIds       String[]  @default([]) // governed CPE→CVE links (§33)
  source       String    @default("SCANNER")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vendor, product])
}

model EpssRecord {
  id         String   @id @default(uuid())
  cveId      String
  score      Float // probability 0..1 — context, never severity (§27)
  percentile Float
  date       DateTime
  source     String   @default("FIRST_EPSS")
  createdAt  DateTime @default(now())

  @@unique([cveId, date])
  @@index([cveId])
}

model KevRecord {
  id                 String    @id @default(uuid())
  cveId              String    @unique
  dateAdded          DateTime?
  vendorProject      String?
  product            String?
  vulnerabilityName  String?
  requiredAction     String?
  dueDate            DateTime?
  knownRansomwareUse String?
  source             String    @default("CISA_KEV")
  // Prompt 30 §23/§24: catalog provenance + lifecycle. A CVE the catalog
  // retracts becomes REMOVED — the row is preserved (history), never
  // deleted, and stops counting as actively KEV-listed.
  catalogSource      String    @default("CISA_KEV")
  status             String    @default("ACTIVE") // ACTIVE | REMOVED
  removedAt          DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Per-source sync bookkeeping (§30): incremental sync, checksum, retry /
// backoff, last-success tracking. NEVER_SYNCED is the honest initial state.
model IntelligenceSyncState {
  id            String    @id @default(uuid())
  source        String    @unique // NVD | FIRST_EPSS | CISA_KEV | CURATED_CWE
  status        String    @default("NEVER_SYNCED") // NEVER_SYNCED | SYNCED | FAILED
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  checksum      String?
  recordCount   Int       @default(0)
  detail        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// --------------------- Advanced vulnerability intelligence (Prompt 30) ---------------------
// Global public intelligence (CVE/CVSS/EPSS/KEV/products/patches) is
// shared reference data with per-field provenance (§6); tenant exposure
// (component matches, enrichments, risk history) is workspace-scoped
// and never crosses organizations (§155). Every value below originates
// from a parsed provider record — the platform never invents a score,
// a fixed version, or an affected range.

// §3: the vulnerability identity record. Status (§5): PUBLISHED |
// MODIFIED | REJECTED | WITHDRAWN | UNKNOWN. Rejected/withdrawn CVEs
// are preserved but never treated as active vulnerabilities.
model VulnerabilityRecord {
  id               String    @id @default(uuid())
  cveId            String    @unique
  status           String    @default("UNKNOWN")
  publishedAt      DateTime?
  modifiedAt       DateTime?
  description      String    @default("")
  descriptionLang  String    @default("en")
  // §6: field-level provenance { description: {source, at}, cvss: {...} }.
  provenance       Json      @default("{}")
  source           String // primary source, e.g. NVD
  snapshotChecksum String? // checksum of the provider snapshot that last updated this record
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

// §12–§15: one row per (CVE, CVSS version, source). Multiple sources and
// multiple CVSS versions coexist; the preferred assessment is SELECTED
// deterministically at read time — rows are never rewritten (§15).
model CvssAssessment {
  id                 String    @id @default(uuid())
  cveId              String
  version            String // 2.0 | 3.0 | 3.1 | 4.0
  vector             String?
  baseScore          Float
  severity           String?
  temporalScore      Float?
  environmentalScore Float?
  source             String
  publishedAt        DateTime?
  observedAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())

  @@unique([cveId, version, source])
  @@index([cveId])
}

// §17: CVE → CWE mappings (many-to-many, provenance per mapping).
model VulnerabilityWeaknessMapping {
  id        String   @id @default(uuid())
  cveId     String
  cweId     String
  source    String
  createdAt DateTime @default(now())

  @@unique([cveId, cweId, source])
  @@index([cveId])
  @@index([cweId])
}

// §24/§25: KEV catalog lifecycle events — added / updated / removed.
// CVE_ADDED_TO_KEV events drive impact re-evaluation (§26).
model KevCatalogEvent {
  id         String   @id @default(uuid())
  cveId      String
  eventType  String // ADDED | UPDATED | REMOVED
  source     String   @default("CISA_KEV")
  detail     Json     @default("{}")
  occurredAt DateTime @default(now())

  @@index([cveId])
  @@index([eventType])
}

// §28: normalized software product identity.
model SoftwareProduct {
  id             String            @id @default(uuid())
  vendor         String
  product        String
  normalizedName String // lower(vendor):lower(product)
  ecosystem      String? // npm | pypi | maven | ... | os | generic
  metadata       Json              @default("{}")
  versions       SoftwareVersion[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([normalizedName, ecosystem])
  @@index([vendor, product])
}

// §29: a known version of a product (identity for range endpoints).
model SoftwareVersion {
  id                String   @id @default(uuid())
  productId         String
  version           String
  normalizedVersion String
  releaseMetadata   Json     @default("{}")
  createdAt         DateTime @default(now())

  product SoftwareProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedVersion])
  @@index([productId])
}

// §32: PURL ↔ CPE ↔ vendor/product mapping with confidence + source.
model SoftwareIdentifierMapping {
  id         String   @id @default(uuid())
  purl       String?
  cpe        String?
  ecosystem  String?
  vendor     String
  product    String
  confidence String // EXACT | HIGH | MEDIUM | LOW
  source     String
  createdAt  DateTime @default(now())

  @@index([purl])
  @@index([cpe])
  @@index([vendor, product])
}

// §37: a product a CVE affects, per a governed source.
model VulnerabilityAffectedProduct {
  id              String                 @id @default(uuid())
  cveId           String
  vendor          String
  product         String
  identifier      String? // CPE or PURL the source used
  identifierType  String? // CPE | PURL
  platformContext String?
  source          String
  ranges          AffectedVersionRange[]
  createdAt       DateTime               @default(now())

  @@unique([cveId, vendor, product, identifier])
  @@index([cveId])
  @@index([vendor, product])
}

// §35/§36/§39: version range for one affected product. Branch-specific
// ranges are separate rows — never flattened into one global fix (§39).
model AffectedVersionRange {
  id                  String   @id @default(uuid())
  cveId               String
  affectedProductId   String?
  vendor              String
  product             String
  ecosystem           String?
  introducedVersion   String?
  fixedVersion        String?
  lastAffectedVersion String?
  rangeExpression     String? // source range text, e.g. CPE criteria / GHSA range
  confidence          String   @default("MEDIUM") // LOW | MEDIUM | HIGH (§36)
  source              String
  createdAt           DateTime @default(now())

  affectedProduct VulnerabilityAffectedProduct? @relation(fields: [affectedProductId], references: [id], onDelete: SetNull)

  @@index([cveId])
  @@index([vendor, product])
}

// §44/§45: security advisories. One CVE may have many advisories; all
// are preserved with provenance. References are validated http/https
// strings only — never fetched by the backend (§128/§129).
model SecurityAdvisory {
  id            String    @id @default(uuid())
  provider      String // NVD | GHSA | OSV | vendor slug
  advisoryId    String
  title         String
  publishedAt   DateTime?
  updatedAt     DateTime?
  references    Json      @default("[]")
  cveIds        String[]  @default([])
  fixedVersions Json      @default("{}") // productKey -> fixed version(s), as the advisory states
  source        String
  createdAt     DateTime  @default(now())

  @@unique([provider, advisoryId])
  @@index([advisoryId])
}

// §41–§43: patch intelligence. fixedVersion exists ONLY where a reliable
// source provides it (§85); status (§42): PATCH_AVAILABLE |
// FIXED_VERSION_AVAILABLE | MITIGATION_ONLY | NO_KNOWN_FIX | UNKNOWN.
model PatchRecord {
  id            String    @id @default(uuid())
  cveId         String
  productKey    String // normalized vendor:product or purl-ish key
  affectedRange String?
  fixedVersion  String?
  advisoryId    String? // SecurityAdvisory.advisoryId that supports this record
  mitigation    String? // vendor/authoritative mitigation text/reference (§43)
  releaseDate   DateTime?
  status        String    @default("UNKNOWN")
  confidence    String    @default("MEDIUM")
  source        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([cveId, productKey, source])
  @@index([cveId])
  @@index([status])
}

// §72–§75: exploit context — DEFENSIVE METADATA ONLY. There is no column
// that could hold exploit code, payloads, or instructions (§73/§159).
model ExploitContext {
  id                   String   @id @default(uuid())
  cveId                String   @unique
  publicExploitKnown   Boolean  @default(false)
  exploitationObserved Boolean  @default(false)
  kevListed            Boolean  @default(false)
  exploitMaturity      String   @default("UNKNOWN") // §74 maturity ladder
  source               String
  confidence           String   @default("LOW")
  references           Json     @default("[]") // validated http/https reference metadata only
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@index([exploitMaturity])
}

// §53–§56: component ↔ vulnerability correlation result (tenant-scoped).
// matchType (§55): PURL_EXACT | CPE_EXACT | PACKAGE_EXACT | VERSION_RANGE
// | SCANNER_CONFIRMED | HEURISTIC. HEURISTIC ⇒ POTENTIALLY_AFFECTED,
// never AFFECTED (§52/§56). affectedStatus (§54): AFFECTED |
// NOT_AFFECTED | POTENTIALLY_AFFECTED | UNKNOWN.
model ComponentVulnerabilityMatch {
  id             String   @id @default(uuid())
  workspaceId    String
  componentId    String // SoftwareComponent.id
  cveId          String
  matchType      String
  confidence     String // EXACT | HIGH | MEDIUM | LOW | AMBIGUOUS (§50)
  affectedStatus String
  evidence       Json     @default("{}")
  firstDetected  DateTime @default(now())
  lastEvaluated  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  component SoftwareComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, componentId, cveId])
  @@index([workspaceId, cveId])
  @@index([workspaceId, affectedStatus])
  @@index([componentId])
}

// §76/§77: reachability for a component in a CVE context. NOT_REACHABLE
// requires positive evidence — a failed static search is UNKNOWN (§77).
model ComponentReachabilityAssessment {
  id          String   @id @default(uuid())
  workspaceId String
  componentId String
  cveId       String?
  status      String // UNKNOWN | POTENTIALLY_REACHABLE | REACHABLE | NOT_REACHABLE
  confidence  String   @default("LOW")
  evidence    Json     @default("{}")
  assessedAt  DateTime @default(now())

  @@index([workspaceId, componentId])
  @@index([cveId])
}

// §60/§61: finding enrichment snapshot — the intelligence context a
// finding's risk was computed with, so history stays reproducible.
model FindingVulnerabilityEnrichment {
  id              String   @id @default(uuid())
  workspaceId     String
  findingId       String   @unique
  cveId           String?
  preferredCvss   Json? // { score, version, vector, source } as selected at enrichment time
  epssScore       Float?
  epssPercentile  Float?
  kevListed       Boolean  @default(false)
  patchStatus     String   @default("UNKNOWN")
  componentId     String?
  intelSnapshotId String
  enrichedAt      DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cveId])
  @@index([findingId])
}

// §90: risk recalculation history driven by intelligence changes — old
// score, new score, reason, and the intelligence snapshot used.
model IntelligenceRiskHistory {
  id              String   @id @default(uuid())
  workspaceId     String
  findingId       String
  oldScore        Float?
  newScore        Float?
  reason          String
  intelSnapshotId String
  createdAt       DateTime @default(now())

  @@index([workspaceId, findingId])
  @@index([findingId])
}

// §69–§71: material disagreement between trusted sources. Conflicting
// records are PRESERVED; resolution is deterministic source priority
// plus optional analyst review — never silent overwrite.
model VulnerabilityIntelConflict {
  id           String    @id @default(uuid())
  cveId        String
  conflictType String // CVSS_MISMATCH | VERSION_RANGE_MISMATCH | FIXED_VERSION_MISMATCH | CWE_MISMATCH | STATUS_MISMATCH
  detail       Json      @default("{}") // per-source values, verbatim
  status       String    @default("OPEN") // OPEN | REVIEWED
  resolution   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([cveId])
  @@index([status])
}

// §68: per-provider health/freshness. A provider outage marks freshness
// — it never erases existing intelligence (§67).
model VulnerabilityIntelProviderHealth {
  id             String    @id @default(uuid())
  provider       String    @unique // NVD | FIRST_EPSS | CISA_KEV | OSV | GHSA
  status         String    @default("NOT_CONFIGURED") // OK | DEGRADED | DOWN | NOT_CONFIGURED
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  latencyMs      Int?
  rateLimitState String    @default("UNKNOWN")
  freshness      String    @default("NEVER_SYNCED")
  detail         String?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
}

// §98 companion: workspace watchlist — CVEs/components an operator is
// tracking. Criteria are data (filters), never executable expressions.
model VulnerabilityWatchlist {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  cveIds      String[] @default([])
  criteria    Json     @default("{}")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

// A public exploit REFERENCE (§20): "a public exploit reference exists" —
// never a claim that the target is exploitable (§21). Reference-only.
model ExploitReference {
  id               String   @id @default(uuid())
  findingId        String
  source           String // SEARCHSPLOIT
  externalId       String // EDB-ID
  title            String
  reference        String
  platform         String?
  type             String?
  verifiedMetadata Json?
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([findingId, source, externalId])
  @@index([findingId])
}

// One canonical vulnerability, many scan-specific observations (§62).
model FindingObservation {
  id                 String   @id @default(uuid())
  findingId          String
  workspaceId        String
  scanId             String?
  sourceTool         String
  sourceFingerprint  String   @default("")
  severity           String
  summary            String?
  observedAt         DateTime @default(now())
  // Prompt 20 §4: the complete observation contract — tool version,
  // scanner instance, target/asset identity, raw vs normalized severity,
  // rule/check id, location, evidence + raw-artifact references,
  // confidence and verification state at observation time. Every field
  // is metadata: raw evidence lives behind the artifact reference and
  // inherits the platform redaction discipline.
  toolVersion        String?
  scannerInstanceId  String?
  assetId            String?
  targetRef          String?
  rawSeverity        String?
  normalizedSeverity String?
  ruleId             String?
  location           String?
  evidenceRef        String?
  confidence         Float?
  verificationState  String?
  rawArtifactRef     String?
  finding            Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, sourceTool, sourceFingerprint])
  @@index([findingId])
  @@index([workspaceId])
  @@index([scanId])
}

model FindingComment {
  id          String   @id @default(uuid())
  findingId   String
  workspaceId String
  authorId    String
  text        String // sanitized at the API boundary (§45)
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([findingId])
  @@index([workspaceId])
}

// Configurable SLA policy (§41) — rules map priority (or severity) to a
// resolution window in hours. Never one hardcoded organization's policy.
model RemediationSlaPolicy {
  id                        String   @id @default(uuid())
  workspaceId               String
  name                      String
  rules                     Json // { "P0": 24, "P1": 48, ... } hours, priority-first (§42)
  isDefault                 Boolean  @default(false)
  createdBy                 String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  // Prompt 31 §21/§23/§54: orchestration policy extensions. `conditions`
  // carries the resolver matchers (severity/priority sets, KEV,
  // internet-exposure, asset criticality, finding category) plus the
  // target duration in hours; `version` is snapshotted onto every case
  // SLA so a historical due date stays explainable (§24). The flat
  // P0..P4 `rules` map remains the fallback duration source.
  version                   Int      @default(1)
  conditions                Json? // { severities?, priorities?, kevOnly?, internetExposed?, criticalities?, categories?, targetHours, verificationRequired?, requiredCleanObservations?, dualApprovalForHighRisk? }
  warningThresholds         Json? // { warningPct?, atRiskPct? } of target duration elapsed
  escalation                Json? // { escalateTo?, managementRoute? }
  verificationRequired      Boolean  @default(true)
  requiredCleanObservations Int      @default(1)
  active                    Boolean  @default(true)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// A targeted retest request (§55–§58): reuses the ORIGINAL safe detection
// mechanism, re-passes authorization/scope/policy/budget gates, and ends
// RESOLVED or REOPENED with both evidence sets preserved.
model RetestRequest {
  id               String    @id @default(uuid())
  findingId        String
  workspaceId      String
  requestedBy      String
  status           String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | DENIED | FAILED
  sourceTool       String
  checkReference   String?
  scanId           String?
  result           String? // RESOLVED | REOPENED
  previousEvidence Json?
  newEvidence      Json?
  startedAt        DateTime?
  completedAt      DateTime?
  finding          Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([findingId])
  @@index([workspaceId])
  @@index([status])
}

// Scanner report import (§74–§76): preview first; out-of-scope data is
// rejected or quarantined, never silently committed.
model ScannerReportImport {
  id          String   @id @default(uuid())
  workspaceId String
  scanner     String // nessus-professional | greenbone-openvas
  scanId      String?
  status      String   @default("PREVIEW") // PREVIEW | COMMITTED | REJECTED | QUARANTINED
  fileName    String?
  checksum    String
  summary     Json     @default("{}")
  warnings    Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([status])
}

// ------------------------------- Reports, credentials, integrations -------------------------------
model Report {
  id              String       @id @default(uuid())
  workspaceId     String
  scanId          String
  format          ReportFormat @default(PDF)
  status          ReportStatus @default(PENDING)
  storageLocation String?
  checksum        String?
  generatedBy     String
  generatedAt     DateTime?
  scan            Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId])
  @@index([scanId])
}

model Credential {
  id              String         @id @default(uuid())
  workspaceId     String
  name            String
  type            CredentialType @default(API_KEY)
  provider        String
  // METADATA ONLY: a reference into a secret manager. Secret values are never
  // stored in this table and never returned by the API.
  secretReference String
  createdBy       String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([workspaceId])
}

model Integration {
  id                String          @id @default(uuid())
  workspaceId       String
  type              IntegrationType
  name              String
  config            Json? // non-secret configuration only
  enabled           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  // Prompt 24 §3: enterprise integration registry fields. Credentials
  // exist ONLY as a secret REFERENCE (§7) — there is deliberately no
  // column that could hold a token, app secret or webhook secret.
  organizationId    String?
  status            String          @default("PENDING") // PENDING | CONNECTED | DEGRADED | DISCONNECTED | DISABLED | AUTHENTICATION_FAILED (§5)
  configuration     Json? // provider-specific NON-SECRET configuration (§3)
  secretReference   String? // secret reference name only — never a value (§7)
  secretRotatedAt   DateTime? // §8: UI shows configured + last rotated, never the value
  credentialType    String? // GITHUB_APP | PAT | OAUTH | PROJECT_TOKEN | WEBHOOK_SECRET | API_TOKEN (§8)
  capabilities      Json            @default("[]")
  createdBy         String?
  lastHealthCheckAt DateTime?
  lastSyncAt        DateTime?
  healthDetail      Json? // §95: auth / reachability / rate-limit / webhook-state summary — no secrets
  lastErrorCategory String? // §95: AUTH | RATE_LIMIT | NETWORK | PROVIDER_ERROR | NOT_CONFIGURED | null

  @@index([workspaceId])
  @@index([organizationId])
}

// --------------- Proxy scanners: instances, sessions, traffic, approvals (Prompt 8) ---------------
enum ScannerDeploymentType {
  MANAGED_DAEMON
  ADMIN_PROVIDED
  IMPORT_ONLY
}

enum ScannerHealthStatus {
  NOT_CONFIGURED
  HEALTHY
  DEGRADED
  UNAVAILABLE
  MISCONFIGURED
}

enum SessionProfileType {
  ANONYMOUS
  AUTHENTICATED
  API_AUTHENTICATED
}

enum AuthenticationMode {
  FORM
  BASIC
  BEARER
  API_KEY
  COOKIE
  OAUTH
  CUSTOM_HEADER
}

enum ScanApprovalStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALIDATED
}

// A registered scanner deployment (§15). endpointReference is an OPAQUE
// name resolved only from server-side configuration — never a URL, and
// URL-shaped values are rejected at the API. credentialReference is the
// NAME of a secret in the secret store; secret values are never stored
// here, never logged and never returned by any API (§15/§20).
model ScannerInstance {
  id                   String                @id @default(uuid())
  organizationId       String
  workspaceId          String?
  toolId               String
  name                 String
  endpointReference    String
  deploymentType       ScannerDeploymentType @default(MANAGED_DAEMON)
  credentialReference  String?
  declaredCapabilities Json                  @default("[]")
  detectedCapabilities Json                  @default("[]")
  // Prompt 11 §7/§12: administrator-approved logical-profile → scanner
  // policy/config mappings + last reported feed/plugin state. Ordinary
  // users never see or submit raw scanner policy identifiers.
  config               Json                  @default("{}")
  healthStatus         ScannerHealthStatus   @default(NOT_CONFIGURED)
  version              String?
  licenseState         String?
  lastHealthCheckAt    DateTime?
  lastHealthDetail     String?
  enabled              Boolean               @default(true)
  createdBy            String
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tool                 Tool                  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organizationId])
  @@index([workspaceId])
  @@index([toolId])
}

// A reusable scan session (§18): metadata + credential REFERENCE only.
// Cookie/header policies name NAMES, never values (§20).
model SessionProfile {
  id                  String                  @id @default(uuid())
  workspaceId         String
  name                String
  type                SessionProfileType      @default(ANONYMOUS)
  credentialReference String?
  cookiePolicy        Json?
  headerPolicy        Json?
  validation          Json?
  createdBy           String
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authProfiles        AuthenticationProfile[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([workspaceId])
}

// How a session authenticates (§19): modes + field/header NAMES only.
// There is deliberately no script field — arbitrary login scripts are
// never accepted or executed.
model AuthenticationProfile {
  id                  String             @id @default(uuid())
  sessionProfileId    String
  mode                AuthenticationMode
  loginUrl            String?
  usernameField       String?
  passwordField       String?
  tokenHeaderName     String?
  credentialReference String?
  config              Json?
  sessionProfile      SessionProfile     @relation(fields: [sessionProfileId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([sessionProfileId])
}

// Observed HTTP traffic (§25/§26): metadata, hashes, sizes, object-storage
// references and REDACTED display copies only. Raw bodies live in object
// storage; they are never stored in Postgres.
model HttpTransaction {
  id                  String   @id @default(uuid())
  scanId              String
  workspaceId         String
  assetId             String?
  endpointId          String?
  toolExecutionId     String?
  method              String
  url                 String
  host                String
  statusCode          Int?
  source              String // connector slug that observed the transaction
  scopeStatus         String   @default("IN_SCOPE")
  apiKind             String?
  requestHash         String?
  responseHash        String?
  requestSize         Int?
  responseSize        Int?
  requestArtifactRef  String?
  responseArtifactRef String?
  requestRedacted     String?
  responseRedacted    String?
  observedAt          DateTime @default(now())
  scan                Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([scanId])
  @@index([workspaceId])
  @@index([host])
}

// WebSocket endpoints observed by proxy connectors (§49): inventory only.
model WebSocketEndpoint {
  id          String   @id @default(uuid())
  scanId      String
  workspaceId String
  url         String
  origin      String?
  subprotocol String?
  source      String
  scopeStatus String   @default("IN_SCOPE")
  // Prompt 9 §32: whether the observed handshake carried authentication
  // material — PRESENCE only; the material itself is never stored.
  authPresent Boolean?
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([scanId, url])
  @@index([scanId])
}

// ------------------------------- API security (Prompt 9) -------------------------------
// The API inventory graph (§37): services → specifications → operations
// (Endpoint rows) → parameters/schemas → auth contexts → findings. Raw
// specification documents live in object storage (artifactRef +
// checksum); only parsed metadata is stored here (§6). No credential
// VALUES exist anywhere in these models — references only (§18/§21).

model ApiService {
  id                 String   @id @default(uuid())
  workspaceId        String
  assetId            String
  baseUrl            String
  host               String
  // REST | GRAPHQL | WEBSOCKET | UNKNOWN (§3)
  apiType            String   @default("UNKNOWN")
  version            String?
  // NONE | BASIC | BEARER | API_KEY | COOKIE | OAUTH2 | CUSTOM_HEADER (§19)
  authenticationType String?
  specificationId    String?
  source             String
  scopeStatus        String   @default("IN_SCOPE")
  firstSeen          DateTime @default(now())
  lastSeen           DateTime @updatedAt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([assetId, baseUrl])
  @@index([workspaceId])
  @@index([assetId])
}

model ApiSpecification {
  id             String   @id @default(uuid())
  workspaceId    String
  targetId       String?
  assetId        String?
  apiServiceId   String?
  // OPENAPI | SWAGGER | POSTMAN_COLLECTION | INSOMNIA_EXPORT | GRAPHQL_SCHEMA
  kind           String
  version        String?
  source         String
  // sha256 of the raw document + its object-storage reference (§6).
  checksum       String
  artifactRef    String?
  location       String?
  // PENDING | PARSED | FAILED | REJECTED
  parsedStatus   String   @default("PENDING")
  operationCount Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
  @@index([targetId])
  @@index([assetId])
}

model ApiSchema {
  id             String   @id @default(uuid())
  workspaceId    String
  apiServiceId   String?
  name           String
  schemaType     String
  requiredFields String[] @default([])
  // property name → type/format summary. STRUCTURE ONLY (§36): example
  // values and real data never enter schema records.
  properties     Json     @default("{}")
  source         String
  artifactRef    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
  @@index([apiServiceId])
}

model GraphqlService {
  id                     String   @id @default(uuid())
  workspaceId            String
  assetId                String?
  endpointUrl            String
  schemaAvailable        Boolean  @default(false)
  queries                Int      @default(0)
  mutations              Int      @default(0)
  subscriptions          Int      @default(0)
  types                  Int      @default(0)
  authenticationRequired Boolean?
  source                 String
  scopeStatus            String   @default("IN_SCOPE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([workspaceId, endpointUrl])
  @@index([workspaceId])
}

model JwtProfile {
  id              String    @id @default(uuid())
  workspaceId     String
  scanId          String?
  targetId        String?
  // sha256 fingerprint of the token (§25). The RAW TOKEN IS NEVER STORED.
  fingerprint     String
  algorithm       String
  tokenType       String?
  keyId           String?
  issuer          String?
  audience        String[]  @default([])
  expiresAt       DateTime?
  notBefore       DateTime?
  issuedAt        DateTime?
  lifetimeSeconds Int?
  // Claim names with safe values only — sensitive claim values were
  // replaced by REDACTED markers during inspection (§24/§25).
  claimsSummary   Json      @default("{}")
  source          String
  host            String?
  endpoint        String?
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
  @@index([scanId])
  @@index([fingerprint])
}

// An authentication context for API testing (§20/§21): a ROLE bound to
// Phase 8 profile records by id + a credential REFERENCE. No values.
model ApiAuthContext {
  id                      String   @id @default(uuid())
  workspaceId             String
  apiServiceId            String?
  // ANONYMOUS | USER_A | USER_B | ADMIN_TEST
  role                    String
  authenticationProfileId String?
  sessionProfileId        String?
  credentialReference     String?
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([workspaceId])
  @@index([apiServiceId])
}

// Authorization test case ARCHITECTURE (§42): a design record for a
// future, separately-approved test. approvalStatus starts NOT_APPROVED
// and NOTHING executes these records in this phase — no cross-account
// object access, no enumeration of other users' objects.
model AuthorizationTestCase {
  id                 String   @id @default(uuid())
  workspaceId        String
  endpointId         String?
  // Object identifier TEMPLATE (e.g. {userId}) — never a real user's id.
  objectIdentifier   String?
  identityAContextId String?
  identityBContextId String?
  expectedAccess     String?
  observedAccess     String?
  // NOT_APPROVED | APPROVED | REJECTED
  approvalStatus     String   @default("NOT_APPROVED")
  createdBy          String
  createdAt          DateTime @default(now())

  @@index([workspaceId])
}

// Safe test-data profile (§18): values an authorized admin provides for
// future schema testing. The platform never invents production-like
// data and never defaults to real customer data.
model TestDataProfile {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  values      Json     @default("{}")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

// A human approval for an intrusive capability (§41–§43): bound to a scope
// snapshot hash — any later scope change invalidates it at gate time.
model ScanApproval {
  id                String             @id @default(uuid())
  workspaceId       String
  assessmentId      String
  scanId            String?
  capability        String
  scannerInstanceId String?
  scopeId           String?
  scopeSnapshot     Json
  scopeSnapshotHash String
  policySnapshot    Json?
  status            ScanApprovalStatus @default(ACTIVE)
  approvedBy        String
  approvedAt        DateTime           @default(now())
  expiresAt         DateTime
  revokedBy         String?
  revokedAt         DateTime?
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scan              Scan?              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([workspaceId])
  @@index([assessmentId])
  @@index([scanId])
}

// ------------------------------- Audit & notifications -------------------------------
model AuditLog {
  id             String      @id @default(uuid())
  actorId        String?
  organizationId String?
  workspaceId    String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  metadata       Json? // never contains passwords, tokens or raw credentials
  ipAddress      String?
  createdAt      DateTime    @default(now())

  @@index([organizationId, createdAt])
  @@index([workspaceId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String?
  type        NotificationType @default(SYSTEM)
  title       String
  body        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, read])
}

// --------------------------- Orchestration (Prompt 4) ---------------------------

// Immutable scan plan (Prompt 4 §4): stages, dependencies, selected tools and
// the frozen policy snapshot, JSON-persisted for auditability. State/progress
// live on Scan/ScanStage, never by mutating this document.
model ScanPlan {
  id             String            @id @default(uuid())
  scanId         String            @unique
  assessmentId   String
  profile        AssessmentProfile
  planVersion    Int               @default(1)
  plan           Json
  policySnapshot Json
  scan           Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([assessmentId])
}

// Durable lifecycle event (Prompt 4 §40/§55) — the timeline source of truth.
// Payloads carry safe metadata only; SSE/WebSocket is presentation transport.
model ScanEvent {
  id          String   @id @default(uuid())
  scanId      String
  workspaceId String
  type        String
  payload     Json?
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([scanId, createdAt])
  @@index([workspaceId])
}

// Registered worker node (Prompt 4 §21–§22). Heartbeats update lastHeartbeat;
// staleness is judged against configurable thresholds, never one missed beat.
model WorkerNode {
  id            String       @id @default(uuid())
  workerId      String       @unique
  hostname      String
  version       String
  // Prompt 10 §23: worker type — GENERAL_WEB | NETWORK_EXTERNAL |
  // NETWORK_INTERNAL | PACKET_ANALYSIS. The scheduler matches stage
  // tools to workers by type + capabilities (§24); privileged/internal
  // workers stay isolated and never receive a Docker socket.
  workerType    String       @default("GENERAL_WEB")
  status        WorkerStatus @default(ONLINE)
  capabilities  Json // string[]
  activeJobs    Int          @default(0)
  startedAt     DateTime     @default(now())
  lastHeartbeat DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([lastHeartbeat])
}

// Dead-letter record for jobs that exhausted retries (Prompt 4 §30).
// Admin-visible metadata only — never sensitive payloads or credentials.
model DeadLetterJob {
  id            String   @id @default(uuid())
  jobId         String
  queue         String
  scanId        String?
  stageId       String?
  executionId   String?
  errorCategory String
  errorMessage  String?
  attempts      Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([queue])
  @@index([scanId])
  @@index([createdAt])
}

// ------------------------------- Prompt 12: Source Code Security -------------------------------

enum SourceKind {
  GIT_REPOSITORY
  UPLOADED_ARCHIVE
  LOCAL_SOURCE_SNAPSHOT
}

enum SecretType {
  API_KEY
  TOKEN
  PRIVATE_KEY
  PASSWORD
  DATABASE_CREDENTIAL
  CLOUD_CREDENTIAL
  CERTIFICATE_SECRET
  GENERIC_SECRET
}

enum SecretLifecycleStatus {
  OPEN
  ROTATION_REQUIRED
  ROTATED
  FALSE_POSITIVE
  ACCEPTED_RISK
  RESOLVED
}

enum SecretVerificationStatus {
  NOT_VERIFIED
  VERIFIED_ACTIVE
  VERIFIED_INACTIVE
  VERIFICATION_FAILED
}

enum SbomFormat {
  CYCLONEDX_JSON
  SPDX_JSON
  SPDX_TAG_VALUE
}

enum QualityGateStatus {
  PASSED
  FAILED
  WARNING
  NOT_EVALUATED
}

// A registered source repository (Prompt 12 §3). The repository is a
// first-class TARGET (linked Target of type SOURCE_REPOSITORY): scans
// still require the target VERIFIED + assessment APPROVED. Credentials
// are secret REFERENCES only (§4) — no URL here ever embeds one.
model SourceRepository {
  id                  String                @id @default(uuid())
  organizationId      String
  workspaceId         String
  targetId            String?
  name                String
  provider            String?
  remoteUrl           String?
  defaultBranch       String?
  visibility          String                @default("PRIVATE")
  sourceKind          SourceKind
  credentialReference String?
  // Registered snapshot manifest for LOCAL_SOURCE_SNAPSHOT / archive
  // intake: { files: [{path, sizeBytes}], manifests: {path: content} }.
  // Manifest contents are the repository's own declarations (data).
  snapshotManifest    Json?
  createdBy           String
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots           SourceSnapshot[]
  exclusions          SourceScanExclusion[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([workspaceId])
  @@index([targetId])
}

// An immutable acquired snapshot (§5): content-hashed at acquisition,
// never modified in place. `files` is the capped file listing (paths +
// sizes); `manifests` holds manifest/lockfile contents for inventory.
model SourceSnapshot {
  id                String                    @id @default(uuid())
  repositoryId      String
  scanId            String?
  commitSha         String?
  branch            String?
  snapshotHash      String
  artifactReference String?
  sourceKind        SourceKind
  fileCount         Int                       @default(0)
  totalSizeBytes    BigInt                    @default(0)
  files             Json                      @default("[]")
  manifests         Json                      @default("{}")
  languages         Json                      @default("[]")
  frameworks        String[]                  @default([])
  buildSystems      String[]                  @default([])
  repository        SourceRepository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  components        SoftwareComponent[]
  sboms             SoftwareBillOfMaterials[]
  createdAt         DateTime                  @default(now())

  @@index([repositoryId])
  @@index([scanId])
  @@index([snapshotHash])
}

// One inventoried software component (§45) — PURL identity (§46).
model SoftwareComponent {
  id                   String                        @id @default(uuid())
  snapshotId           String?
  // Prompt 13 §13/§14: image package inventory (Syft) binds components
  // to the image instead of a source snapshot — same component model.
  imageId              String?
  // Prompt 17 §42: mobile dependency inventory binds components to the
  // mobile build — same component model, never invented versions (§45).
  buildId              String?
  // Prompt 18 §26: binary dependency inventory binds components to the
  // binary artifact — same component model; a version exists ONLY
  // where reliably known (§25), never inferred from a soname major.
  binaryArtifactId     String?
  name                 String
  version              String?
  ecosystem            String
  purl                 String
  sourceManifest       String
  scope                String                        @default("UNKNOWN") // DIRECT | TRANSITIVE | UNKNOWN
  dependencyScope      String                        @default("RUNTIME")
  licenses             String[]                      @default([])
  supplier             String?
  snapshot             SourceSnapshot?               @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  image                ContainerImage?               @relation(fields: [imageId], references: [id], onDelete: Cascade)
  build                MobileBuild?                  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  binaryArtifact       BinaryArtifact?               @relation(fields: [binaryArtifactId], references: [id], onDelete: Cascade)
  // Prompt 30 §53: vulnerability correlation results for this component.
  vulnerabilityMatches ComponentVulnerabilityMatch[]
  createdAt            DateTime                      @default(now())

  @@unique([snapshotId, purl])
  @@unique([imageId, purl])
  @@unique([buildId, purl])
  @@unique([binaryArtifactId, purl])
  @@index([snapshotId])
  @@index([imageId])
  @@index([buildId])
  @@index([binaryArtifactId])
  @@index([ecosystem, name])
}

// A generated SBOM (§47/§48): document lives in object storage behind
// artifactReference; the row carries format + checksum + counts.
model SoftwareBillOfMaterials {
  id               String          @id @default(uuid())
  snapshotId       String?
  // Prompt 13 §12: image SBOMs bind to the image (Syft), not a snapshot.
  imageId          String?
  // Prompt 17 §43: mobile SBOMs bind to the build (MobileBuild → SBOM
  // → Components → CVEs, §44).
  buildId          String?
  // Prompt 18 §27: binary SBOMs bind to the artifact the same way.
  binaryArtifactId String?
  scanId           String?
  format           SbomFormat
  specVersion      String
  checksum         String
  artifactRef      String?
  componentCount   Int             @default(0)
  snapshot         SourceSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  image            ContainerImage? @relation(fields: [imageId], references: [id], onDelete: Cascade)
  build            MobileBuild?    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  binaryArtifact   BinaryArtifact? @relation(fields: [binaryArtifactId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([snapshotId])
  @@index([imageId])
  @@index([buildId])
  @@index([binaryArtifactId])
  @@index([scanId])
}

// Secret finding metadata (§40) — the ONLY persisted representation of
// a detected secret. There is deliberately NO column that could hold
// the raw value: type + detector + location + one-way fingerprint +
// redacted preview only (§101).
model SecretFindingMetadata {
  id                 String                   @id @default(uuid())
  findingId          String                   @unique
  secretType         SecretType
  detector           String
  fingerprint        String
  redactedPreview    String?
  filePath           String?
  startLine          Int?
  endLine            Int?
  commitSha          String?
  verificationStatus SecretVerificationStatus @default(NOT_VERIFIED)
  lifecycleStatus    SecretLifecycleStatus    @default(OPEN)
  firstSeenAt        DateTime                 @default(now())
  lastSeenAt         DateTime                 @updatedAt
  finding            Finding                  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
  @@index([lifecycleStatus])
}

// Governed source exclusion (§85/§86): explicit, reasoned, audited.
model SourceScanExclusion {
  id            String           @id @default(uuid())
  repositoryId  String
  exclusionType String // PATH | RULE | FILE_FINGERPRINT | FINDING_FINGERPRINT | DEPENDENCY
  pattern       String
  reason        String
  createdBy     String
  repository    SourceRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@index([repositoryId])
}

// The quality-gate verdict for a source scan (§81/§82).
model QualityGateResult {
  id            String            @id @default(uuid())
  scanId        String
  snapshotId    String?
  // Prompt 17 §90: mobile gate verdicts bind to the assessed build.
  buildId       String?
  status        QualityGateStatus
  policyVersion String
  failedRules   Json              @default("[]")
  warningRules  Json              @default("[]")
  summary       Json              @default("{}")
  evaluatedAt   DateTime          @default(now())

  @@index([scanId])
  @@index([buildId])
}

// ─────────────────────────────────────────────────────────────────────
// Prompt 13 — Container, Docker & Kubernetes security (§4–§63).
// Images are NEVER executed (§9): every record here is static metadata
// (layers, configuration, manifests, inventory). Credentials exist ONLY
// as secret references (§7/§33) — there is deliberately no column that
// could hold a registry password, kubeconfig or cluster token.
// ─────────────────────────────────────────────────────────────────────

// A container registry connection (§6/§7). URLs pass the platform
// network/SSRF policy before approval; credentials are references only.
model ContainerRegistry {
  id                  String           @id @default(uuid())
  workspaceId         String
  name                String
  url                 String
  provider            String           @default("GENERIC") // GENERIC | DOCKER_HUB | GHCR | ECR | GCR | ACR | HARBOR | QUAY | PRIVATE
  credentialReference String? // secret reference name only — never a value
  approved            Boolean          @default(false)
  // Prompt 14 §51: a cloud-provider registry (ECR / ACR / Artifact
  // Registry) links to its cloud account + inventory resource where
  // evidence permits — images keep flowing through ContainerImage.
  cloudAccountId      String?
  cloudResourceId     String?
  createdBy           String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  images              ContainerImage[]

  @@unique([workspaceId, url])
  @@index([workspaceId])
}

// A container image asset (§5). Digest is the strongest identity: a tag
// is mutable and is only the lookup key. Scans record the digest they
// analyzed; drift appends a snapshot, never overwrites history (§78).
model ContainerImage {
  id              String                    @id @default(uuid())
  workspaceId     String
  targetId        String?
  registryId      String?
  reference       String // full reference as registered/observed (registry/repo[:tag][@digest])
  registry        String // registry host, e.g. ghcr.io
  repository      String
  tag             String?
  digest          String? // sha256:... — strongest identity
  platform        String?
  architecture    String?
  os              String?
  source          String                    @default("MANUAL") // MANUAL | REGISTRY | SBOM | CI | RUNTIME | CLUSTER
  firstSeen       DateTime                  @default(now())
  lastSeen        DateTime                  @updatedAt
  registryRef     ContainerRegistry?        @relation(fields: [registryId], references: [id], onDelete: SetNull)
  snapshots       ContainerImageSnapshot[]
  components      SoftwareComponent[]
  sboms           SoftwareBillOfMaterials[]
  // Prompt 18 §4: binaries extracted from this image are binary
  // artifacts with their own provenance — never duplicated payloads.
  binaryArtifacts BinaryArtifact[]

  @@unique([workspaceId, registry, repository, digest])
  @@index([workspaceId])
  @@index([workspaceId, repository])
  @@index([digest])
}

// One immutable image observation (§5/§78): the digest a scan resolved
// and analyzed, plus static config metadata (user, exposed ports,
// entrypoint presence) and layer digests. A changed digest for the same
// tag is drift — a NEW snapshot, never an overwrite.
model ContainerImageSnapshot {
  id             String         @id @default(uuid())
  imageId        String
  scanId         String?
  digest         String
  previousDigest String?
  drift          Boolean        @default(false)
  config         Json           @default("{}") // user, exposedPorts, entrypointPresent, cmdPresent, envKeys (names only)
  layers         Json           @default("[]") // layer digests + sizes only
  baseImage      Json? // { registry, repository, digest? } only when reliably known (§23)
  capturedAt     DateTime       @default(now())
  image          ContainerImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([scanId])
}

// A Docker host / daemon asset (§27). Posture is assessed from governed
// Docker Bench output on an APPROVED host by a dedicated privileged
// worker (§28/§29) — the platform never demands daemon socket access.
model DockerHost {
  id               String    @id @default(uuid())
  workspaceId      String
  targetId         String?
  name             String
  engineVersion    String?
  os               String?
  environment      String    @default("UNKNOWN") // PRODUCTION | STAGING | DEVELOPMENT | CI | UNKNOWN
  scanStatus       String    @default("NOT_ASSESSED")
  lastAssessmentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId])
}

// A Kubernetes cluster connection (§32/§33). The API server is stored as
// a REFERENCE (never a URL carrying credentials); the credential is a
// secret reference to a least-privilege, read-oriented service account.
// Cluster-admin is never assumed or requested by default.
model KubernetesCluster {
  id                  String                  @id @default(uuid())
  workspaceId         String
  targetId            String?
  name                String
  apiServerReference  String // reference name only — no embedded credentials, ever
  version             String?
  provider            String                  @default("GENERIC") // GENERIC | EKS | AKS | GKE | OPENSHIFT | ON_PREM
  credentialReference String? // secret reference name only — never a value
  // Prompt 14 §50: an EKS / AKS / GKE cluster discovered in cloud
  // inventory LINKS to this row — never a duplicate cluster entity.
  cloudAccountId      String?
  cloudResourceId     String?
  environment         String                  @default("UNKNOWN")
  criticality         String                  @default("MEDIUM")
  lastAssessmentAt    DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  workloads           KubernetesWorkload[]
  // Prompt 34 §76: RBAC inventory (roles + bindings as data).
  roles               KubernetesRole[]
  roleBindings        KubernetesRoleBinding[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// A Kubernetes workload inventory row (§37/§38). Stores identity,
// security-context summary and image references (digests when known) —
// Secret VALUES are never part of inventory (§36/§105).
model KubernetesWorkload {
  id              String            @id @default(uuid())
  workspaceId     String
  clusterId       String
  scanId          String?
  kind            String // Deployment | StatefulSet | DaemonSet | Job | CronJob | Pod | ReplicaSet
  namespace       String
  name            String
  replicas        Int?
  serviceAccount  String?
  images          Json              @default("[]") // [{ container, image, digest?, tagPinned, digestPinned }]
  securityContext Json              @default("{}") // privileged, runAsRoot, readOnlyRootFilesystem, capabilities, hostPath...
  exposure        String            @default("CLUSTER_INTERNAL") // PUBLIC_INTERNET | EXTERNAL_NETWORK | CLUSTER_INTERNAL | LOCAL_ONLY | UNKNOWN (§64)
  labels          Json              @default("{}") // sanitized metadata only (§109)
  firstSeen       DateTime          @default(now())
  lastSeen        DateTime          @updatedAt
  cluster         KubernetesCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, kind, namespace, name])
  @@index([workspaceId])
  @@index([clusterId])
}

// A static infrastructure manifest under analysis (§48): Dockerfile,
// Kubernetes YAML or Helm chart from a source snapshot. YAML is hostile
// input — only counts, checksum and type are kept here (§49).
model InfrastructureManifest {
  id            String   @id @default(uuid())
  workspaceId   String
  repositoryId  String?
  snapshotId    String?
  scanId        String?
  filePath      String // repository-relative only
  manifestType  String // DOCKERFILE | KUBERNETES | HELM_CHART | HELM_VALUES | COMPOSE
  resourceCount Int      @default(0)
  checksum      String
  source        String   @default("SOURCE_SNAPSHOT")
  createdAt     DateTime @default(now())

  @@index([workspaceId])
  @@index([snapshotId])
}

// A compliance framework catalog entry (§55): CIS Docker, CIS
// Kubernetes, NSA/CISA Kubernetes Hardening. Mappings support reporting
// structure only — the platform never claims certification.
model ComplianceFramework {
  id            String                  @id @default(uuid())
  key           String // CIS_DOCKER | … (P13) | ISO_27001 | SOC_2 | … (P26 §3)
  name          String
  version       String
  description   String
  // Prompt 26 §3/§5: GRC framework registry fields. Versions are
  // immutable after publication (§4) — enforced in the GRC service.
  publisher     String                  @default("")
  status        String                  @default("ACTIVE") // DRAFT | ACTIVE | DEPRECATED | RETIRED
  effectiveDate DateTime?
  retiredDate   DateTime?
  metadata      Json                    @default("{}")
  controls      ComplianceControl[]
  requirements  ComplianceRequirement[]

  // P13 uniqueness was on key alone; GRC versions a framework by
  // (key, version) so V1 and V2 coexist (§4/§122).
  @@unique([key, version])
  @@index([status])
}

model ComplianceControl {
  id          String              @id @default(uuid())
  frameworkId String
  controlId   String // e.g. 5.4 (CIS Kubernetes), 4.2.1 (CIS Docker)
  title       String
  description String
  framework   ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, controlId])
  @@index([frameworkId])
}

enum ControlAssessmentStatus {
  PASS
  FAIL
  WARN
  NOT_APPLICABLE
  UNKNOWN
}

// One control evaluation against one subject (§56). PASS / WARN /
// NOT_APPLICABLE / UNKNOWN never become findings; FAIL may link the
// finding it produced. Evidence is bounded and sanitized.
model ControlAssessment {
  id           String                  @id @default(uuid())
  workspaceId  String
  scanId       String?
  frameworkKey String
  controlId    String
  subjectRef   String // cluster / docker host / workload / image reference
  status       ControlAssessmentStatus
  evidence     String                  @default("")
  findingId    String?
  assessedAt   DateTime                @default(now())

  @@index([workspaceId])
  @@index([scanId])
  @@index([frameworkKey, controlId])
}

// A normalized runtime security event (§59) ingested from a Falco-class
// sensor through the DEDICATED ingestion path (never a scan worker).
// Process/path/command metadata is sanitized before storage (§60):
// stored-XSS and log-injection safe, secrets redacted. Runtime events
// are detections, not vulnerabilities (§63).
model RuntimeSecurityEvent {
  id          String   @id @default(uuid())
  workspaceId String
  clusterId   String?
  clusterName String?
  node        String?
  namespace   String?
  pod         String?
  container   String?
  rule        String
  priority    String // EMERGENCY | ALERT | CRITICAL | ERROR | WARNING | NOTICE | INFORMATIONAL | DEBUG
  eventTime   DateTime
  metadata    Json     @default("{}") // sanitized fields only
  source      String   @default("FALCO")
  artifactRef String?
  ingestedAt  DateTime @default(now())

  @@index([workspaceId])
  @@index([clusterId])
  @@index([eventTime])
}

// ------------------------------- Prompt 14: Multi-Cloud Security -------------------------------

enum CloudProvider {
  AWS
  AZURE
  GCP
}

// A registered cloud account / subscription / project (§4). The account
// is assessed READ-ONLY (§7): the platform stores the credential
// REFERENCE only — an AWS secret access key, Azure client secret, GCP
// service-account private key, access token or refresh token NEVER
// appears in this table or anywhere in ordinary storage (§6).
model CloudAccount {
  id                  String                   @id @default(uuid())
  workspaceId         String
  targetId            String?
  provider            CloudProvider
  name                String
  // AWS account id / Azure tenant+subscription / GCP project id — the
  // provider's own identifier for the assessed estate. NOT a credential.
  externalAccountId   String
  environment         String                   @default("UNKNOWN") // PRODUCTION | STAGING | DEVELOPMENT | TEST | SANDBOX | CI | UNKNOWN (Prompt 34 §7)
  criticality         String                   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  // Prompt 34 §6/§8: the authorization record this account is assessed
  // under — an APPROVED assessment / engagement reference. Assessment
  // is refused when it is absent, expired or provider-mismatched.
  authorizationId     String?
  credentialReference String? // secret reference name only — never a value
  // Assessment posture (§7): READ_ONLY is the only posture ordinary
  // assessments may hold; the field exists so policy can name it.
  assessmentPolicy    String                   @default("READ_ONLY")
  status              String                   @default("REGISTERED") // REGISTERED | VALIDATED | NOT_CONFIGURED | VALIDATION_FAILED
  identityMetadata    Json? // §9: non-secret identity metadata (assumed role ARN, tenant, project) — never tokens
  lastInventoryAt     DateTime?
  lastAssessmentAt    DateTime?
  createdBy           String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  scopes              CloudScope[]
  resources           CloudResource[]
  snapshots           CloudInventorySnapshot[]
  identities          CloudIdentity[]
  relationships       CloudRelationship[]
  riskPaths           CloudRiskPath[]
  driftEvents         CloudDriftEvent[]
  leases              CredentialLease[]
  // Prompt 34: governed connection tests (§12) + per-resource
  // immutable configuration snapshots (§17).
  connectionTests     CloudConnectionTest[]
  resourceSnapshots   CloudResourceSnapshot[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId])
  @@index([workspaceId, provider])
}

// The assessed estate boundary (§5): explicit inclusions and exclusions
// of regions / subscriptions / projects / resources. Discovered
// resources outside the scope are recorded OUT_OF_SCOPE, never assessed.
model CloudScope {
  id               String       @id @default(uuid())
  workspaceId      String
  cloudAccountId   String
  includeRegions   String[]     @default([])
  excludeRegions   String[]     @default([])
  includeUnits     String[]     @default([]) // Azure subscriptions / GCP projects+folders / AWS OUs
  excludeUnits     String[]     @default([])
  includeResources String[]     @default([]) // provider resource ids / ARNs
  excludeResources String[]     @default([])
  account          CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId])
  @@index([cloudAccountId])
}

// One normalized cloud resource (§14): bounded, security-relevant
// metadata ONLY. Customer data inside resources (objects, secret
// values, key material, database contents) is never collected (§13).
// Tags/labels are provider-controlled text: sanitized before storage
// (§99). A resource that disappears is marked NOT_SEEN / REMOVED —
// historical records are never hard-deleted (§20).
model CloudResource {
  id                    String                  @id @default(uuid())
  workspaceId           String
  cloudAccountId        String
  provider              CloudProvider
  resourceType          String // e.g. AWS_S3_BUCKET | AZURE_STORAGE_ACCOUNT | GCP_VPC_FIREWALL
  providerResourceId    String // ARN / Azure resource id / GCP full resource name
  name                  String
  region                String?
  zone                  String?
  tags                  Json                    @default("{}") // sanitized string map only
  configurationMetadata Json                    @default("{}") // bounded normalized security metadata
  exposure              String                  @default("UNKNOWN") // PUBLIC | INTERNET_REACHABLE_POSSIBLE | PRIVATE | UNKNOWN (§47)
  criticality           String                  @default("UNSPECIFIED")
  status                String                  @default("ACTIVE") // ACTIVE | NOT_SEEN | REMOVED (§20)
  scopeStatus           String                  @default("IN_SCOPE") // IN_SCOPE | OUT_OF_SCOPE
  sources               String[]                @default([]) // adapter slugs that reported this resource
  firstSeen             DateTime                @default(now())
  lastSeen              DateTime                @updatedAt
  account               CloudAccount            @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  configSnapshots       CloudResourceSnapshot[]

  @@unique([cloudAccountId, providerResourceId])
  @@index([workspaceId])
  @@index([cloudAccountId, resourceType])
  @@index([workspaceId, exposure])
}

// One inventory observation of an account (§19): regions covered,
// per-type resource counts, content hash — the drift baseline (§64).
model CloudInventorySnapshot {
  id             String        @id @default(uuid())
  workspaceId    String
  cloudAccountId String
  scanId         String?
  provider       CloudProvider
  regions        String[]      @default([])
  resourceCounts Json          @default("{}")
  snapshotHash   String
  capturedAt     DateTime      @default(now())
  account        CloudAccount  @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cloudAccountId])
  @@index([scanId])
}

// A cloud identity (§36): user, role, group, service account, managed
// identity or policy. Privilege/MFA/staleness are METADATA the provider
// APIs expose (§39–§41) — credential material itself is never here (§40).
model CloudIdentity {
  id                 String        @id @default(uuid())
  workspaceId        String
  cloudAccountId     String
  provider           CloudProvider
  identityType       String // USER | ROLE | GROUP | SERVICE_ACCOUNT | MANAGED_IDENTITY | POLICY
  providerIdentityId String // ARN / principal id / service-account email — identity, not a secret
  name               String
  privileged         Boolean       @default(false) // evidence-backed admin-equivalence (§38)
  privilegeEvidence  Json? // the wildcard/admin policy facts behind the verdict — never auto a finding by itself
  mfaEnabled         Boolean?
  lastUsedAt         DateTime?
  lastSignInAt       DateTime?
  keyAgeDays         Int? // long-lived credential age metadata (§40) — never the key itself
  metadata           Json          @default("{}")
  firstSeen          DateTime      @default(now())
  lastSeen           DateTime      @updatedAt
  account            CloudAccount  @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@unique([cloudAccountId, providerIdentityId])
  @@index([workspaceId])
  @@index([cloudAccountId, identityType])
}

// An evidence-backed asset-graph edge (§15/§37/§85). Only relationships
// a provider response or a governed check actually supports are stored —
// the graph never speculates.
model CloudRelationship {
  id             String       @id @default(uuid())
  workspaceId    String
  cloudAccountId String
  fromType       String // ACCOUNT | REGION | NETWORK | SUBNET | RESOURCE | IDENTITY | POLICY | WORKLOAD | IMAGE | CLUSTER | SERVICE | ENDPOINT
  fromRef        String
  toType         String
  toRef          String
  relationship   String // CONTAINS | ATTACHED_TO | ASSUMES | MEMBER_OF | GRANTS | ROUTES_TO | EXPOSES | RUNS | USES_IMAGE | MAPS_TO
  evidence       String?
  firstSeen      DateTime     @default(now())
  lastSeen       DateTime     @updatedAt
  account        CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@unique([cloudAccountId, fromType, fromRef, relationship, toType, toRef])
  @@index([workspaceId])
  @@index([cloudAccountId])
}

// A defensive risk path (§66): an evidence-backed chain such as
// Public Endpoint → Workload → Identity → Sensitive Resource. It is a
// MODEL of exposure — the path is never executed, and privilege
// escalation is never attempted (§67/§106).
model CloudRiskPath {
  id             String       @id @default(uuid())
  workspaceId    String
  cloudAccountId String
  scanId         String?
  title          String
  steps          Json         @default("[]") // [{ kind, ref, label }] — evidence-backed nodes only
  confidence     String       @default("LOW") // LOW | MEDIUM | HIGH (§67)
  findingIds     String[]     @default([])
  createdAt      DateTime     @default(now())
  account        CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cloudAccountId])
}

// A drift observation (§63/§64): snapshot-vs-snapshot changes and
// IaC-vs-live mismatches. A change is an observation, never an
// automatic malicious verdict (§64).
model CloudDriftEvent {
  id             String       @id @default(uuid())
  workspaceId    String
  cloudAccountId String
  scanId         String?
  snapshotId     String?
  kind           String // RESOURCE_ADDED | RESOURCE_REMOVED | EXPOSURE_CHANGED | IAM_CHANGED | ENCRYPTION_CHANGED | LOGGING_CHANGED | IAC_DRIFT
  state          String? // MATCHED | DRIFTED | UNMAPPED | UNKNOWN (§63; IAC_DRIFT rows)
  resourceRef    String?
  detail         String       @default("")
  detectedAt     DateTime     @default(now())
  account        CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cloudAccountId])
  @@index([kind])
}

// An ephemeral credential lease (§11): the RECORD that a CLOUD_ANALYSIS
// worker resolved a secret reference for one authorized job. The record
// carries the reference NAME and lifecycle only — credential material
// never appears here, in queue payloads, or in logs (§100).
model CredentialLease {
  id                  String                 @id @default(uuid())
  workspaceId         String
  cloudAccountId      String?
  // Prompt 15 §9: the same lease architecture serves directory
  // assessments — exactly one of cloudAccountId / directoryDomainId
  // is set per lease; the record carries the reference NAME and
  // lifecycle only, never credential material.
  directoryDomainId   String?
  scanId              String?
  credentialReference String // reference name only — never a value
  purpose             String                 @default("CLOUD_ASSESSMENT")
  status              String                 @default("ISSUED") // ISSUED | CONSUMED | EXPIRED | RELEASED
  issuedAt            DateTime               @default(now())
  expiresAt           DateTime
  releasedAt          DateTime?
  account             CloudAccount?          @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  domain              ActiveDirectoryDomain? @relation(fields: [directoryDomainId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cloudAccountId])
  @@index([directoryDomainId])
  @@index([scanId])
}

// ===================== Prompt 15 — Active Directory Security =====================
// Defensive assessment ONLY (§120): inventory, configuration review,
// identity relationships, privilege analysis, exposure analysis and
// attack-PATH MODELING over collected data. No model here can hold
// credential material: directory credentials exist exclusively as
// secret REFERENCES on DirectoryCredentialProfile (§7), password
// hashes are never stored (§19), and attack paths are analysis
// results — they are never executed and never labelled COMPROMISED (§35).

// An AD forest (§5): root domain + functional level + assessment state.
model ActiveDirectoryForest {
  id              String                  @id @default(uuid())
  workspaceId     String
  name            String
  rootDomain      String // DNS name of the forest root domain
  functionalLevel String?
  assessmentState String                  @default("REGISTERED") // REGISTERED | ASSESSED | NOT_CONFIGURED
  createdBy       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  domains         ActiveDirectoryDomain[]

  @@unique([workspaceId, rootDomain])
  @@index([workspaceId])
}

// A registered AD domain (§4): a verified internal target. The domain's
// own identity (DNS/NetBIOS/SID) is inventory metadata — never a
// credential. Assessments require the approved internal engagement
// context and run only on DIRECTORY_ANALYSIS workers (§10/§11).
model ActiveDirectoryDomain {
  id                     String                        @id @default(uuid())
  workspaceId            String
  targetId               String?
  forestId               String?
  dnsName                String
  netbiosName            String?
  domainSid              String?
  functionalLevel        String?
  environment            String                        @default("UNKNOWN") // PRODUCTION | STAGING | DEVELOPMENT | LAB | UNKNOWN
  criticality            String                        @default("HIGH") // identity infrastructure is high-value by default (§73)
  status                 String                        @default("REGISTERED") // REGISTERED | VALIDATED | NOT_CONFIGURED | VALIDATION_FAILED
  credentialProfileId    String?
  firstSeen              DateTime                      @default(now())
  lastSeen               DateTime                      @updatedAt
  lastAssessmentAt       DateTime?
  createdBy              String
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  forest                 ActiveDirectoryForest?        @relation(fields: [forestId], references: [id], onDelete: SetNull)
  credentialProfile      DirectoryCredentialProfile?   @relation(fields: [credentialProfileId], references: [id], onDelete: SetNull)
  controllers            DomainController[]
  snapshots              DirectorySnapshot[]
  users                  DirectoryUser[]
  groups                 DirectoryGroup[]
  computers              DirectoryComputer[]
  organizationalUnits    DirectoryOrganizationalUnit[]
  groupPolicies          GroupPolicyObject[]
  trusts                 DirectoryTrust[]
  relationships          DirectoryRelationship[]
  attackPaths            AdAttackPath[]
  smbShares              SmbShare[]
  certificateAuthorities CertificateAuthority[]
  certificateTemplates   CertificateTemplate[]
  driftEvents            AdDriftEvent[]
  artifacts              DirectoryArtifact[]
  leases                 CredentialLease[]

  @@unique([workspaceId, dnsName])
  @@index([workspaceId])
  @@index([forestId])
}

// An assessment identity for a domain (§7): READ_ONLY_DOMAIN or
// APPROVED_DIRECTORY_AUDITOR. The credential itself lives in the
// secret manager — this row holds the REFERENCE NAME only. Default
// assessments never require Domain Admin (§8).
model DirectoryCredentialProfile {
  id                  String                  @id @default(uuid())
  workspaceId         String
  name                String
  identityKind        String                  @default("READ_ONLY_DOMAIN") // READ_ONLY_DOMAIN | APPROVED_DIRECTORY_AUDITOR
  credentialReference String? // secret reference name only — never a value
  status              String                  @default("REGISTERED") // REGISTERED | VALIDATED | NOT_CONFIGURED
  createdBy           String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  domains             ActiveDirectoryDomain[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// A domain controller (§6), linked to the network Asset that P10
// discovered for the same host — DCs are never duplicated as hosts.
model DomainController {
  id          String                @id @default(uuid())
  workspaceId String
  domainId    String
  assetId     String? // network Asset/Host correlation (§72)
  hostname    String
  dnsName     String?
  ipAddresses String[]              @default([])
  osName      String?
  osVersion   String?
  // Service metadata (§6): LDAP / LDAPS / SMB / Kerberos / DNS / GC
  // presence + posture facts (signing, channel binding) — metadata
  // only, collected read-only.
  services    Json                  @default("{}")
  firstSeen   DateTime              @default(now())
  lastSeen    DateTime              @updatedAt
  domain      ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, hostname])
  @@index([workspaceId])
  @@index([domainId])
}

// One directory collection (§18): what was collected, by which profile
// and collector versions, and a content hash — the drift baseline (§79).
model DirectorySnapshot {
  id                String                @id @default(uuid())
  workspaceId       String
  domainId          String
  scanId            String?
  collectionProfile String // e.g. AD_BASELINE / SHARPHOUND_SAFE / BLOODHOUND_IMPORT
  collectorVersions Json                  @default("{}")
  objectCounts      Json                  @default("{}")
  relationshipCount Int                   @default(0)
  snapshotHash      String
  capturedAt        DateTime              @default(now())
  domain            ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([domainId])
  @@index([scanId])
}

// A directory user (§19): security-relevant METADATA only. There is
// deliberately no field that could hold a password or a hash.
model DirectoryUser {
  id                   String                @id @default(uuid())
  workspaceId          String
  domainId             String
  objectId             String // SID / objectGUID — directory identity, not a secret
  samAccountName       String
  displayName          String?
  userPrincipalName    String?
  enabled              Boolean               @default(true)
  isServiceAccount     Boolean               @default(false)
  passwordNeverExpires Boolean               @default(false)
  passwordNotRequired  Boolean               @default(false)
  preauthNotRequired   Boolean               @default(false) // DONT_REQUIRE_PREAUTH — posture metadata (§57)
  spnPresent           Boolean               @default(false) // SPN presence is inventory (§58), not a finding by itself
  spns                 String[]              @default([])
  delegationType       String                @default("NONE") // NONE | UNCONSTRAINED | CONSTRAINED | RESOURCE_BASED (§59)
  delegationTargets    String[]              @default([])
  privileged           Boolean               @default(false) // evidence-backed (§64): direct or nested privileged membership / high-impact ACL
  privilegeEvidence    Json?
  riskScore            Float? // explainable IdentityRiskScore (§77) — inputs recorded in riskFactors
  riskFactors          Json?
  lastLogonAt          DateTime?
  passwordLastSetAt    DateTime?
  metadata             Json                  @default("{}")
  firstSeen            DateTime              @default(now())
  lastSeen             DateTime              @updatedAt
  domain               ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, objectId])
  @@index([workspaceId])
  @@index([domainId, privileged])
}

// A directory computer (§20), linked to the network Asset where the
// host was also discovered by network scans (§72/§93).
model DirectoryComputer {
  id                      String                @id @default(uuid())
  workspaceId             String
  domainId                String
  assetId                 String?
  objectId                String
  hostname                String
  dnsName                 String?
  osName                  String?
  osVersion               String?
  enabled                 Boolean               @default(true)
  isDomainController      Boolean               @default(false)
  delegationType          String                @default("NONE") // NONE | UNCONSTRAINED | CONSTRAINED | RESOURCE_BASED (§59)
  delegationTargets       String[]              @default([])
  unconstrainedDelegation Boolean               @default(false)
  riskScore               Float? // ComputerRiskScore (§78)
  riskFactors             Json?
  metadata                Json                  @default("{}")
  firstSeen               DateTime              @default(now())
  lastSeen                DateTime              @updatedAt
  domain                  ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, objectId])
  @@index([workspaceId])
  @@index([domainId])
}

// A directory group (§21) with SID-based privilege classification (§22).
model DirectoryGroup {
  id             String                @id @default(uuid())
  workspaceId    String
  domainId       String
  objectId       String // SID — classification keys off the SID RID, not the localized name (§22)
  name           String
  groupScope     String                @default("GLOBAL") // GLOBAL | UNIVERSAL | DOMAIN_LOCAL
  groupType      String                @default("SECURITY") // SECURITY | DISTRIBUTION
  privilegeClass String                @default("STANDARD") // PRIVILEGED | HIGH_IMPACT | STANDARD (§22)
  memberCount    Int                   @default(0)
  metadata       Json                  @default("{}")
  firstSeen      DateTime              @default(now())
  lastSeen       DateTime              @updatedAt
  domain         ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, objectId])
  @@index([workspaceId])
  @@index([domainId, privilegeClass])
}

// An organizational unit (§23): hierarchy + linked policy metadata.
model DirectoryOrganizationalUnit {
  id                String                @id @default(uuid())
  workspaceId       String
  domainId          String
  objectId          String
  name              String
  distinguishedName String
  parentRef         String? // parent OU objectId (or the domain ref)
  linkedGpoIds      String[]              @default([])
  firstSeen         DateTime              @default(now())
  lastSeen          DateTime              @updatedAt
  domain            ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, objectId])
  @@index([workspaceId])
  @@index([domainId])
}

// A Group Policy Object (§24): metadata + security-relevant
// configuration summary. The platform NEVER modifies a GPO (§83).
model GroupPolicyObject {
  id                 String                @id @default(uuid())
  workspaceId        String
  domainId           String
  objectId           String // GPO GUID
  name               String
  linkedTo           String[]              @default([]) // OU / domain refs the GPO is linked to
  securityMetadata   Json                  @default("{}")
  delegationMetadata Json                  @default("{}")
  lastModifiedAt     DateTime?
  firstSeen          DateTime              @default(now())
  lastSeen           DateTime              @updatedAt
  domain             ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, objectId])
  @@index([workspaceId])
  @@index([domainId])
}

// A directory trust (§25): direction/type/transitivity + SID-filtering
// and selective-authentication metadata where the collection exposes it.
model DirectoryTrust {
  id                      String                @id @default(uuid())
  workspaceId             String
  domainId                String // source domain (the registered domain)
  targetDomainName        String
  targetDomainId          String? // registered domain row when the target is also assessed
  direction               String // INBOUND | OUTBOUND | BIDIRECTIONAL
  trustType               String // FOREST | EXTERNAL | PARENT_CHILD | SHORTCUT | UNKNOWN
  transitive              Boolean               @default(true)
  sidFilteringEnabled     Boolean?
  selectiveAuthentication Boolean?
  firstSeen               DateTime              @default(now())
  lastSeen                DateTime              @updatedAt
  domain                  ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, targetDomainName])
  @@index([workspaceId])
  @@index([domainId])
}

// An identity-graph edge (§32/§33): ONLY relationships the collected
// evidence supports. Every edge retains provenance — source tool,
// snapshot, collection time and confidence. Sessions (§69) ride this
// same shape with restricted retention, never as movement instructions.
model DirectoryRelationship {
  id           String                @id @default(uuid())
  workspaceId  String
  domainId     String
  snapshotId   String?
  fromType     String // USER | GROUP | COMPUTER | DOMAIN | OU | GPO | CERTIFICATE_AUTHORITY | CERTIFICATE_TEMPLATE | SERVICE_ACCOUNT
  fromRef      String // objectId / SID of the source node
  toType       String
  toRef        String
  relationship String // MEMBER_OF | ADMIN_TO | HAS_SESSION | CAN_RDP | CAN_REMOTE_MANAGE | OWNS | GENERIC_ALL | GENERIC_WRITE | WRITE_DACL | WRITE_OWNER | GPO_LINK | TRUST | DELEGATION
  source       String // adapter slug / collector that reported the edge
  confidence   String                @default("MEDIUM") // LOW | MEDIUM | HIGH (§36)
  evidenceRef  String?
  firstSeen    DateTime              @default(now())
  lastSeen     DateTime              @updatedAt
  domain       ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, fromType, fromRef, relationship, toType, toRef])
  @@index([workspaceId])
  @@index([domainId])
  @@index([domainId, relationship])
}

// A defensive attack path (§34–§37): a graph computation over
// collected evidence. Status is THEORETICAL / EVIDENCE_BACKED /
// REVIEWED / MITIGATED — NEVER COMPROMISED without incident evidence,
// and no step of a path is ever executed.
model AdAttackPath {
  id          String                @id @default(uuid())
  workspaceId String
  domainId    String
  scanId      String?
  title       String
  steps       Json                  @default("[]") // [{ kind, ref, label, via }] — evidence-backed nodes/edges only
  status      String                @default("THEORETICAL") // THEORETICAL | EVIDENCE_BACKED | REVIEWED | MITIGATED
  confidence  String                @default("LOW") // LOW | MEDIUM | HIGH (§36)
  riskScore   Float                 @default(0) // §37 factors — never "shortest = worst" alone
  riskFactors Json                  @default("{}") // the explanation of the score (§36/§37)
  findingIds  String[]              @default([])
  createdAt   DateTime              @default(now())
  domain      ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([domainId])
  @@index([scanId])
}

// An SMB share observation (§42): inventory + access classification
// only. Share CONTENTS are never downloaded by normal assessment (§97).
model SmbShare {
  id              String                 @id @default(uuid())
  workspaceId     String
  domainId        String?
  assetId         String?
  host            String // hostname / IP of the file server
  shareName       String
  accessLevel     String                 @default("UNKNOWN") // NONE | READ | READ_WRITE | ADMIN | UNKNOWN — only where safely determined (§42)
  anonymousAccess Boolean?
  smbDialect      String? // e.g. SMB1 / SMB2 / SMB3 (§45)
  signingRequired Boolean?
  source          String // adapter slug that reported the share
  firstSeen       DateTime               @default(now())
  lastSeen        DateTime               @updatedAt
  domain          ActiveDirectoryDomain? @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, host, shareName])
  @@index([workspaceId])
  @@index([domainId])
}

// An AD CS certificate authority (§46).
model CertificateAuthority {
  id                 String                @id @default(uuid())
  workspaceId        String
  domainId           String
  name               String
  dnsName            String?
  enrollmentServices Json                  @default("[]") // enrollment endpoint metadata (names/URLs as data)
  metadata           Json                  @default("{}") // posture metadata (e.g. EDITF flag observations)
  firstSeen          DateTime              @default(now())
  lastSeen           DateTime              @updatedAt
  domain             ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  templates          CertificateTemplate[]

  @@unique([domainId, name])
  @@index([workspaceId])
  @@index([domainId])
}

// A certificate template (§46/§49): security-relevant configuration
// metadata + deterministic risk classes (§50). Templates are analyzed,
// never modified, and no certificate is ever requested (§48/§83).
model CertificateTemplate {
  id                           String                @id @default(uuid())
  workspaceId                  String
  domainId                     String
  caId                         String?
  name                         String
  objectId                     String?
  enabled                      Boolean               @default(true)
  enrollmentPermissions        Json                  @default("{}")
  subjectConfig                Json                  @default("{}") // e.g. enrolleeSuppliesSubject (§49)
  authenticationEkus           String[]              @default([])
  managerApprovalRequired      Boolean               @default(false)
  authorizedSignaturesRequired Int                   @default(0)
  issuanceRequirements         Json                  @default("{}")
  riskClasses                  String[]              @default([]) // governed ESC-style class labels — analysis labels only (§50)
  firstSeen                    DateTime              @default(now())
  lastSeen                     DateTime              @updatedAt
  domain                       ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  ca                           CertificateAuthority? @relation(fields: [caId], references: [id], onDelete: SetNull)

  @@unique([domainId, name])
  @@index([workspaceId])
  @@index([domainId])
}

// A directory drift observation (§79/§80): snapshot-vs-snapshot change.
// High-risk kinds are REVIEW signals — a change is never automatically
// classified malicious.
model AdDriftEvent {
  id          String                @id @default(uuid())
  workspaceId String
  domainId    String
  scanId      String?
  snapshotId  String?
  kind        String // NEW_PRIVILEGED_MEMBER | PRIVILEGED_MEMBERSHIP_REMOVED | NEW_PRIVILEGED_USER | NEW_TRUST | TRUST_CHANGED | GPO_CHANGED | DELEGATION_CHANGED | NEW_RISKY_ACL | CERTIFICATE_TEMPLATE_CHANGED
  objectRef   String?
  detail      String                @default("")
  detectedAt  DateTime              @default(now())
  domain      ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([domainId])
  @@index([kind])
}

// Raw directory dataset artifact metadata (§30): BloodHound/SharpHound
// exports, PingCastle reports and ADExplorer snapshots are HIGHLY
// sensitive. Only the reference + hash live here; raw access requires
// VIEW_RAW_DIRECTORY_GRAPH and is audited on every access (§117).
model DirectoryArtifact {
  id           String                @id @default(uuid())
  workspaceId  String
  domainId     String
  scanId       String?
  artifactKind String // BLOODHOUND_EXPORT | SHARPHOUND_OUTPUT | PINGCASTLE_REPORT | ADEXPLORER_SNAPSHOT | LDAP_EXPORT
  storageKey   String
  sha256       String
  sizeBytes    Int                   @default(0)
  sensitivity  String                @default("HIGH")
  createdAt    DateTime              @default(now())
  domain       ActiveDirectoryDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([domainId])
}

// --------------------------- Controlled validation (Prompt 16) ---------------------------
// The validation engine increases CONFIDENCE in a finding through safe,
// governed rechecks (§5/§6). It is NOT an exploitation engine: prohibited
// techniques are unrepresentable in the validator catalog (§95/§97), the
// approval is bound to the plan content hash (§10), and every execution
// re-validates authorization, scope, policy, budget and kill switches in
// the worker immediately before running (§9/§13/§43).

enum ValidationRequestStatus {
  REQUESTED
  POLICY_REVIEW
  APPROVAL_REQUIRED
  APPROVED
  RUNNING
  SUCCEEDED
  FAILED
  INCONCLUSIVE
  BLOCKED
  CANCELLED
  EXPIRED
}

enum ValidationRiskClass {
  SAFE
  LOW_IMPACT
  REVIEW_REQUIRED
  INTRUSIVE
  PROHIBITED_AUTOMATION
}

enum ValidationEvidenceType {
  HTTP_REQUEST
  HTTP_RESPONSE
  TLS_RESULT
  SERVICE_RESULT
  CONFIGURATION_RESULT
  SCREENSHOT
  LOG
  SCANNER_RESULT
  MANUAL_NOTE
}

model ValidationRequest {
  id                    String                  @id @default(uuid())
  workspaceId           String
  findingId             String
  targetId              String
  requestedBy           String
  // Governed validator slug from the SDK catalog — never a tool command,
  // never a user-supplied payload (§79). validationType mirrors the
  // catalog technique family (HEADER, TLS, EXPOSURE, RECHECK, ...).
  validatorSlug         String
  validationType        String
  toolSlug              String?
  riskClass             ValidationRiskClass
  reason                String?
  // Immutable snapshots taken at request time (§8): authorization, scope
  // rules and the exact plan document. planHash binds the approval to
  // the plan CONTENT — any plan change invalidates the approval.
  authorizationSnapshot Json
  scopeSnapshot         Json
  plan                  Json
  planHash              String
  parameters            Json? // allowlisted per-validator typed params only (§79)
  budget                Json // ValidationBudget (§40), already clamped to admin hard limits (§41)
  status                ValidationRequestStatus @default(REQUESTED)
  policyDecision        String? // ALLOW | DENY | REQUIRE_APPROVAL (§7)
  policyReason          String?
  outcome               String? // REPRODUCED | NOT_REPRODUCED | INCONCLUSIVE | TARGET_CHANGED | VALIDATION_BLOCKED | FIXED (§38)
  environment           String                  @default("PRODUCTION") // PRODUCTION | LAB — explicitly marked, never inferred (§65)
  idempotencyKey        String?
  expiresAt             DateTime?
  finding               Finding                 @relation(fields: [findingId], references: [id], onDelete: Cascade)
  approvals             ValidationApproval[]
  sessions              ValidationSession[]
  evidence              ValidationEvidence[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([findingId])
  @@index([targetId])
  @@index([status])
}

model ValidationApproval {
  id          String            @id @default(uuid())
  requestId   String
  workspaceId String
  approverId  String
  decision    String // APPROVED | REJECTED
  reason      String?
  // The approval is valid ONLY for this exact plan hash, target, finding
  // and technique (§10). A plan edit changes the hash and voids it.
  planHash    String
  approvedAt  DateTime          @default(now())
  expiresAt   DateTime
  request     ValidationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([requestId])
  @@index([workspaceId])
}

model ValidationSession {
  id                String               @id @default(uuid())
  requestId         String
  workspaceId       String
  workerId          String?
  toolSlug          String?
  validatorSlug     String
  status            String               @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | INCONCLUSIVE | BLOCKED | CANCELLED
  startedAt         DateTime?
  endedAt           DateTime?
  budget            Json
  budgetConsumed    Json?
  terminationReason String?
  request           ValidationRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  evidence          ValidationEvidence[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([requestId])
  @@index([workspaceId])
  @@index([status])
}

// Sanitized validation evidence (§33–§35): content is redacted BEFORE it
// reaches this table (§34/§91); checksum covers the sanitized artifact so
// integrity checks never require un-redacting anything.
model ValidationEvidence {
  id          String                 @id @default(uuid())
  requestId   String
  sessionId   String?
  workspaceId String
  findingId   String?
  type        ValidationEvidenceType
  summary     String
  content     Json? // sanitized structured content (§34)
  checksum    String
  sourceTool  String?
  request     ValidationRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  session     ValidationSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@index([requestId])
  @@index([sessionId])
  @@index([workspaceId])
}

// Analyst-attached manual validation (§32): DSRclone executes NOTHING for
// these records — they document validation performed by an authorized
// human outside the automated engine (the only path for RCE-class
// findings, §21). Attachments are sanitized before storage (§34).
model ManualValidationRecord {
  id          String   @id @default(uuid())
  workspaceId String
  findingId   String
  analystId   String
  description String
  outcome     String   @default("INCONCLUSIVE") // VERIFIED | NOT_REPRODUCED | INCONCLUSIVE
  evidence    Json? // sanitized notes / request-response excerpts (§32/§34)
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([findingId])
  @@index([workspaceId])
}

// Workspace validation policy (§64/§77): production defaults to
// SAFE_ONLY. Administrator hard limits (§41) clamp every request budget
// regardless of what a user or workspace asks for.
model ValidationPolicy {
  id                    String   @id @default(uuid())
  workspaceId           String   @unique
  productionPolicy      String   @default("SAFE_ONLY") // SAFE_ONLY | SAFE_AND_LOW_IMPACT_WITH_APPROVAL
  defaultRiskLevel      String   @default("SAFE")
  separationOfDuties    Boolean  @default(true)
  allowIntrusiveInLab   Boolean  @default(false)
  allowedValidators     String[] @default([])
  hardLimits            Json // administrator hard budget ceilings (§41)
  defaultBudget         Json
  defaultTimeoutSeconds Int      @default(300)
  approvalTtlMinutes    Int      @default(60)
  evidenceRetentionDays Int      @default(365)
  callbackEnabled       Boolean  @default(false)
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([workspaceId])
}

// Kill switches (§43): any matching ACTIVE row terminates validation.
// Levels: GLOBAL, ORGANIZATION, WORKSPACE, SCAN, TARGET, SESSION.
model ValidationKillSwitch {
  id             String    @id @default(uuid())
  level          String
  organizationId String?
  workspaceId    String?
  scopeRef       String? // scanId | targetId | sessionId depending on level
  active         Boolean   @default(true)
  reason         String?
  activatedBy    String
  activatedAt    DateTime  @default(now())
  clearedBy      String?
  clearedAt      DateTime?

  @@index([level, active])
  @@index([workspaceId])
  @@index([organizationId])
}

// Controlled callback tokens (§47/§48): only the HASH is stored. A token
// is bound to one tenant + one validation session, expires quickly, and
// is NEVER an authorization credential — it only correlates a callback.
model ValidationCallbackToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  workspaceId String
  requestId   String?
  sessionId   String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([expiresAt])
}

// Minimal callback ingestion log (§50): metadata only — no bodies, no
// visitor information beyond what correlation requires.
model ValidationCallbackEvent {
  id          String   @id @default(uuid())
  workspaceId String
  tokenId     String
  sessionId   String?
  kind        String   @default("HTTP") // HTTP | DNS (§49/§50)
  sourceIp    String?
  receivedAt  DateTime @default(now())

  @@index([workspaceId])
  @@index([tokenId])
}

// ─────────────────────────────────────────────────────────────────────
// Prompt 17 — Mobile application security (§4–§92). Uploaded app
// binaries are HOSTILE content: they are hashed, validated by magic
// bytes + archive security, and analyzed STATICALLY only — never
// installed, executed, emulated or instrumented outside the governed
// device lab (§8/§53). Secrets found inside apps persist as metadata
// only (SecretFindingMetadata, §28); signing keys and store
// credentials NEVER exist here — references only (§31).
// ─────────────────────────────────────────────────────────────────────

enum MobilePlatform {
  ANDROID
  IOS
}

// A registered mobile application (§4). Registration records identity
// only; the application becomes a verified MOBILE_APP target through
// the ordinary target verification flow before any scan (§3).
model MobileApplication {
  id              String                      @id @default(uuid())
  workspaceId     String
  targetId        String?
  name            String
  platform        MobilePlatform
  packageName     String? // Android applicationId
  bundleId        String? // iOS bundle identifier
  owner           String?
  projectRef      String?
  environment     String                      @default("UNKNOWN") // PRODUCTION | STAGING | DEVELOPMENT | LAB | UNKNOWN
  criticality     String                      @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String                      @default("REGISTERED") // REGISTERED | NOT_CONFIGURED
  createdBy       String
  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  builds          MobileBuild[]
  analysisPlans   MobileAnalysisPlan[]
  versionLineages ApplicationVersionLineage[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([workspaceId, platform, packageName])
  @@index([workspaceId])
  @@index([targetId])
}

// One uploaded build of an application (§5). Build identity is the
// SHA-256 of the artifact — NEVER the filename. Builds are immutable:
// a re-upload of different bytes is a different build.
model MobileBuild {
  id                String                      @id @default(uuid())
  applicationId     String
  workspaceId       String
  versionName       String?
  versionCode       Int?
  buildNumber       String?
  artifactHash      String // SHA-256 hex of the uploaded artifact (§5)
  artifactFormat    String // APK | AAB | IPA | DEX | UNKNOWN
  artifactReference String? // object-storage reference — bytes never live in Postgres
  artifactSizeBytes BigInt                      @default(0)
  // Signing metadata (§31): subject/issuer/validity/algorithm/
  // fingerprint of the signing certificate. Private keys never exist.
  signingMetadata   Json                        @default("{}")
  minOsVersion      String?
  targetOsVersion   String?
  architectures     String[]                    @default([])
  // Bounded extracted artifacts registered at intake (manifest/plist
  // text, network security config, decompiled snippets, native library
  // inventory) — the static pipeline's input. Sanitized at intake;
  // access is RBAC-gated and audited (§24/§116).
  analysisArtifacts Json                        @default("{}")
  status            String                      @default("UPLOADED") // UPLOADED | ANALYZED
  firstSeenAt       DateTime                    @default(now())
  lastScanAt        DateTime?
  application       MobileApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deepLinks         MobileDeepLink[]
  appComponents     MobileAppComponent[]
  endpoints         MobileEndpoint[]
  nativeLibraries   MobileNativeLibrary[]
  components        SoftwareComponent[]
  sboms             SoftwareBillOfMaterials[]
  trafficSessions   MobileTrafficSession[]
  dynamicSessions   MobileDynamicSession[]
  analysisPlans     MobileAnalysisPlan[]
  lineagesFrom      ApplicationVersionLineage[] @relation("LineageFrom")
  lineagesTo        ApplicationVersionLineage[] @relation("LineageTo")
  coverageSnapshots MobileSecurityCoverage[]
  // Prompt 18 §4: native artifacts of this build registered as binary
  // artifacts link back here (provenance, never duplication).
  binaryArtifacts   BinaryArtifact[]
  createdAt         DateTime                    @default(now())

  @@unique([applicationId, artifactHash])
  @@index([workspaceId])
  @@index([applicationId])
  @@index([artifactHash])
}

// A deep link / app link declared by the build (§26). Inventoried
// (scheme/host/path) — never invoked (§26).
model MobileDeepLink {
  id          String      @id @default(uuid())
  buildId     String
  workspaceId String
  scheme      String
  host        String?
  pathPrefix  String?
  autoVerify  Boolean     @default(false)
  source      String // MANIFEST | INFO_PLIST | MOBSF | JADX
  build       MobileBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([buildId])
  @@index([workspaceId])
}

// An application component from the manifest/plist (§21): activity,
// service, receiver, provider (Android) or extension (iOS).
model MobileAppComponent {
  id            String      @id @default(uuid())
  buildId       String
  workspaceId   String
  kind          String // ACTIVITY | SERVICE | RECEIVER | PROVIDER | EXTENSION
  name          String
  exported      Boolean     @default(false)
  permission    String?
  intentActions String[]    @default([])
  build         MobileBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([buildId])
  @@index([workspaceId])
}

// An endpoint extracted from the app (§29/§30). Classification is
// always DISCOVERED_REFERENCE: extraction NEVER authorizes a target
// and NEVER expands scope.
model MobileEndpoint {
  id             String      @id @default(uuid())
  buildId        String
  workspaceId    String
  url            String
  host           String
  kind           String      @default("HTTPS") // HTTP | HTTPS | WEBSOCKET | DOMAIN
  classification String      @default("DISCOVERED_REFERENCE")
  linkedAssetId  String? // set only when the host is ALREADY in authorized scope
  source         String // MANIFEST | DECOMPILED_CODE | MOBSF | TRAFFIC
  build          MobileBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([buildId])
  @@index([workspaceId])
  @@index([host])
}

// A native library inside the build (§33): inventory + hardening
// properties from static inspection. Never executed (§34).
model MobileNativeLibrary {
  id               String          @id @default(uuid())
  buildId          String
  workspaceId      String
  path             String
  architecture     String?
  sha256           String?
  pie              Boolean?
  nx               Boolean?
  stackCanary      Boolean?
  relro            String? // NONE | PARTIAL | FULL
  stripped         Boolean?
  // Prompt 18 §4/§51: when the same physical library is registered as
  // a binary artifact, the records LINK — correlation never duplicates
  // the artifact or its findings.
  binaryArtifactId String?
  build            MobileBuild     @relation(fields: [buildId], references: [id], onDelete: Cascade)
  binaryArtifact   BinaryArtifact? @relation(fields: [binaryArtifactId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([buildId])
  @@index([workspaceId])
  @@index([binaryArtifactId])
}

// The controlled device lab (§53/§54). Devices are DSRclone-managed
// emulators or dedicated test devices — NEVER personal devices. No
// unnecessary personal device identifiers are stored (§54).
model MobileTestDevice {
  id                  String                 @id @default(uuid())
  workspaceId         String
  name                String
  platform            MobilePlatform
  deviceKind          String                 @default("EMULATOR") // EMULATOR | PHYSICAL
  // Prompt 35 §72/§73: governed device profile — type, ownership and
  // authorization are explicit records. A device with
  // authorizationStatus != AUTHORIZED can never host a dynamic
  // session (§74/§151); the platform never connects to arbitrary
  // devices.
  deviceType          String                 @default("ANDROID_EMULATOR") // ANDROID_EMULATOR | ANDROID_TEST_DEVICE | IOS_SIMULATOR | IOS_TEST_DEVICE
  ownership           String                 @default("DSRCLONE_MANAGED") // DSRCLONE_MANAGED | ORGANIZATION_OWNED
  authorizationStatus String                 @default("NOT_AUTHORIZED") // AUTHORIZED | NOT_AUTHORIZED | REVOKED
  environment         String                 @default("LAB") // LAB | TEST | UNKNOWN
  osVersion           String?
  capabilities        String[]               @default([])
  availability        String                 @default("AVAILABLE") // AVAILABLE | BUSY | OFFLINE
  health              String                 @default("UNKNOWN")
  dedicatedNetwork    Boolean                @default(true) // isolated test networking (§56)
  lastResetAt         DateTime?
  status              String                 @default("REGISTERED")
  createdBy           String
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trafficSessions     MobileTrafficSession[]
  dynamicSessions     MobileDynamicSession[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([workspaceId])
}

// A governed proxy capture session in the lab (§64). Metadata only:
// captured HOSTS, counts and sizes — bodies live in object storage
// behind artifactRef, sanitized, access-audited (§66).
model MobileTrafficSession {
  id                String            @id @default(uuid())
  workspaceId       String
  buildId           String
  deviceId          String?
  proxyTool         String // MITMPROXY | BURP_SUITE
  status            String            @default("REQUESTED") // REQUESTED | APPROVED | RUNNING | COMPLETED | BLOCKED | TERMINATED
  startedAt         DateTime?
  endedAt           DateTime?
  hosts             Json              @default("[]") // sanitized host metadata only
  requestCount      Int               @default(0)
  bytesCaptured     BigInt            @default(0)
  artifactRef       String?
  sanitizationState String            @default("PENDING") // PENDING | SANITIZED
  createdBy         String
  build             MobileBuild       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  device            MobileTestDevice? @relation(fields: [deviceId], references: [id])
  createdAt         DateTime          @default(now())

  @@index([workspaceId])
  @@index([buildId])
}

// An administrator-reviewed, versioned instrumentation module (§71).
// Only modules registered here — with hash + risk classification —
// may ever run, and only inside an approved dynamic session. There is
// no row shape for arbitrary user-supplied scripts (§72).
model MobileInstrumentationModule {
  id                 String   @id @default(uuid())
  workspaceId        String
  name               String
  tool               String // FRIDA | OBJECTION
  version            String
  // Prompt 35 §80: the Frida/Objection script REGISTRY record —
  // purpose and platform are part of the reviewed identity. A module
  // without review (approved=false) can never run (§79/§152).
  purpose            String?
  platform           String? // ANDROID | IOS | BOTH
  moduleHash         String // SHA-256 of the reviewed module artifact
  capability         String   @default("DYNAMIC_INSTRUMENTATION")
  riskClassification String   @default("REVIEW_REQUIRED")
  approved           Boolean  @default(false)
  approvedBy         String?
  status             String   @default("REGISTERED") // REGISTERED | APPROVED | DISABLED
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([workspaceId, name, version])
  @@index([workspaceId])
}

// A controlled dynamic session request (§58/§73). A session exists
// only with: authorized build + approved lab device + approved
// profile + valid authorization + instrumentation policy approval.
// Prohibited actions (§75) are recorded as blocked, never executed.
model MobileDynamicSession {
  id                String            @id @default(uuid())
  workspaceId       String
  applicationId     String
  buildId           String
  deviceId          String?
  profile           String
  status            String            @default("REQUESTED") // REQUESTED | APPROVED | BLOCKED | RUNNING | COMPLETED | TERMINATED
  requestedActions  Json              @default("[]")
  blockedReasons    Json              @default("[]")
  moduleIds         String[]          @default([])
  killSwitchChecked Boolean           @default(false)
  cleanupState      String            @default("PENDING") // PENDING | RESET_DONE (§57)
  createdBy         String
  approvedBy        String?
  startedAt         DateTime?
  endedAt           DateTime?
  build             MobileBuild       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  device            MobileTestDevice? @relation(fields: [deviceId], references: [id])
  createdAt         DateTime          @default(now())

  @@index([workspaceId])
  @@index([buildId])
}

// ─────────────────────────────────────────────────────────────────────
// Prompt 35 — Mobile & Binary Security V2 (§13/§105/§121). These
// models DEEPEN Prompts 17/18 on the same canonical records: an
// analysis plan is a governed snapshot (never an execution), version
// lineage records carry-forward CLASSIFICATIONS (a finding absent
// from a new build is a FIXED_CANDIDATE — never auto-fixed, §108),
// and coverage snapshots record what was actually examined so a
// partial analysis can never read as clean (§124).
// ─────────────────────────────────────────────────────────────────────

// Prompt 35 §13: the governed analysis plan for one artifact.
// Contains the artifact, platform, authorization reference, the
// static/dynamic module sets of the chosen profile (§15), device
// profile (dynamic only), traffic-analysis flag, limits and the
// verification policy. Dynamic modules are recorded with their
// gate verdict — a plan never widens authorization (§16).
model MobileAnalysisPlan {
  id                 String            @id @default(uuid())
  workspaceId        String
  applicationId      String
  buildId            String
  profile            String // MOBILE_STATIC | MOBILE_STANDARD | ANDROID_STATIC | ANDROID_DYNAMIC_SAFE | IOS_STATIC | IOS_DYNAMIC_SAFE | TARGETED_MOBILE_VERIFICATION
  platform           String // ANDROID | IOS
  authorizationId    String?
  staticModules      String[]          @default([])
  dynamicModules     String[]          @default([])
  dynamicGate        String            @default("NOT_REQUESTED") // NOT_REQUESTED | ALLOWED | BLOCKED
  dynamicGateReasons Json              @default("[]")
  deviceId           String?
  trafficAnalysis    Boolean           @default(false)
  limits             Json              @default("{}")
  verificationPolicy String            @default("TARGETED_RETEST") // TARGETED_RETEST | MANUAL_REVIEW
  status             String            @default("PLANNED") // PLANNED | SCAN_STARTED | BLOCKED
  scanId             String?
  createdBy          String
  application        MobileApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  build              MobileBuild       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())

  @@index([workspaceId])
  @@index([buildId])
  @@index([applicationId])
}

// Prompt 35 §105: version lineage — an explicit edge from an older
// build to a newer build of the SAME application, with the
// carry-forward comparison summary computed at comparison time.
model ApplicationVersionLineage {
  id            String                      @id @default(uuid())
  workspaceId   String
  applicationId String
  fromBuildId   String
  toBuildId     String
  summary       Json                        @default("{}") // { new, persisting, fixedCandidate, regressed } counts
  comparedBy    String
  application   MobileApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromBuild     MobileBuild                 @relation("LineageFrom", fields: [fromBuildId], references: [id], onDelete: Cascade)
  toBuild       MobileBuild                 @relation("LineageTo", fields: [toBuildId], references: [id], onDelete: Cascade)
  carryForward  MobileFindingCarryForward[]
  createdAt     DateTime                    @default(now())

  @@unique([fromBuildId, toBuildId])
  @@index([workspaceId])
  @@index([applicationId])
}

// Prompt 35 §106: one finding's carry-forward classification across a
// lineage edge. FIXED_CANDIDATE is a hypothesis for Prompt 31
// verification — it NEVER closes the finding (§107/§108).
// REGRESSED means the issue was absent (or verified fixed) in an
// intermediate version and is present again.
model MobileFindingCarryForward {
  id                    String                    @id @default(uuid())
  workspaceId           String
  lineageId             String
  crossBuildFingerprint String
  classification        String // NEW | PERSISTING | FIXED_CANDIDATE | REGRESSED
  fromFindingId         String?
  toFindingId           String?
  ruleId                String?
  title                 String
  severity              String
  lineage               ApplicationVersionLineage @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  createdAt             DateTime                  @default(now())

  @@index([workspaceId])
  @@index([lineageId])
  @@index([crossBuildFingerprint])
}

// Prompt 35 §121/§122: mobile coverage snapshot for one build.
// Dimensions are the closed §122 set; a dimension not examined is
// recorded as NOT_COVERED with a reason — never silently complete
// (§124/§125).
model MobileSecurityCoverage {
  id          String      @id @default(uuid())
  workspaceId String
  buildId     String
  dimensions  Json        @default("{}") // dimension -> { status, detail }
  completion  String      @default("COMPLETED_WITH_GAPS") // COMPLETED | COMPLETED_WITH_GAPS
  obfuscation Json        @default("{}") // { detected, confidence, evidence } (§125)
  packing     Json        @default("{}") // { detected, confidence } (§126)
  build       MobileBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  computedAt  DateTime    @default(now())

  @@index([workspaceId])
  @@index([buildId])
}

// Prompt 35 §121/§123: binary coverage snapshot for one artifact.
// Decompilation availability is recorded honestly — an unavailable
// licensed tool is a gap, never a failure of the pipeline (§64).
model BinarySecurityCoverage {
  id          String         @id @default(uuid())
  workspaceId String
  artifactId  String
  dimensions  Json           @default("{}")
  completion  String         @default("COMPLETED_WITH_GAPS")
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  computedAt  DateTime       @default(now())

  @@index([workspaceId])
  @@index([artifactId])
}

// ─────────────────────────────────────────────────────────────────────
// Prompt 18 — Reverse engineering & binary security analysis
// (§1–§95). Binaries are UNTRUSTED content: registered by SHA-256
// identity, identified by magic bytes, parsed STATICALLY and never
// executed, loaded as code, debugged outside the governed lab
// policy, or extracted outside an isolated workspace (§6–§8/§100).
// Secrets inside binaries persist as metadata only (§30) — there is
// deliberately NO column anywhere in this section that could hold a
// raw secret value, private key material or unrestricted memory.
// ─────────────────────────────────────────────────────────────────────

// A registered binary artifact (§3). Identity = SHA-256; physical
// artifacts are deduplicated by hash while tenant references stay
// separate (§4/§101). Provenance links (mobile build / container
// image / source snapshot) preserve lineage without duplicating the
// artifact.
model BinaryArtifact {
  id                String                    @id @default(uuid())
  workspaceId       String
  targetId          String?
  name              String
  // UPLOAD | MOBILE_BUILD | CONTAINER_IMAGE | SOURCE_BUILD | CONTROLLED_LAB
  source            String                    @default("UPLOAD")
  sourceRef         String?
  mobileBuildId     String?
  containerImageId  String?
  sha256            String
  sha1              String?
  sizeBytes         BigInt                    @default(0)
  format            String                    @default("UNKNOWN") // ELF | PE | MACH_O | UNKNOWN (§5)
  kind              String? // EXECUTABLE | SHARED_LIBRARY | OBJECT | CORE
  architecture      String?
  bitness           Int?
  endianness        String?
  platform          String?
  environment       String                    @default("PRODUCTION") // PRODUCTION | STAGING | LAB | DEVELOPMENT
  artifactReference String? // object-storage reference — bytes never travel in rows
  // Bounded recorded analysis payload registered with the artifact
  // (parsed header report / tool inputs) — sanitized + secret-redacted
  // at intake (§6/§107 discipline). NEVER raw artifact bytes.
  analysisArtifacts Json?
  status            String                    @default("REGISTERED") // REGISTERED | ANALYZED | ANALYSIS_FAILED
  createdBy         String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  target            Target?                   @relation(fields: [targetId], references: [id], onDelete: SetNull)
  mobileBuild       MobileBuild?              @relation(fields: [mobileBuildId], references: [id], onDelete: SetNull)
  containerImage    ContainerImage?           @relation(fields: [containerImageId], references: [id], onDelete: SetNull)
  sections          BinarySection[]
  hardeningProfile  BinaryHardeningProfile?
  functions         BinaryFunction[]
  imports           BinaryImport[]
  exports           BinaryExport[]
  symbols           BinarySymbol[]
  strings           BinaryString[]
  dependencies      BinaryDependency[]
  cryptoReferences  BinaryCryptoReference[]
  components        SoftwareComponent[]
  sboms             SoftwareBillOfMaterials[]
  findings          Finding[]
  nativeLibraries   MobileNativeLibrary[]
  diffsAsBase       BinaryDiff[]              @relation("BinaryDiffBase")
  diffsAsTarget     BinaryDiff[]              @relation("BinaryDiffTarget")
  debugSessions     BinaryDebugSession[]
  crashes           BinaryCrash[]
  coverageSnapshots BinarySecurityCoverage[]

  @@unique([workspaceId, sha256])
  @@index([workspaceId])
  @@index([targetId])
  @@index([sha256])
}

model BinarySection {
  id             String         @id @default(uuid())
  artifactId     String
  workspaceId    String
  name           String
  type           String?
  offset         BigInt?
  size           BigInt?
  virtualAddress String?
  permissions    String?
  entropy        Float?
  source         String         @default("binary-platform-analysis")
  artifact       BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([artifactId, name])
  @@index([artifactId])
}

// The normalized hardening profile (§15/§16): one row per artifact,
// per-mitigation status ENABLED | DISABLED | PARTIAL | NOT_APPLICABLE
// | UNKNOWN in the Json profile, with per-tool provenance.
model BinaryHardeningProfile {
  id          String         @id @default(uuid())
  artifactId  String         @unique
  workspaceId String
  profile     Json           @default("[]") // [{ name, status, detail?, source }]
  assessedAt  DateTime       @default(now())
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BinaryFunction {
  id                 String         @id @default(uuid())
  artifactId         String
  workspaceId        String
  name               String
  address            String?
  size               Int?
  callingConvention  String?
  // §22 stable identity from normalized bytes/signatures — never an
  // absolute address alone.
  fingerprint        String?
  referencesRiskyApi String[]       @default([])
  confidence         Float          @default(0.7)
  source             String
  artifact           BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())

  @@unique([artifactId, name, address])
  @@index([artifactId])
  @@index([workspaceId, name])
}

model BinaryImport {
  id          String         @id @default(uuid())
  artifactId  String
  workspaceId String
  library     String
  symbol      String
  address     String?
  source      String
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([artifactId])
  @@index([workspaceId, symbol])
}

model BinaryExport {
  id          String         @id @default(uuid())
  artifactId  String
  workspaceId String
  symbol      String
  address     String?
  type        String?
  source      String
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([artifactId])
}

model BinarySymbol {
  id          String         @id @default(uuid())
  artifactId  String
  workspaceId String
  name        String
  type        String?
  binding     String?
  address     String?
  source      String
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([artifactId])
}

// Extracted strings (§28–§30): bounded, categorized, sanitized.
// SECRET_CANDIDATE rows carry the one-way fingerprint + redacted
// preview ONLY — value holds the literal redaction marker.
model BinaryString {
  id                String         @id @default(uuid())
  artifactId        String
  workspaceId       String
  value             String
  encoding          String         @default("ASCII")
  category          String         @default("GENERIC")
  location          String?
  secretFingerprint String?
  secretType        String?
  redactedPreview   String?
  source            String
  artifact          BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())

  @@index([artifactId])
  @@index([artifactId, category])
}

model BinaryDependency {
  id          String         @id @default(uuid())
  artifactId  String
  workspaceId String
  library     String
  // Only where reliably known (§25) — never inferred from a soname.
  version     String?
  path        String?
  platform    String?
  purl        String?
  cpe         String?
  // DECLARED | DETECTED_LINKED | HEURISTIC (§27)
  sourceKind  String         @default("DETECTED_LINKED")
  confidence  Float          @default(0.8)
  source      String
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([artifactId, library])
  @@index([artifactId])
  @@index([workspaceId, library])
}

model BinaryCryptoReference {
  id          String         @id @default(uuid())
  artifactId  String
  workspaceId String
  kind        String // LIBRARY | ALGORITHM | CERTIFICATE_API | KEY_MANAGEMENT_API
  name        String
  source      String
  artifact    BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([artifactId])
}

// A cross-build comparison (§53–§55): inventories compared,
// security regressions recorded explicitly.
model BinaryDiff {
  id               String         @id @default(uuid())
  workspaceId      String
  baseArtifactId   String
  targetArtifactId String
  summary          Json           @default("{}")
  regressions      Json           @default("[]")
  detail           Json           @default("{}")
  createdBy        String
  baseArtifact     BinaryArtifact @relation("BinaryDiffBase", fields: [baseArtifactId], references: [id], onDelete: Cascade)
  targetArtifact   BinaryArtifact @relation("BinaryDiffTarget", fields: [targetArtifactId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([workspaceId])
  @@index([baseArtifactId])
  @@index([targetArtifactId])
}

// A controlled debug session (§67–§71): policy-governed record. LAB
// environment + separate approval + typed operations + NO_NETWORK
// default + hard timeout + kill-switch state are all recorded.
// Debugger transports are provisioned per deployment; an eligible
// session without a transport reports NOT_PROVISIONED (§72).
model BinaryDebugSession {
  id                String         @id @default(uuid())
  workspaceId       String
  artifactId        String
  environment       String         @default("LAB")
  status            String         @default("REQUESTED") // REQUESTED | APPROVED | BLOCKED | ELIGIBLE | RUNNING | COMPLETED | TERMINATED | NOT_PROVISIONED
  operations        Json           @default("[]")
  policyDecision    Json           @default("{}")
  networkPolicy     String         @default("NO_NETWORK")
  timeoutSeconds    Int            @default(1800)
  killSwitchChecked Boolean        @default(false)
  requestedBy       String
  approvedBy        String?
  startedAt         DateTime?
  endedAt           DateTime?
  artifact          BinaryArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  crashes           BinaryCrash[]
  createdAt         DateTime       @default(now())

  @@index([workspaceId])
  @@index([artifactId])
}

// A captured crash (§74–§77): normalized metadata + register summary
// (bounded JSON), dedup fingerprint from exception type + normalized
// stack + faulting function + lineage — never raw addresses. Triage
// NEVER claims exploitability.
model BinaryCrash {
  id               String              @id @default(uuid())
  workspaceId      String
  artifactId       String
  sessionId        String?
  fingerprint      String
  signal           String
  exceptionType    String?
  faultingFunction String?
  stackSummary     Json                @default("[]")
  registerSummary  Json                @default("{}")
  inputReference   String?
  // LIKELY_SECURITY_RELEVANT | NEEDS_REVIEW | LIKELY_NON_SECURITY | UNKNOWN
  triage           String              @default("NEEDS_REVIEW")
  artifact         BinaryArtifact      @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  session          BinaryDebugSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())

  @@index([workspaceId, fingerprint])
  @@index([artifactId])
}

// ------------------------------- Prompt 19 — Wireless security assessment -------------------------------
// PASSIVE-FIRST (§IMPORTANT/§99): these models record OBSERVED
// inventory and OFFLINE capture analysis only. Nothing here can
// represent a transmission, a cracking attempt or a rogue AP created
// by the platform — those behaviours do not exist. Observed data is
// untrusted input, sanitized before persistence (§92); stations are
// pseudonymized by default (§9); authentication material in captures
// is a COUNT, never a value (§67).

// §3: a wireless environment under assessment. No precise physical
// coordinates are required — a location LABEL suffices.
model WirelessEnvironment {
  id                  String                       @id @default(uuid())
  workspaceId         String
  name                String
  locationLabel       String?
  // CORPORATE | GUEST | LAB | OFFICE | PUBLIC | UNKNOWN — drives
  // contextual risk (§34) and gate PMF requirements (§60).
  environment         String                       @default("CORPORATE")
  criticality         String                       @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  authorizationId     String?
  status              String                       @default("ACTIVE") // ACTIVE | ARCHIVED
  createdBy           String
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope               WirelessScope?
  sensors             WirelessSensor[]
  accessPoints        WirelessAccessPoint[]
  stations            WirelessStation[]
  observations        WirelessObservation[]
  channelObservations WirelessChannelObservation[]
  captures            WirelessCapture[]
  approvedProfiles    ApprovedWirelessProfile[]
  events              WirelessSecurityEvent[]
  driftEvents         WirelessDriftEvent[]
  sessions            WirelessScanSession[]
  findings            Finding[]

  @@index([workspaceId])
}

// §4: explicit wireless scope. Authorization is NEVER inferred from
// detectability — only allowlisted BSSIDs/SSIDs/channels/bands are
// in scope for deeper analysis (§63).
model WirelessScope {
  id                        String              @id @default(uuid())
  environmentId             String              @unique
  bssidAllowlist            Json // string[] of normalized BSSIDs
  ssidAllowlist             Json // string[] of SSIDs
  channelAllowlist          Json // number[]
  frequencyBands            Json // ("2.4GHZ" | "5GHZ" | "6GHZ")[]
  maxCaptureDurationSeconds Int                 @default(3600)
  approvedInterfaces        Json // string[] of sensor interface names
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  environment               WirelessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
}

// §11: a dedicated approved wireless sensor. Wireless interfaces are
// never exposed to the web/API/general workers (§14).
model WirelessSensor {
  id                 String                @id @default(uuid())
  workspaceId        String
  environmentId      String?
  name               String
  host               String?
  adapter            String?
  driver             String?
  interfaceName      String?
  supportedBands     Json // ("2.4GHZ" | "5GHZ" | "6GHZ")[]
  monitorModeCapable Boolean               @default(false)
  health             String                @default("UNKNOWN") // HEALTHY | DEGRADED | UNAVAILABLE | UNKNOWN
  status             String                @default("REGISTERED")
  lastSeen           DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment        WirelessEnvironment?  @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  observations       WirelessObservation[]
  captures           WirelessCapture[]
  sessions           WirelessScanSession[]

  @@index([workspaceId])
  @@index([environmentId])
}

// §6: an observed access point. Identity = BSSID (§5) within an
// environment; the SSID is a sanitized label (§92), never identity.
model WirelessAccessPoint {
  id             String                       @id @default(uuid())
  workspaceId    String
  environmentId  String
  bssid          String
  ssid           String                       @default("") // sanitized; "" when hidden (§7)
  ssidHidden     Boolean                      @default(false)
  vendor         String?
  channel        Int?
  frequencyMhz   Int?
  band           String? // 2.4GHZ | 5GHZ | 6GHZ
  securityMode   String                       @default("UNKNOWN") // §31 normalized mode
  encryption     String? // detailed cipher evidence
  authentication String? // detailed AKM evidence
  pmf            String                       @default("UNKNOWN") // REQUIRED | CAPABLE | NOT_OBSERVED | UNKNOWN (§38)
  wpsAdvertised  Boolean                      @default(false)
  signalDbm      Int?
  // §44 latest rogue classification: APPROVED | UNKNOWN | SUSPICIOUS | POLICY_VIOLATION
  approvedStatus String                       @default("UNKNOWN")
  // §50: link to the network asset where evidence supports it —
  // correlation links, never duplicates.
  networkAssetId String?
  firstSeen      DateTime
  lastSeen       DateTime
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  environment    WirelessEnvironment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  networkAsset   Asset?                       @relation(fields: [networkAssetId], references: [id], onDelete: SetNull)
  observations   WirelessObservation[]
  stations       WirelessStation[]
  history        WirelessAccessPointHistory[]
  events         WirelessSecurityEvent[]
  driftEvents    WirelessDriftEvent[]
  findings       Finding[]

  @@unique([environmentId, bssid])
  @@index([workspaceId])
  @@index([environmentId])
  @@index([bssid])
}

// §8/§9: a station observation — bounded security-relevant metadata
// only. addressFingerprint is the HMAC pseudonym (§9); rawAddress is
// populated ONLY under an elevated collection policy and its reads
// are permission-gated + audited (§30).
model WirelessStation {
  id                 String               @id @default(uuid())
  workspaceId        String
  environmentId      String
  addressFingerprint String
  rawAddress         String?
  accessPointId      String?
  associatedBssid    String?
  signalDbm          Int?
  source             String?
  firstSeen          DateTime
  lastSeen           DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  environment        WirelessEnvironment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  accessPoint        WirelessAccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@unique([environmentId, addressFingerprint])
  @@index([workspaceId])
  @@index([environmentId])
}

// §10: one wireless observation — the multi-sensor evidence trail
// behind a canonical AP (§54).
model WirelessObservation {
  id            String              @id @default(uuid())
  workspaceId   String
  environmentId String
  accessPointId String
  sensorId      String?
  captureId     String?
  timestamp     DateTime
  channel       Int?
  bssid         String
  ssid          String              @default("")
  securityMode  String              @default("UNKNOWN")
  signalDbm     Int?
  source        String
  createdAt     DateTime            @default(now())
  environment   WirelessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  accessPoint   WirelessAccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  sensor        WirelessSensor?     @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  capture       WirelessCapture?    @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([environmentId])
  @@index([accessPointId])
}

// §10: channel utilization observation for an environment.
model WirelessChannelObservation {
  id                 String              @id @default(uuid())
  workspaceId        String
  environmentId      String
  scanId             String?
  channel            Int
  band               String?
  accessPointCount   Int                 @default(0)
  utilizationPercent Float?
  noiseDbm           Int?
  source             String
  createdAt          DateTime            @default(now())
  environment        WirelessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([environmentId, channel])
}

// §26: a wireless capture artifact. METADATA ONLY in rows — raw bytes
// live in protected object storage behind artifactReference (§29);
// raw access is permission-gated and audited (§30).
model WirelessCapture {
  id                 String                @id @default(uuid())
  workspaceId        String
  environmentId      String
  sensorId           String?
  name               String
  sha256             String
  format             String // PCAP | PCAPNG (proven from magic bytes, §27)
  sizeBytes          BigInt                @default(0)
  startTime          DateTime?
  endTime            DateTime?
  channels           Json // number[]
  artifactReference  String?
  status             String                @default("PENDING") // PENDING | APPROVED | REJECTED | QUARANTINED (§26 approval workflow)
  sanitizationStatus String                @default("PENDING") // PENDING | SANITIZED | QUARANTINED
  // Bounded recorded analysis payload (parser outputs registered
  // with the capture) — sanitized + metadata-only, NEVER raw frames.
  analysisArtifacts  Json?
  createdBy          String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment        WirelessEnvironment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  sensor             WirelessSensor?       @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  observations       WirelessObservation[]

  @@unique([workspaceId, sha256])
  @@index([workspaceId])
  @@index([environmentId])
}

// §43: an approved wireless profile — expected posture for rogue-AP
// diffing (§42).
model ApprovedWirelessProfile {
  id              String              @id @default(uuid())
  workspaceId     String
  environmentId   String
  ssid            String
  bssid           String?
  securityMode    String // §31 normalized mode
  authentication  String?
  allowedChannels Json // number[]
  allowedBands    Json // string[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  environment     WirelessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([environmentId])
}

// §47: a passively-detected wireless security event. Detection never
// triggers a transmission (§47/§68).
model WirelessSecurityEvent {
  id              String               @id @default(uuid())
  workspaceId     String
  environmentId   String
  accessPointId   String?
  type            String // DEAUTH_ACTIVITY | DISASSOCIATION_ACTIVITY | ROGUE_AP_SUSPECTED | SECURITY_MODE_CHANGED | NEW_UNKNOWN_AP | APPROVED_AP_MISSING | OTHER (§48)
  timestamp       DateTime
  bssid           String?
  confidence      String               @default("LOW") // LOW | MEDIUM | HIGH (§49)
  evidenceSummary String // sanitized, bounded — never raw frames
  source          String
  createdAt       DateTime             @default(now())
  environment     WirelessEnvironment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  accessPoint     WirelessAccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([environmentId])
  @@index([type])
}

// §56: wireless configuration drift — a fact, never an accusation.
model WirelessDriftEvent {
  id                String               @id @default(uuid())
  workspaceId       String
  environmentId     String
  accessPointId     String?
  kind              String // ENCRYPTION_CHANGED | AUTHENTICATION_CHANGED | NEW_AP | AP_DISAPPEARED | BSSID_CHANGED | CHANNEL_POLICY_CHANGED
  bssid             String
  ssid              String               @default("")
  field             String
  fromValue         String?
  toValue           String?
  securityDowngrade Boolean              @default(false)
  detectedAt        DateTime             @default(now())
  environment       WirelessEnvironment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  accessPoint       WirelessAccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([environmentId])
}

// §55: AP configuration history — posture over time per BSSID.
model WirelessAccessPointHistory {
  id             String              @id @default(uuid())
  accessPointId  String
  ssid           String              @default("")
  channel        Int?
  securityMode   String
  authentication String?
  approvedStatus String
  observedAt     DateTime
  accessPoint    WirelessAccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  @@index([accessPointId])
}

// §62: a passive wireless scan session.
model WirelessScanSession {
  id               String              @id @default(uuid())
  workspaceId      String
  environmentId    String
  sensorId         String?
  scanId           String?
  profile          String
  scopeSnapshot    Json // §4 scope as frozen at session start
  startedAt        DateTime            @default(now())
  endedAt          DateTime?
  channels         Json // number[]
  observationCount Int                 @default(0)
  status           String              @default("RUNNING") // RUNNING | COMPLETED | PARTIAL | FAILED | NOT_CONFIGURED
  budget           Json // WirelessScanBudget (§61)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  environment      WirelessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  sensor           WirelessSensor?     @relation(fields: [sensorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([environmentId])
  @@index([scanId])
}

// ------------------------------- Unified vulnerability management, reporting & dashboards (Prompt 20) -------------------------------
// Prompt 20 unifies every engine (Prompts 5–19) into ONE canonical
// vulnerability-management architecture: observations → fingerprint →
// canonical finding → risk → ownership → SLA → exception → retest →
// immutable report snapshots → dashboards, plus governed connectors to
// external vulnerability platforms. Nothing here creates a parallel
// finding system: Finding/FindingObservation remain the only records.

// §18: non-destructive grouping of related findings (same CVE across
// workloads, same cloud policy across accounts). Membership never merges
// or deletes findings.
model FindingCluster {
  id          String    @id @default(uuid())
  workspaceId String
  key         String // deterministic cluster key (see SDK correlation engine)
  kind        String // CVE | CWE | COMPONENT | CLOUD_POLICY | CONFIG_CLASS
  label       String
  findings    Finding[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// §14–§16: semantic + cross-domain correlation relationships between
// canonical findings. Relationships are evidence links, never merges.
model FindingCorrelation {
  id            String   @id @default(uuid())
  workspaceId   String
  fromFindingId String
  toFindingId   String
  relationship  String // SAME_ROOT_CAUSE | RELATED | PARENT_CHILD | CAUSES | EXPOSES | DUPLICATE | POTENTIAL_DUPLICATE
  rationale     String?
  createdBy     String?
  fromFinding   Finding  @relation("CorrelationFrom", fields: [fromFindingId], references: [id], onDelete: Cascade)
  toFinding     Finding  @relation("CorrelationTo", fields: [toFindingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([fromFindingId, toFindingId, relationship])
  @@index([workspaceId])
  @@index([fromFindingId])
  @@index([toFindingId])
}

// §26: current ownership of a finding. One row per finding — the current
// owner; the assignment history lives in FindingHistory. Auto-assignment
// (§27) creates source=RULE rows and NEVER overwrites a MANUAL row.
model FindingOwnership {
  id          String   @id @default(uuid())
  findingId   String   @unique
  workspaceId String
  ownerType   String // USER | TEAM | APPLICATION | BUSINESS_UNIT | ASSET_OWNER
  ownerRef    String // user id / team name / application name / business unit — an identifier, never a credential
  source      String   @default("MANUAL") // MANUAL | RULE
  ruleId      String?
  assignedBy  String?
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, ownerRef])
}

// §27: configurable auto-assignment rules, evaluated in priority order.
model OwnershipRule {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  matchKind   String // SOURCE_DOMAIN | REPOSITORY | CLOUD_ACCOUNT | ASSET_GROUP | MOBILE_APP
  matchValue  String
  ownerType   String // USER | TEAM | APPLICATION | BUSINESS_UNIT | ASSET_OWNER
  ownerRef    String
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// §28: SLA policy V2 — deadlines for triage, remediation AND retest,
// keyed by severity/priority with environment, asset-criticality and
// finding-type modifiers, all expressed as data (rules JSON), never as
// a hardcoded organization's policy. The Prompt 11 RemediationSlaPolicy
// remains for the original engine; this is its unified successor.
model VmSlaPolicy {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  rules       Json // { triageHours?, remediationHours?, retestHours? } each { byPriority?, bySeverity? } + modifiers
  isDefault   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// §31–§33: risk exceptions. High-risk exceptions require a SEPARATE
// approver (requestedBy != approvedBy) — enforced in the service layer.
// Expired exceptions return the finding to review; they never silently
// stay active.
model RiskException {
  id          String    @id @default(uuid())
  workspaceId String
  findingId   String
  type        String // ACCEPTED_RISK | FALSE_POSITIVE | COMPENSATING_CONTROL | TEMPORARY_EXCEPTION
  status      String    @default("PENDING") // PENDING | ACTIVE | REJECTED | EXPIRED
  requestedBy String
  approvedBy  String?
  reason      String
  scope       Json? // what the exception covers (finding-scoped by default)
  expiresAt   DateTime?
  finding     Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([findingId])
  @@index([expiresAt])
}

// §44: identity of a local finding inside an external platform. The
// external system is NEVER authoritative over local analyst decisions
// (§43/§114) — the last-synced external status/severity are kept for
// conflict detection only.
model ExternalFindingReference {
  id               String   @id @default(uuid())
  workspaceId      String
  integrationId    String
  findingId        String?
  externalSystem   String // DEFECTDOJO | FARADAY | DRADIS | PLEXTRAC | SERPICO
  externalId       String
  externalUrl      String?
  externalStatus   String?
  externalSeverity String?
  syncVersion      Int      @default(1)
  lastSyncedAt     DateTime @default(now())
  finding          Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@unique([integrationId, externalId])
  @@index([workspaceId])
  @@index([findingId])
}

// §43: a sync disagreement between DSRclone and an external platform.
// Conflicts are surfaced and resolved explicitly — never by silently
// overwriting the local analyst decision.
model IntegrationConflict {
  id                  String    @id @default(uuid())
  workspaceId         String
  integrationId       String
  findingId           String?
  externalReferenceId String?
  field               String // status | severity | ownership | external_closed
  localValue          String?
  externalValue       String?
  status              String    @default("OPEN") // OPEN | RESOLVED_KEEP_LOCAL | RESOLVED_TAKE_EXTERNAL
  resolvedBy          String?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([integrationId])
}

// §96: bounded background jobs for imports/exports/syncs. Large work
// never runs inside an API request.
model IntegrationJob {
  id            String    @id @default(uuid())
  workspaceId   String
  integrationId String
  kind          String // IMPORT | EXPORT | SYNC
  mode          String? // PULL | PUSH | BIDIRECTIONAL (sync)
  status        String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED
  summary       Json      @default("{}")
  createdBy     String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([workspaceId, status])
  @@index([integrationId])
}

// §68: report templates. Branding + structure ONLY — templates contain
// no executable code and are validated as such at write time.
model ReportTemplate {
  id                  String   @id @default(uuid())
  workspaceId         String
  name                String
  organizationName    String?
  logoRef             String? // object-storage reference name — never an embedded binary
  sections            Json     @default("[]") // ordered section keys from the governed catalog
  severityDefinitions Json     @default("{}")
  footer              String?
  classification      String   @default("CONFIDENTIAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED (§64)
  customBlocks        Json     @default("[]") // static text blocks only
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// §57: a unified security report over ANY set of engines. scope is a
// filter document (domains, period, environment) — generating a report
// never runs a scan; it reads stored records only.
model SecurityReport {
  id             String          @id @default(uuid())
  workspaceId    String
  title          String
  type           String // EXECUTIVE | TECHNICAL_VAPT | WEB | NETWORK | API | CLOUD | CONTAINER_KUBERNETES | SOURCE_SCA | IDENTITY | MOBILE | BINARY | WIRELESS | COMPLIANCE | REMEDIATION | RETEST (§55)
  scope          Json            @default("{}")
  periodStart    DateTime?
  periodEnd      DateTime?
  generatedBy    String
  templateId     String?
  version        String          @default("v1") // §66: v1, v1.1, v2 …
  status         String          @default("DRAFT") // DRAFT | GENERATING | READY | FAILED | ARCHIVED (§58)
  approvalStatus String          @default("DRAFT") // DRAFT | REVIEW | APPROVED | ISSUED (§67)
  classification String          @default("CONFIDENTIAL")
  changeNotes    String?
  approvedBy     String?
  snapshot       ReportSnapshot?
  exports        ReportExport[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

// §56: the immutable point-in-time content of a report. Once written a
// snapshot is NEVER updated — later finding changes produce a new
// report version with its own snapshot, never a silent edit.
model ReportSnapshot {
  id           String         @id @default(uuid())
  reportId     String         @unique
  workspaceId  String
  data         Json // full normalized report document (sanitized + redacted at build time)
  contentHash  String // SHA-256 over the canonical snapshot document
  findingCount Int            @default(0)
  report       SecurityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@index([workspaceId])
}

// §59/§70: one rendered artifact per format, stored via the object-store
// interface with checksum + size; downloads are authorization-checked
// and audited (REPORT_DOWNLOADED).
model ReportExport {
  id              String         @id @default(uuid())
  reportId        String
  workspaceId     String
  format          String // PDF | HTML | JSON | CSV
  status          String         @default("READY") // READY | FAILED
  storageLocation String?
  checksum        String?
  sizeBytes       Int?
  createdBy       String
  report          SecurityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([reportId])
  @@index([workspaceId])
}

// Report scheduling DEFINITIONS (§55 companion). Stored now; execution
// is owned by the Prompt 22 scheduler — no cron machinery is invented
// in this phase.
model ReportSchedule {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  reportType     String
  templateId     String?
  cronExpression String
  recipients     Json     @default("[]")
  formats        Json     @default("[]")
  enabled        Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// §81: periodic executive risk snapshots. Historical trend charts read
// THESE rows — they are never recomputed from current state.
model RiskSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  metrics     Json // overall risk score, severity counts, KEV, SLA posture at capture time
  capturedAt  DateTime @default(now())

  @@index([workspaceId, capturedAt])
}

// §88: notification EVENT model. Events are recorded here; delivery
// providers are deliberately not hard-coded in this phase.
model VmNotificationEvent {
  id          String    @id @default(uuid())
  workspaceId String
  type        String // CRITICAL_FINDING_CREATED | KEV_DETECTED | SLA_DUE_SOON | SLA_OVERDUE | FINDING_REOPENED | RETEST_COMPLETED | REPORT_READY
  findingId   String?
  payload     Json      @default("{}")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
}

// §87: reusable tag vocabulary for findings and assets (finding rows
// keep their tags array; this table is the governed vocabulary).
model VmTag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  kind        String   @default("FINDING") // FINDING | ASSET
  createdAt   DateTime @default(now())

  @@unique([workspaceId, kind, name])
  @@index([workspaceId])
}

// ------------------------------- AI Security Copilot (Prompt 21) -------------------------------
// The AI layer is an ANALYST ASSISTANT over normalized platform data
// only (§1/§120): it has no execution authority, no scanner/SQL/shell
// path, and every retrieval is tenant-filtered at the data layer (§12)
// with RBAC applied BEFORE context construction (§11). Provider
// credentials are stored as secret REFERENCES only — never values.

// §3/§64: provider configuration. `credentialRef` names a secret in the
// platform credential store; the raw key never lands in this table, in
// logs, or in any API response (§110).
model AiProviderConfig {
  id                      String    @id @default(uuid())
  workspaceId             String
  name                    String
  providerType            String // OPENAI_COMPATIBLE | ANTHROPIC | AZURE_OPENAI | LOCAL | MOCK
  baseUrl                 String?
  credentialRef           String? // secret reference NAME only (§64)
  isExternal              Boolean   @default(true)
  region                  String?
  enabled                 Boolean   @default(false)
  // §64 data policy: which classifications this provider may receive.
  approvedClassifications String[]  @default(["PUBLIC", "INTERNAL"])
  sourceCodeAllowance     String    @default("REDACTED") // DISABLED | REDACTED | ALLOWED
  retentionPolicy         String?
  // §110 health (never credentials).
  healthStatus            String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | HEALTHY | DEGRADED | UNAVAILABLE
  lastHealthCheckAt       DateTime?
  lastSuccessfulAt        DateTime?
  lastLatencyMs           Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  models AiModel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// §4: model registry — capabilities, context limit, allowed tasks,
// health. Business logic never hard-codes a vendor (§3).
model AiModel {
  id            String    @id @default(uuid())
  workspaceId   String
  providerId    String
  modelName     String
  capabilities  String[]  @default([]) // GENERATE | STREAM | EMBED
  contextLimit  Int       @default(8192)
  enabled       Boolean   @default(true)
  allowedTasks  String[]  @default([])
  isFallbackFor String? // model id this model falls back FROM (§107)
  costMetadata  Json?
  healthStatus  String    @default("UNKNOWN")
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  provider AiProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId, modelName])
  @@index([workspaceId])
}

// §109/§16/§17/§62: workspace AI policy singleton. Defaults are the
// spec defaults: source code REDACTED, raw evidence SANITIZED_ONLY.
model AiWorkspacePolicy {
  id                String   @id @default(uuid())
  workspaceId       String   @unique
  sourceCodeAccess  String   @default("REDACTED") // DISABLED | REDACTED | ALLOWED_FOR_APPROVED_PROVIDER
  rawEvidenceAccess String   @default("SANITIZED_ONLY") // DISABLED | SANITIZED_ONLY | APPROVED_PROVIDER_ONLY
  enabledTasks      String[] @default([])
  chatRetentionDays Int      @default(30)
  primaryModelId    String?
  fallbackModelId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// §104: usage budgets — workspace daily/monthly token ceilings, task
// limits and the maximum retrieval set the copilot may pull (§10).
model AiUsageBudget {
  id                  String   @id @default(uuid())
  workspaceId         String   @unique
  dailyTokenLimit     Int      @default(200000)
  monthlyTokenLimit   Int      @default(4000000)
  perTaskTokenLimit   Int      @default(16000)
  maxRetrievalRecords Int      @default(25)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// §59: workspace copilot conversation, bound to an optional typed
// context (FINDING | ASSET | SCAN | REPORT | CVE | WORKSPACE …).
model AiConversation {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  contextType String   @default("WORKSPACE")
  contextId   String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages AiMessage[]

  @@index([workspaceId, userId])
  @@index([workspaceId, contextType, contextId])
}

// §60: conversation message. Content stored here is the SANITIZED form
// only (§60/§63) — raw model context is never persisted by default.
model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  workspaceId    String
  role           String // USER | ASSISTANT | SYSTEM
  content        String // sanitized content only
  modelName      String?
  providerName   String?
  answerOrigin   String? // MODEL | RULE_BASED | NONE (assistant rows)
  confidence     String? // LOW | MEDIUM | HIGH
  citations      Json     @default("[]")
  tokenUsage     Json?
  requestLogId   String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId])
}

// §63: model request log — identifiers and counters ONLY. Full
// sensitive prompts are never logged (§63); redaction counts are (§15).
model AiRequestLog {
  id               String   @id @default(uuid())
  workspaceId      String
  userId           String
  task             String
  providerName     String?
  modelName        String?
  status           String // COMPLETED | NOT_CONFIGURED | POLICY_BLOCKED | PROVIDER_ERROR | INSUFFICIENT_EVIDENCE
  policyDecision   String? // ALLOW | DENY | REQUIRE_REDACTION | REQUIRE_REVIEW
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  redactionCount   Int      @default(0)
  citationCount    Int      @default(0)
  injectionFlags   Int      @default(0)
  contextHash      String?
  createdAt        DateTime @default(now())

  citations AiCitation[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, task])
}

// §22: citation — every factual claim traces to a platform record.
model AiCitation {
  id                String   @id @default(uuid())
  workspaceId       String
  requestLogId      String
  claim             String
  sourceType        String // FINDING | OBSERVATION | EVIDENCE | ASSET | CVE | CWE | KEV | EPSS | SBOM_COMPONENT | GRAPH_RELATIONSHIP | COMPLIANCE_CONTROL | DOCUMENTATION
  sourceId          String
  evidenceReference String?
  confidence        Float    @default(0.5)
  createdAt         DateTime @default(now())

  requestLog AiRequestLog @relation(fields: [requestLogId], references: [id], onDelete: Cascade)

  @@index([workspaceId, requestLogId])
}

// §34: AI-suggested patch — review-only. AI never commits code (§35).
model AiSuggestedPatch {
  id          String   @id @default(uuid())
  workspaceId String
  findingId   String
  filePath    String?
  diff        String
  modelName   String?
  citations   Json     @default("[]")
  confidence  String? // LOW | MEDIUM | HIGH
  status      String   @default("PROPOSED") // PROPOSED | REVIEWED | ACCEPTED | REJECTED | SUPERSEDED
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, findingId])
  @@index([workspaceId, status])
}

// §83: AI action proposal — the AI proposes; the EXISTING workflow
// authorizes and executes (§8/§99). A proposal is never an execution.
model AiActionProposal {
  id                 String    @id @default(uuid())
  workspaceId        String
  proposedByUserId   String
  actionType         String // REQUEST_VALIDATION | REQUEST_RETEST | ASSIGN_FINDING | CREATE_REPORT_DRAFT
  targetType         String
  targetId           String
  summary            String
  scope              Json      @default("{}")
  requiredPermission String
  status             String    @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | DISMISSED
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId, status])
}

// §85: analyst feedback on AI responses (quality signal, §86).
model AiFeedback {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String
  messageId    String?
  requestLogId String?
  task         String?
  rating       String // HELPFUL | NOT_HELPFUL | INCORRECT | UNSAFE | OUTDATED
  comment      String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, rating])
  @@index([workspaceId, task])
}

// §71: governed knowledge document. Content is UNTRUSTED data (§72):
// ingested with size caps + injection scanning, cited exactly (§73).
model KnowledgeDocument {
  id             String   @id @default(uuid())
  workspaceId    String
  title          String
  source         String
  classification String   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED | SECRET
  version        String   @default("1")
  contentHash    String
  status         String   @default("ACTIVE") // ACTIVE | ARCHIVED
  content        String // sanitized at ingestion (§72)
  injectionFlags Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId, status])
}

// §67: tenant-scoped vector storage. Every vector carries workspaceId,
// sourceType, sourceId and classification; retrieval filters on tenant
// metadata BEFORE similarity is considered (§68).
model AiEmbedding {
  id             String   @id @default(uuid())
  workspaceId    String
  sourceType     String // FINDING | REMEDIATION | KNOWLEDGE_DOCUMENT
  sourceId       String
  classification String   @default("INTERNAL")
  vector         Json // number[] — deterministic local embedder output
  contentHash    String
  createdAt      DateTime @default(now())

  @@unique([workspaceId, sourceType, sourceId])
  @@index([workspaceId, sourceType])
}

// §87: evaluation run record — the golden-dataset suite result. Stores
// counts and check outcomes only, never fixture secrets (there are
// none beyond synthetic redaction targets, §88).
model AiEvaluationRun {
  id          String   @id @default(uuid())
  workspaceId String
  suite       String   @default("GOLDEN")
  passed      Int
  failed      Int
  results     Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// =====================================================================
// Prompt 22 — Continuous Security Monitoring, Scheduler & Automation
// =====================================================================

// §3: a monitoring policy binds a governed target selector + a SAFE
// scan profile + frequency to continuous monitoring. The policy never
// widens authorization: every resolved target is re-authorized at
// schedule creation AND before every run (§25).
model MonitoringPolicy {
  id                 String   @id @default(uuid())
  workspaceId        String
  name               String
  enabled            Boolean  @default(true)
  // §5 MonitoringTargetSelector JSON (explicit ids / tags / env / BU /
  // asset type / criticality). Discovered third-party assets are never
  // auto-monitored (§4) — selectors resolve inside the workspace only.
  targetSelector     Json     @default("{}")
  scanProfile        String // AssessmentProfile name — must classify SAFE_AUTOMATED
  frequency          String   @default("DAILY") // HOURLY|DAILY|WEEKLY|MONTHLY|CUSTOM
  cronExpression     String?
  timezone           String   @default("UTC")
  safeOnly           Boolean  @default(true)
  riskThreshold      Float?
  retestPolicy       Json     @default("{}") // AutoRetestPolicy knobs (§51)
  notificationPolicy Json     @default("{}")
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// §6: one recurring schedule. kind SCAN materializes through the gated
// orchestration path; REPORT executes Prompt 20 ReportSchedule
// definitions; REVALIDATION creates Prompt 16 validation requests
// that still require their own approval; INTEL_SYNC refreshes intel
// per the configured data-source policy (§49). No kind bypasses a gate.
model SecuritySchedule {
  id               String    @id @default(uuid())
  workspaceId      String
  policyId         String?
  name             String
  kind             String    @default("SCAN") // SCAN|REPORT|REVALIDATION|INTEL_SYNC|RETEST
  assessmentId     String?
  reportScheduleId String?
  profile          String? // snapshot of the approved assessment profile (SCANS)
  expression       String // governed cron-like expression (validated)
  frequency        String    @default("DAILY")
  timezone         String    @default("UTC")
  nextRunAt        DateTime
  lastRunAt        DateTime?
  lastStatus       String? // ScheduleRunStatus of the most recent run
  enabled          Boolean   @default(true)
  paused           Boolean   @default(false)
  failureCount     Int       @default(0)
  missedRunPolicy  String    @default("RUN_ONCE") // SKIP|RUN_ONCE|CATCH_UP_LIMITED
  allowConcurrent  Boolean   @default(false) // §18 duplicate-run opt-in
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, enabled])
  @@index([nextRunAt, enabled])
}

// One materialized (or refused) scheduled run. scheduleRunKey is the
// §19 deterministic idempotency key — unique across the platform, so
// two scheduler nodes racing the same due instant produce ONE run.
model ScheduleRun {
  id                  String    @id @default(uuid())
  workspaceId         String
  scheduleId          String
  scheduleRunKey      String    @unique
  scheduledFor        DateTime
  status              String // ENQUEUED|COMPLETED|FAILED|BLOCKED|SKIPPED|DEFERRED|PENDING_APPROVAL
  reasonCode          String?
  reason              String?
  scanId              String?
  reportId            String?
  validationRequestId String?
  retestRequestId     String?
  attempts            Int       @default(0)
  nextAttemptAt       DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  @@index([workspaceId, scheduleId])
  @@index([workspaceId, createdAt])
  @@index([status])
}

// §24: distributed scheduler lease — one row per scope ("global").
model SchedulerLease {
  id          String   @id @default(uuid())
  scope       String   @unique
  owner       String
  leaseUntil  DateTime
  heartbeatAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-workspace scheduler quotas (§13/§17/§95/§96).
model SchedulerSettings {
  id                          String   @id @default(uuid())
  workspaceId                 String   @unique
  maxConcurrentScheduledScans Int      @default(2)
  dailyRunBudget              Int      @default(200)
  queueDepthThreshold         Int      @default(100)
  leaseTtlSeconds             Int      @default(120)
  maxRetryAttempts            Int      @default(3)
  updatedBy                   String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// §15: allowed/blocked scan hours in an explicit timezone.
model MaintenanceWindow {
  id          String   @id @default(uuid())
  workspaceId String
  policyId    String?
  name        String
  daysOfWeek  Json     @default("[]") // number[] 0=Sunday
  startTime   String // HH:MM
  endTime     String // HH:MM
  timezone    String   @default("UTC")
  mode        String   @default("ALLOWED_HOURS") // ALLOWED_HOURS|BLOCKED_HOURS
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

// §16: blackout window — scheduled jobs must respect it (defer/skip).
model BlackoutWindow {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  reason      String?
  startsAt    DateTime
  endsAt      DateTime
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([workspaceId, startsAt])
}

// §29: immutable posture snapshot. Rows are never updated after
// creation (§32) — history is read from these, never recomputed.
model SecurityPostureSnapshot {
  id                 String   @id @default(uuid())
  workspaceId        String
  capturedAt         DateTime @default(now())
  source             String   @default("SCHEDULED") // SCHEDULED|MANUAL|SCAN_COMPLETION
  assetCount         Int
  findingCount       Int
  findingsBySeverity Json     @default("{}")
  findingsByStatus   Json     @default("{}")
  kevCount           Int      @default(0)
  verifiedFindings   Int      @default(0)
  slaOverdue         Int      @default(0)
  slaDueSoon         Int      @default(0)
  coverage           Float?
  riskScore          Float?
  contentHash        String

  @@index([workspaceId, capturedAt])
}

// §30: one asset-state capture run (header) + normalized entries.
model AssetSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  capturedAt  DateTime @default(now())
  source      String   @default("SCHEDULED")
  entryCount  Int      @default(0)
  contentHash String

  @@index([workspaceId, capturedAt])
}

model AssetSnapshotEntry {
  id            String  @id @default(uuid())
  snapshotId    String
  workspaceId   String
  assetKey      String
  assetId       String?
  host          String
  type          String
  exposure      String  @default("UNKNOWN")
  scopeStatus   String  @default("IN_SCOPE")
  criticality   String  @default("UNSPECIFIED")
  ports         Json    @default("[]")
  services      Json    @default("[]")
  endpointCount Int     @default(0)
  stateHash     String

  @@index([snapshotId])
  @@index([workspaceId, assetKey])
}

// §31: one finding-state capture run (header) + entries.
model FindingSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  capturedAt  DateTime @default(now())
  source      String   @default("SCHEDULED")
  entryCount  Int      @default(0)
  contentHash String

  @@index([workspaceId, capturedAt])
}

model FindingSnapshotEntry {
  id                 String  @id @default(uuid())
  snapshotId         String
  workspaceId        String
  findingId          String?
  fingerprint        String
  status             String
  lifecycleStatus    String
  severity           String
  priority           String?
  riskScore          Float?
  verificationStatus String
  kevListed          Boolean @default(false)
  cve                String?
  stateHash          String

  @@index([snapshotId])
  @@index([workspaceId, fingerprint])
}

// §34: attack-surface changes detected between asset snapshots.
model AttackSurfaceChange {
  id             String   @id @default(uuid())
  workspaceId    String
  type           String // NEW_DOMAIN|NEW_SUBDOMAIN|NEW_HOST|NEW_PORT|NEW_SERVICE|NEW_WEB_APP|NEW_API|NEW_CLOUD_RESOURCE|NEW_PUBLIC_RESOURCE|NEW_REPOSITORY|NEW_CONTAINER_IMAGE|EXPOSURE_CHANGED|SERVICE_CHANGED|ENDPOINT_CHANGED|ASSET_REMOVED
  assetKey       String
  host           String
  priority       String   @default("NORMAL") // HIGH|NORMAL
  detail         String
  fromSnapshotId String?
  toSnapshotId   String?
  detectedAt     DateTime @default(now())

  @@index([workspaceId, detectedAt])
  @@index([workspaceId, type])
}

// Generic drift record for the §83 drift page filters (asset, finding,
// cloud, source, mobile, binary, identity, wireless domains whose
// per-domain engines live in their own phases; the continuous engine
// records their snapshot comparisons here under one queryable shape).
model DriftEvent {
  id          String   @id @default(uuid())
  workspaceId String
  domain      String // ASSET|WEB|API|CLOUD|KUBERNETES|SOURCE|MOBILE|BINARY|IDENTITY|WIRELESS
  changeType  String
  entityKey   String
  detail      String
  fromValue   Json?
  toValue     Json?
  detectedAt  DateTime @default(now())

  @@index([workspaceId, domain])
  @@index([workspaceId, detectedAt])
}

// Finding-level drift (§47).
model FindingDriftEvent {
  id          String   @id @default(uuid())
  workspaceId String
  type        String // NEW|RESOLVED|REOPENED|SEVERITY_CHANGED|PRIORITY_CHANGED|VERIFICATION_CHANGED|RISK_CHANGED
  fingerprint String
  findingId   String?
  detail      String
  fromValue   Json?
  toValue     Json?
  detectedAt  DateTime @default(now())

  @@index([workspaceId, detectedAt])
  @@index([workspaceId, fingerprint])
}

// §48: risk drift from intelligence/exposure movement — no new scan.
model RiskDriftEvent {
  id          String   @id @default(uuid())
  workspaceId String
  type        String // KEV_ADDED|EPSS_INCREASED|CVSS_CHANGED|ASSET_BECAME_PUBLIC|CRITICALITY_CHANGED|VERIFICATION_CHANGED
  findingId   String?
  cve         String?
  detail      String
  fromValue   Json?
  toValue     Json?
  detectedAt  DateTime @default(now())

  @@index([workspaceId, detectedAt])
  @@index([workspaceId, cve])
}

// §51: automatic-retest policy. Eligibility itself is decided per
// finding by the SDK AutoRetestPolicy evaluator (RetestRouter + the
// governed SAFE validator catalog); this row governs workspace knobs.
model AutoRetestPolicy {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  enabled     Boolean  @default(false)
  triggers    Json     @default("[]") // SCHEDULED|NEW_DEPLOYMENT_OR_BUILD|NEW_SCAN_OBSERVATION|REMEDIATION_MARKER
  maxPerDay   Int      @default(50)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// §57: typed workflow definition. The definition Json is a validated
// SecurityWorkflowDSL document — typed triggers/conditions/actions
// only; arbitrary code is rejected at validation (§61/§62).
model SecurityWorkflow {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  trigger     String
  conditions  Json     @default("[]")
  actions     Json     @default("[]")
  enabled     Boolean  @default(true)
  owner       String
  version     Int      @default(1)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, trigger])
  @@index([workspaceId, enabled])
}

// §64: one workflow execution against one event.
model WorkflowExecution {
  id          String    @id @default(uuid())
  workspaceId String
  workflowId  String
  eventId     String
  trigger     String
  status      String // COMPLETED|PARTIAL|BLOCKED_LOOP|FAILED
  actions     Json      @default("[]") // executed action records (type, dedupKey, outcome)
  depth       Int       @default(0)
  lineage     Json      @default("[]")
  errors      Json      @default("[]")
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workspaceId, workflowId])
  @@index([workspaceId, startedAt])
}

// §67: notification policy (channels, thresholds, quiet hours, dedup).
model NotificationPolicy {
  id                  String   @id @default(uuid())
  workspaceId         String
  name                String
  eventTypes          Json     @default("[]")
  minSeverity         String?
  minPriority         String?
  riskThreshold       Float?
  channels            Json     @default("[\"IN_APP\"]")
  recipients          Json     @default("[]")
  dedupWindowMinutes  Int      @default(60)
  quietHours          Json? // {startTime,endTime,timezone}
  emergencySeverities Json     @default("[\"CRITICAL\"]")
  throttlePerHour     Int      @default(60)
  // §73 webhook destination (when WEBHOOK is among channels): URL +
  // host allowlist + signing-secret REFERENCE only — never a secret.
  webhookUrl          String?
  webhookAllowlist    Json     @default("[]")
  signingSecretRef    String?
  enabled             Boolean  @default(true)
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// §71: escalation policy — P0/P1 unresolved past a duration escalates.
model AlertEscalationPolicy {
  id                   String   @id @default(uuid())
  workspaceId          String
  name                 String
  priorities           Json     @default("[\"P0\",\"P1\"]")
  escalateAfterMinutes Int      @default(240)
  escalateTo           Json     @default("[]") // recipient user ids / team names
  enabled              Boolean  @default(true)
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// One routed notification. Delivery status is honest: SENT only when
// a configured provider accepted it; providers that are not
// configured record RECORDED_NOT_DELIVERED with providerStatus
// NOT_CONFIGURED — never a fake "sent" (§66).
model SecurityNotification {
  id             String   @id @default(uuid())
  workspaceId    String
  policyId       String?
  eventType      String
  channel        String // IN_APP|EMAIL|SLACK|TEAMS|WEBHOOK
  status         String // SENT|RECORDED_NOT_DELIVERED|SUPPRESSED_DEDUP|SUPPRESSED_THROTTLE|SUPPRESSED_QUIET_HOURS|FAILED
  providerStatus String? // CONFIGURED|NOT_CONFIGURED
  fingerprint    String
  groupKey       String?
  findingId      String?
  assetKey       String?
  title          String
  detail         String?
  escalated      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, fingerprint])
}

// §76: optional AI daily summary over the immutable daily posture
// snapshot. Content is grounded in stored records with citations to
// their ids (§77); the generator label is honest — RULE_BASED unless a
// real AI provider produced it (Prompt 21 posture).
model AiDailySecuritySummary {
  id          String   @id @default(uuid())
  workspaceId String
  date        String // YYYY-MM-DD in the workspace timezone
  snapshotId  String?
  generator   String   @default("RULE_BASED") // RULE_BASED|AI_PROVIDER
  summary     Json     @default("{}")
  citations   Json     @default("[]")
  createdAt   DateTime @default(now())

  @@unique([workspaceId, date])
  @@index([workspaceId, createdAt])
}

// --------------------- Enterprise identity (Prompt 23) ---------------------
// Layered ON TOP of the existing User/Organization/Membership/Workspace
// models above — no parallel identity system. All secrets below are hashes
// or platform-encrypted values or secret REFERENCES; never plaintext.

enum MfaMethodType {
  TOTP
  WEBAUTHN
  PASSKEY
  RECOVERY_CODES
}

enum MfaRequirement {
  OPTIONAL
  REQUIRED_FOR_ADMINS
  REQUIRED_FOR_ALL
}

enum AuthenticationAssurance {
  AAL1
  AAL2
  PHISHING_RESISTANT
}

enum SsoProviderType {
  OIDC
  SAML
}

enum AuthChallengeType {
  MFA_TOTP
  WEBAUTHN_REGISTRATION
  WEBAUTHN_AUTHENTICATION
  PASSWORD_RESET
  STEP_UP
  OIDC_FLOW
  SAML_FLOW
}

enum AccessReviewStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AccessReviewDecision {
  KEEP
  REVOKE
  CHANGE_ROLE
  DISABLE
}

// Server-side session record (§38). Only the SHA-256 hash of the opaque
// session token is stored (§39); revocation is a timestamp, enforced on
// every authenticated request by the session guard.
model UserSession {
  id             String                  @id @default(uuid())
  userId         String
  organizationId String
  workspaceId    String?
  tokenHash      String                  @unique
  assurance      AuthenticationAssurance @default(AAL1)
  deviceSummary  String?
  createdAt      DateTime                @default(now())
  lastSeenAt     DateTime                @default(now())
  expiresAt      DateTime
  idleExpiresAt  DateTime
  revokedAt      DateTime?
  stepUpAt       DateTime?

  @@index([userId])
  @@index([organizationId])
}

model AuthChallenge {
  id         String            @id @default(uuid())
  userId     String
  type       AuthChallengeType
  tokenHash  String            @unique
  expiresAt  DateTime
  attempts   Int               @default(0)
  consumedAt DateTime?
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([userId, type])
}

model MfaMethod {
  id              String        @id @default(uuid())
  userId          String
  type            MfaMethodType
  // TOTP: AES-256-GCM encrypted secret (platform key) — never plaintext,
  // never logged, never returned after enrollment (§27).
  secretEncrypted String?
  credentialId    String? // WebAuthn credential id (public identifier)
  lastUsedStep    BigInt? // TOTP replay protection (§28)
  isActive        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // SHA-256 hash only (§29)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    String // COSE public key, base64url — public material only (§33)
  counter      BigInt    @default(0)
  transports   String?
  friendlyName String?
  isPasskey    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model AuthenticationEvent {
  id             String   @id @default(uuid())
  userId         String?
  organizationId String?
  eventType      String
  ipAddress      String?
  deviceSummary  String?
  riskSignals    Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
}

model EnterpriseSsoProvider {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  type           SsoProviderType
  enabled        Boolean         @default(false)
  enforceSso     Boolean         @default(false)
  jitEnabled     Boolean         @default(false)
  jitDefaultRole Role            @default(VIEWER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
}

model OidcProviderConfig {
  id              String @id @default(uuid())
  providerId      String @unique
  issuer          String
  clientId        String
  clientSecretRef String // secret REFERENCE only (§48)
  scopes          String @default("openid email profile")
  emailClaim      String @default("email")
  nameClaim       String @default("name")
  groupsClaim     String @default("groups")
  subjectClaim    String @default("sub")

  @@index([providerId])
}

model SamlProviderConfig {
  id                      String  @id @default(uuid())
  providerId              String  @unique
  idpEntityId             String
  ssoUrl                  String
  certificate             String // IdP signing certificate (PUBLIC material)
  spEntityId              String
  emailAttribute          String  @default("email")
  nameAttribute           String  @default("displayName")
  groupsAttribute         String  @default("groups")
  wantEncryptedAssertions Boolean @default(false)

  @@index([providerId])
}

// Consumed SAML assertion ids — replay protection (§55).
model SamlAssertionConsumption {
  id          String   @id @default(uuid())
  assertionId String   @unique
  expiresAt   DateTime
  consumedAt  DateTime @default(now())
}

model OrganizationDomain {
  id                    String    @id @default(uuid())
  organizationId        String
  domain                String
  verificationTokenHash String
  status                String    @default("PENDING") // PENDING | VERIFIED
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@unique([organizationId, domain])
  @@index([domain])
}

model OrganizationInvitation {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  normalizedEmail String
  role            Role      @default(VIEWER)
  workspaceIds    Json?
  tokenHash       String    @unique
  status          String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  invitedBy       String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([normalizedEmail])
}

model ScimCredential {
  id             String    @id @default(uuid())
  organizationId String    @unique
  tokenPrefix    String
  tokenHash      String // SHA-256 hash only (§67)
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?
  lastUsedAt     DateTime?
}

model ScimGroupMapping {
  id               String  @id @default(uuid())
  organizationId   String
  externalGroup    String
  organizationRole Role
  workspaceId      String?
  workspaceRole    Role?

  @@unique([organizationId, externalGroup])
  @@index([organizationId])
}

// Records the external (IdP) identity of a SCIM-provisioned user/group so
// updates/deactivation address the right local record.
model ScimExternalRecord {
  id             String  @id @default(uuid())
  organizationId String
  resourceType   String // USER | GROUP
  externalId     String?
  localId        String
  displayName    String?

  @@unique([organizationId, resourceType, localId])
  @@index([organizationId, resourceType])
}

model ServiceAccount {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String? // null = organization-scoped (still least-privilege scopes)
  name           String
  status         String    @default("ACTIVE") // ACTIVE | DISABLED
  scopes         Json // typed API scopes only (§79)
  createdBy      String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

enum ApiKeyOwnerKind {
  USER
  SERVICE_ACCOUNT
}

model ApiKey {
  id             String          @id @default(uuid())
  ownerKind      ApiKeyOwnerKind
  ownerId        String // user id or service-account id
  organizationId String
  name           String
  prefix         String // safe identification prefix only (§78)
  secretHash     String // SHA-256 hash only (§77)
  scopes         Json
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([ownerId])
  @@index([organizationId])
  @@index([prefix])
}

model OrganizationSecurityPolicy {
  id                     String         @id @default(uuid())
  organizationId         String         @unique
  mfaRequirement         MfaRequirement @default(OPTIONAL)
  ssoRequirement         String         @default("OPTIONAL") // OPTIONAL | SSO_REQUIRED
  passwordLoginAllowed   Boolean        @default(true)
  sessionIdleMinutes     Int            @default(30)
  sessionAbsoluteMinutes Int            @default(720)
  apiKeyMaxLifetimeDays  Int?
  patAllowed             Boolean        @default(true)
  scimEnabled            Boolean        @default(false)
  jitEnabled             Boolean        @default(false)
  stepUpActions          Json? // action names requiring step-up (§36)
  updatedAt              DateTime       @updatedAt
  createdAt              DateTime       @default(now())
}

model PasswordPolicy {
  id                      String   @id @default(uuid())
  organizationId          String   @unique
  minLength               Int      @default(12)
  maxLength               Int      @default(128)
  historyCount            Int      @default(5)
  compromisedCheckEnabled Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model BreakGlassEnrollment {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  status         String    @default("ACTIVE") // ACTIVE | DISABLED
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model AccessReview {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  status         AccessReviewStatus @default(OPEN)
  createdBy      String
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
}

model AccessReviewItem {
  id           String                @id @default(uuid())
  reviewId     String
  subjectType  String // MEMBERSHIP | WORKSPACE_MEMBERSHIP | SERVICE_ACCOUNT | API_KEY
  subjectId    String
  subjectLabel String
  decision     AccessReviewDecision?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime              @default(now())

  @@index([reviewId])
}

// ─────────────────────────────────────────────────────────────────────
// Prompt 24 — Enterprise integrations, DevSecOps & security workflow
// engine (§2–§105). Integrations are least-privilege: credentials exist
// ONLY as secret references, inbound webhooks are verified before any
// payload is trusted, and no integration can approve an assessment,
// verify a target, widen scope, or override the finding lifecycle.
// ─────────────────────────────────────────────────────────────────────

// §30/§29: a SourceRepository linked to an external provider
// repository. Identity is the provider's immutable repository ID plus
// the installation/workspace ID — never the mutable name alone (§29).
model RepositoryIntegrationLink {
  id                    String    @id @default(uuid())
  workspaceId           String
  integrationId         String
  sourceRepositoryId    String
  provider              String // GITHUB | GITLAB | BITBUCKET
  externalRepositoryId  String
  externalRepositoryRef String // provider URL/reference (display + lookup only)
  installationId        String? // GitHub installation / GitLab group / Bitbucket workspace (§29)
  defaultBranch         String?
  visibility            String    @default("PRIVATE")
  archived              Boolean   @default(false)
  languages             Json      @default("[]")
  lastSyncedAt          DateTime?
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([integrationId, externalRepositoryId])
  @@unique([workspaceId, sourceRepositoryId])
  @@index([workspaceId])
  @@index([integrationId])
}

// §31: per-repository automation policy. Every flag defaults OFF — a
// webhook alone never enables scanning; an administrator configures
// the policy, and even then a scan starts only through the ordinary
// gates (VERIFIED target + existing APPROVED assessment).
model RepositorySecurityPolicy {
  id                   String   @id @default(uuid())
  workspaceId          String
  sourceRepositoryId   String   @unique
  scanOnPush           Boolean  @default(false)
  scanOnPullRequest    Boolean  @default(false)
  scanDefaultBranch    Boolean  @default(false)
  sastEnabled          Boolean  @default(true)
  scaEnabled           Boolean  @default(true)
  secretScanEnabled    Boolean  @default(true)
  sbomEnabled          Boolean  @default(true)
  containerScanEnabled Boolean  @default(false)
  gatePolicyId         String? // SecurityGatePolicy applied to PR/MR assessments
  prGatePreset         String? // FAIL_ON_NEW_CRITICAL | FAIL_ON_NEW_HIGH | FAIL_ON_NEW_VERIFIED_HIGH | FAIL_ON_NEW_KEV | FAIL_ON_NEW_SECRET | FAIL_ON_POLICY_VIOLATION (§20)
  autoRetest           Boolean  @default(false) // safe auto-retest of resolved findings only (§31)
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId])
}

// §18/§26: one PR/MR security assessment record per (repository, PR,
// head commit). Titles/branch names are UNTRUSTED provider data —
// stored sanitized, rendered escaped, never interpolated into any
// command (§83–§85).
model PullRequestSecurityAssessment {
  id                String   @id @default(uuid())
  workspaceId       String
  integrationId     String
  repositoryId      String // SourceRepository id
  provider          String // GITHUB | GITLAB | BITBUCKET
  prNumber          Int
  title             String // sanitized (§83/§114)
  baseBranch        String?
  headBranch        String? // sanitized (§115)
  baseCommit        String?
  headCommit        String
  scanId            String?
  scanStatus        String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | BLOCKED | SKIPPED
  blockReason       String? // why a trigger did not start a scan (authorization gate)
  gateResult        String? // PASS | FAIL | WARN | ERROR | SKIPPED (§21)
  gateEvaluationId  String?
  newFindings       Json     @default("[]") // finding ids classified NEW vs baseline (§19/§40)
  resolvedFindings  Json     @default("[]") // finding ids resolved vs baseline
  regressedFindings Json     @default("[]") // finding ids REGRESSED (§122)
  checkPublished    String   @default("NOT_ATTEMPTED") // NOT_ATTEMPTED | PUBLISHED | NOT_CONFIGURED | FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([workspaceId, repositoryId, prNumber, headCommit])
  @@index([workspaceId, repositoryId])
  @@index([scanId])
}

// §37: a versioned quality-gate policy. Rules are TYPED data (§38) —
// never code, never expressions evaluated at runtime.
model SecurityGatePolicy {
  id                     String   @id @default(uuid())
  workspaceId            String
  name                   String
  repositorySelector     Json     @default("{}") // { repositoryIds?: string[], providers?: string[] }
  branchSelector         Json     @default("{}") // { branches?: string[], patterns?: string[] }
  rules                  Json     @default("[]") // typed GateRule[] (§38)
  scannerFailureBehavior String   @default("FAIL_CLOSED") // FAIL_CLOSED | WARN | FAIL_OPEN (§39)
  version                Int      @default(1)
  createdBy              String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// One gate evaluation (§36/§21): the recorded verdict for a PR/MR
// assessment, pipeline run or scan. Rule results are stored so the
// verdict is explainable and auditable after the fact.
model SecurityGateEvaluation {
  id                      String   @id @default(uuid())
  workspaceId             String
  policyId                String?
  policyVersion           Int?
  context                 String // PR_ASSESSMENT | PIPELINE_RUN | SCAN
  pullRequestAssessmentId String?
  pipelineRunId           String?
  scanId                  String?
  result                  String // PASS | FAIL | WARN | ERROR | SKIPPED (§21)
  ruleResults             Json     @default("[]")
  summary                 Json     @default("{}") // counts only — no evidence, no secrets (§22/§42)
  evaluatedBy             String?
  createdAt               DateTime @default(now())

  @@index([workspaceId, context])
  @@index([pullRequestAssessmentId])
  @@index([pipelineRunId])
}

// §40/§41: a security baseline bound to an IMMUTABLE commit + snapshot
// + finding-fingerprint set — never to a mutable branch name.
model SecurityBaseline {
  id           String   @id @default(uuid())
  workspaceId  String
  repositoryId String // SourceRepository id
  commitSha    String
  snapshotId   String? // SourceSnapshot the baseline was captured from
  scanId       String?
  fingerprints Json     @default("[]") // canonical finding fingerprints present at baseline
  findingCount Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())

  @@unique([repositoryId, commitSha])
  @@index([workspaceId, repositoryId])
}

// §33: a CI/CD pipeline security run. Requested via a scoped API key
// or service account (§34/§35) — never an administrator credential.
model SecurityPipelineRun {
  id                   String    @id @default(uuid())
  workspaceId          String
  integrationId        String?
  provider             String // GITHUB | GITLAB | BITBUCKET | GENERIC_CI
  repositoryId         String? // SourceRepository id
  externalRepositoryId String?
  commitSha            String
  branch               String? // sanitized (§115)
  prNumber             Int?
  externalPipelineId   String
  scanIds              Json      @default("[]")
  gateResult           String? // PASS | FAIL | WARN | ERROR | SKIPPED
  gateEvaluationId     String?
  status               String    @default("REQUESTED") // REQUESTED | RUNNING | COMPLETED | FAILED | BLOCKED
  blockReason          String?
  requestedByKind      String // API_KEY | SERVICE_ACCOUNT | USER
  requestedById        String
  summary              Json      @default("{}") // sanitized summary (§32/§42): ids + counts + redacted locations only
  startedAt            DateTime  @default(now())
  completedAt          DateTime?

  @@unique([workspaceId, provider, externalPipelineId])
  @@index([workspaceId, repositoryId])
  @@index([workspaceId, status])
}

// §47: workspace finding-routing → Jira project/issue-type mapping.
model JiraProjectMapping {
  id            String   @id @default(uuid())
  workspaceId   String
  integrationId String
  findingType   String? // vulnClass / sourceDomain selector; null = default mapping
  team          String?
  assetGroup    String?
  projectKey    String
  issueType     String   @default("Task")
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId, integrationId])
}

// §48: a finding's external remediation ticket. One ticket per
// (finding, integration) — creation is idempotent (§49/§124).
model RemediationTicket {
  id                 String    @id @default(uuid())
  workspaceId        String
  findingId          String
  integrationId      String
  externalId         String?
  externalKey        String? // e.g. SEC-123
  externalUrl        String?
  status             String    @default("OPEN") // mapped internal status: OPEN | IN_PROGRESS | RESOLVED | CLOSED (§51)
  externalStatus     String? // raw provider status (data, never trusted for lifecycle)
  assigneeReference  String?
  syncState          String    @default("IN_SYNC") // IN_SYNC | PENDING | CONFLICT | NOT_CONFIGURED
  lastSyncedStatus   String? // status at last successful sync (conflict baseline, §53)
  lastSyncedAssignee String?
  createdBy          String
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([integrationId, findingId])
  @@index([workspaceId, findingId])
  @@index([workspaceId, status])
}

// §54: a ticket sync conflict. Conflicts are surfaced for an analyst
// decision — the platform NEVER silently overwrites either side (§53).
model TicketSyncConflict {
  id            String    @id @default(uuid())
  workspaceId   String
  ticketId      String
  findingId     String?
  field         String // status | assignee
  localValue    String?
  externalValue String?
  status        String    @default("OPEN") // OPEN | RESOLVED_KEEP_LOCAL | RESOLVED_TAKE_EXTERNAL
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([ticketId])
}

// §74: outbound webhook subscription. The signing secret is a
// REFERENCE (§71) — the value never appears in this table.
model WebhookSubscription {
  id              String   @id @default(uuid())
  workspaceId     String
  endpoint        String
  events          Json     @default("[]") // subscribed event types (§73)
  secretReference String?
  enabled         Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// §76–§78: transactional outbox row. The business change and this
// event commit in the SAME database transaction; the outbox processor
// delivers at-least-once with idempotent consumers (§79/§131).
model SecurityEventOutbox {
  id                String    @id @default(uuid())
  workspaceId       String
  eventId           String    @unique // stable envelope id (§67/§76)
  eventType         String
  resourceType      String
  resourceId        String
  schemaVersion     String    @default("1.0") // §77
  payload           Json      @default("{}") // sanitized envelope payload — no secrets (§64)
  status            String    @default("PENDING") // PENDING | DELIVERED | DEAD_LETTER
  attempts          Int       @default(0)
  nextAttemptAt     DateTime?
  lastErrorCategory String?
  createdAt         DateTime  @default(now())
  deliveredAt       DateTime?

  @@index([workspaceId, status])
  @@index([status, nextAttemptAt])
}

// §80: one delivery attempt of an outbox event to one destination
// (integration or webhook subscription). Response metadata records
// status codes/categories ONLY — never response secrets (§80).
model IntegrationDelivery {
  id               String    @id @default(uuid())
  workspaceId      String
  outboxId         String?
  eventId          String
  integrationId    String?
  subscriptionId   String?
  destinationKind  String // WEBHOOK | SIEM | SLACK | TEAMS | JIRA
  attempt          Int       @default(1)
  status           String    @default("PENDING") // PENDING | DELIVERED | FAILED | DEAD_LETTER | NOT_CONFIGURED | SKIPPED
  responseMetadata Json      @default("{}") // { httpStatus?, category?, durationMs? } — no bodies, no secrets
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([workspaceId, status])
  @@index([eventId])
  @@index([integrationId])
}

// §81: an inbound provider webhook delivery. Recorded for EVERY
// delivery — including rejected ones — with signature status; the
// payload itself is NOT stored (summary metadata only, §82/§83).
model InboundIntegrationEvent {
  id               String   @id @default(uuid())
  workspaceId      String?
  integrationId    String?
  provider         String // GITHUB | GITLAB | BITBUCKET
  deliveryId       String
  eventType        String
  signatureStatus  String // VALID | INVALID | MISSING
  processingStatus String   @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED_DUPLICATE | REJECTED | BLOCKED | ERROR
  detail           String? // reason code / summary — never payload content
  receivedAt       DateTime @default(now())

  @@unique([integrationId, deliveryId])
  @@index([workspaceId, provider])
  @@index([processingStatus])
}

// §99: incremental-sync checkpoint per integration + resource kind.
model IntegrationSyncCheckpoint {
  id                String    @id @default(uuid())
  workspaceId       String
  integrationId     String
  resourceKind      String // REPOSITORIES | TICKETS | PULL_REQUESTS
  cursor            String?
  lastSyncedAt      DateTime?
  lastSuccessAt     DateTime?
  lastErrorCategory String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([integrationId, resourceKind])
  @@index([workspaceId])
}

// ------------------------------- Prompt 26: GRC Engine -------------------------------
// Governance, Risk & Compliance. DSRclone provides evidence, control
// monitoring, assessment support, risk tracking and audit preparation —
// it NEVER certifies (§143). A control/requirement without evidence is
// NOT_EVALUATED / NOT_ASSESSED, never compliant by default. Framework
// versions are immutable once published (§4); assessments stay tied to
// the exact framework version they were created against (§122).
// Status fields are Strings with the value sets documented per model
// (the platform's established convention, cf. RiskException).

// §6: hierarchical framework requirements (parent → children).
model ComplianceRequirement {
  id                  String              @id @default(uuid())
  frameworkId         String
  requirementId       String // e.g. A.8.5 | CC6.1 | 8.4 | PR.AA | IA-2
  parentRequirementId String?
  title               String
  description         String              @default("")
  category            String              @default("")
  level               Int                 @default(1)
  metadata            Json                @default("{}")
  framework           ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, requirementId])
  @@index([frameworkId])
}

// §7: DSRclone's internal normalized control library entry, per workspace
// (seeded from the SDK catalog; workspaces may add their own controls).
model SecurityControl {
  id                   String   @id @default(uuid())
  workspaceId          String
  code                 String
  title                String
  description          String   @default("")
  controlType          String // PREVENTIVE | DETECTIVE | CORRECTIVE | GOVERNANCE
  implementationType   String // TECHNICAL | ADMINISTRATIVE | PHYSICAL | HYBRID
  implementationStatus String   @default("NOT_IMPLEMENTED") // §14
  effectiveness        String   @default("NOT_TESTED") // §15
  catalogSource        Boolean  @default(false) // seeded from the SDK control library
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

// §13: control ownership (user / team / business unit).
model ControlOwner {
  id          String   @id @default(uuid())
  workspaceId String
  controlId   String
  ownerType   String // USER | TEAM | BUSINESS_UNIT
  ownerRef    String // user id or team/business-unit name
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([workspaceId, controlId])
}

// §10–§12: control ↔ requirement mapping (cross-framework, shared evidence).
model ControlFrameworkMapping {
  id            String   @id @default(uuid())
  workspaceId   String
  controlId     String
  requirementId String // ComplianceRequirement.id
  mappingType   String // DIRECT | PARTIAL | SUPPORTING (§11)
  coverage      Float    @default(0) // 0..1
  notes         String   @default("")
  source        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, controlId, requirementId])
  @@index([workspaceId, requirementId])
  @@index([workspaceId, controlId])
}

// §16–§18: a test definition for a control.
model ControlTest {
  id                   String   @id @default(uuid())
  workspaceId          String
  controlId            String
  name                 String
  method               String // AUTOMATED | MANUAL | HYBRID
  automationLevel      String // FULL | PARTIAL | NONE
  frequency            String   @default("CONTINUOUS")
  expectedResult       String   @default("")
  evidenceRequirements String   @default("")
  ownerRef             String?
  signalKeys           Json     @default("[]") // technical signal keys evaluated (§29)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId, controlId])
}

// §29: an observed security-state signal feeding control evaluation.
model ControlSignal {
  id           String   @id @default(uuid())
  workspaceId  String
  controlId    String
  signalKey    String
  state        String? // PASS | FAIL | PARTIAL | null (unknown)
  detail       String   @default("")
  evidenceRefs Json     @default("[]")
  sourceType   String   @default("")
  observedAt   DateTime @default(now())

  @@index([workspaceId, controlId, signalKey])
  @@index([workspaceId, observedAt])
}

// §30–§32: the recorded result of evaluating a control at a point in time.
model ControlEvaluation {
  id            String   @id @default(uuid())
  workspaceId   String
  controlId     String
  result        String // PASS | FAIL | PARTIAL | INCONCLUSIVE | NOT_APPLICABLE
  confidence    String // LOW | MEDIUM | HIGH
  effectiveness String   @default("NOT_TESTED")
  reason        String   @default("")
  evidenceRefs  Json     @default("[]")
  evaluatedBy   String   @default("SYSTEM") // SYSTEM | user id
  evaluatedAt   DateTime @default(now())

  @@index([workspaceId, controlId])
  @@index([workspaceId, evaluatedAt])
}

// §20–§24: snapshot-based, hashed compliance evidence. Immutable once
// referenced by an issued assessment (§21) — the service never updates
// snapshot/hash after creation; freshness is derived, not stored (§25).
model ComplianceEvidence {
  id             String    @id @default(uuid())
  workspaceId    String
  controlId      String
  sourceType     String // §19 source types | MANUAL_UPLOAD
  sourceId       String
  snapshot       Json      @default("{}")
  classification String    @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  status         String    @default("CURRENT") // CURRENT | STALE | EXPIRED | INVALID | SUPERSEDED (freshness derived at read)
  hash           String
  filename       String? // sanitized manual-upload filename (§40)
  mimeType       String?
  sizeBytes      Int?
  collectedAt    DateTime  @default(now())
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  createdBy      String
  reviewStatus   String    @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | APPROVED | REJECTED | CHANGES_REQUESTED (§38)
  reviewedBy     String?
  reviewNotes    String?

  @@index([workspaceId, controlId])
  @@index([workspaceId, status])
  @@index([workspaceId, collectedAt])
}

// §25: per-control evidence freshness policy (never one global duration).
model EvidenceFreshnessPolicy {
  id              String   @id @default(uuid())
  workspaceId     String
  controlId       String
  staleAfterDays  Int
  expireAfterDays Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, controlId])
  @@index([workspaceId])
}

// §33–§35: a compliance assessment pinned to an exact framework version.
model ComplianceAssessment {
  id               String    @id @default(uuid())
  workspaceId      String
  frameworkId      String
  frameworkKey     String
  frameworkVersion String // denormalized pin — never follows later imports (§122)
  name             String
  scope            Json      @default("{}") // §35 scope descriptor
  periodStart      DateTime?
  periodEnd        DateTime?
  status           String    @default("PLANNED") // PLANNED | IN_PROGRESS | READY_FOR_REVIEW | COMPLETED | ARCHIVED
  ownerId          String
  reviewerId       String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, frameworkId])
  @@index([workspaceId, status])
}

// §36/§37: per-requirement result inside an assessment, computed from
// mapped controls + evidence at completion time (snapshot semantics).
model AssessmentRequirementResult {
  id            String   @id @default(uuid())
  workspaceId   String
  assessmentId  String
  requirementId String // ComplianceRequirement.id
  result        String // COMPLIANT | PARTIALLY_COMPLIANT | NON_COMPLIANT | NOT_APPLICABLE | NOT_ASSESSED
  controlIds    Json     @default("[]")
  evidenceIds   Json     @default("[]")
  exceptionIds  Json     @default("[]")
  notes         String   @default("")
  reviewStatus  String   @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED
  reviewedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([assessmentId, requirementId])
  @@index([workspaceId, assessmentId])
}

// §95: continuous-compliance drift events.
model ComplianceDriftEvent {
  id             String   @id @default(uuid())
  workspaceId    String
  controlId      String?
  type           String // CONTROL_FAILED | CONTROL_RECOVERED | EVIDENCE_STALE | EVIDENCE_EXPIRED | NEW_GAP | RISK_INCREASED
  detail         String   @default("")
  previousResult String?
  newResult      String?
  createdAt      DateTime @default(now())

  @@index([workspaceId, controlId])
  @@index([workspaceId, createdAt])
}

// §104/§105: control-test schedule — SAFE/READ-ONLY re-evaluations only,
// materialized through the existing scheduler infrastructure.
model ControlTestSchedule {
  id          String    @id @default(uuid())
  workspaceId String
  controlId   String
  cron        String
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, controlId])
}

// §42: the risk register (one per workspace, created on demand).
model RiskRegister {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  name        String   @default("Risk Register")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// §47: organization-configurable risk matrix (within platform bounds).
model RiskMatrix {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  config      Json     @default("{}") // bands + effectiveness multipliers (SDK-validated)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// §43/§48–§50: a risk record. Inherent risk is stored at assessment
// time; residual risk stays NULL until control effectiveness is known
// (§49 — never an invented exact number).
model RiskRecord {
  id            String    @id @default(uuid())
  workspaceId   String
  registerId    String
  title         String
  description   String    @default("")
  category      String    @default("SECURITY")
  source        String // TECHNICAL_FINDING | CONTROL_FAILURE | AUDIT_FINDING | MANUAL | VENDOR | BUSINESS
  sourceRef     String? // finding id / control id / audit finding id / vendor id
  likelihood    Int
  impacts       Json      @default("{}") // dimension → 1..5 (§46)
  inherentScore Int
  inherentBand  String // LOW | MEDIUM | HIGH | CRITICAL
  residualScore Int?
  residualBand  String?
  residualBasis String    @default("")
  ownerId       String
  status        String    @default("IDENTIFIED") // §50 lifecycle
  treatment     String? // MITIGATE | AVOID | TRANSFER | ACCEPT
  reviewDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
}

// §53: risk ↔ finding / asset / control / requirement links.
model RiskLink {
  id          String   @id @default(uuid())
  workspaceId String
  riskId      String
  linkType    String // FINDING | ASSET | CONTROL | REQUIREMENT
  linkId      String
  createdAt   DateTime @default(now())

  @@unique([riskId, linkType, linkId])
  @@index([workspaceId, riskId])
}

// §51/§52: treatment plan + tracked actions.
model RiskTreatmentPlan {
  id          String   @id @default(uuid())
  workspaceId String
  riskId      String
  strategy    String // MITIGATE | AVOID | TRANSFER | ACCEPT
  description String   @default("")
  status      String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, riskId])
}

model RiskTreatmentAction {
  id               String    @id @default(uuid())
  workspaceId      String
  planId           String
  action           String
  ownerId          String
  dueDate          DateTime?
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | OVERDUE
  relatedFindingId String?
  relatedControlId String?
  ticketRef        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, planId])
  @@index([workspaceId, status])
}

// §55–§59: risk acceptance — extends the RiskException pattern to
// register risks. Approval workflow with SoD (§57); expiry returns the
// risk to review (§59) via RiskAcceptanceExpiry bookkeeping here.
model RiskAcceptance {
  id                   String   @id @default(uuid())
  workspaceId          String
  riskId               String
  requestedBy          String
  approvedBy           String?
  reason               String
  scope                Json     @default("{}")
  compensatingControls Json     @default("[]")
  status               String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | EXPIRED
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId, riskId])
  @@index([workspaceId, status])
  @@index([expiresAt])
}

// §58: recurring risk reviews.
model RiskReview {
  id           String    @id @default(uuid())
  workspaceId  String
  riskId       String
  reviewerId   String
  decision     String // CONFIRMED | CHANGED | ESCALATED | CLOSED
  changes      String    @default("")
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, riskId])
}

// §60–§63: governance policy library. Issued versions immutable (§62) —
// a new version is a new row; status transitions never rewrite content.
model GovernancePolicy {
  id             String    @id @default(uuid())
  workspaceId    String
  title          String
  ownerId        String
  version        String
  status         String    @default("DRAFT") // DRAFT | REVIEW | APPROVED | ACTIVE | RETIRED
  effectiveDate  DateTime?
  reviewDate     DateTime?
  classification String    @default("INTERNAL")
  documentRef    String    @default("") // reference only — never document content with secrets
  contentHash    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, title, version])
  @@index([workspaceId, status])
}

model PolicyAcknowledgement {
  id             String   @id @default(uuid())
  workspaceId    String
  policyId       String
  userId         String
  acknowledgedAt DateTime @default(now())

  @@unique([policyId, userId])
  @@index([workspaceId, userId])
}

// §64–§66: audit engagements.
model AuditEngagement {
  id           String    @id @default(uuid())
  workspaceId  String
  frameworkId  String?
  assessmentId String?
  type         String // INTERNAL | EXTERNAL | READINESS | CUSTOMER | REGULATORY
  auditorRef   String    @default("") // auditor/reviewer reference — a name/label, not credentials
  scope        Json      @default("{}")
  periodStart  DateTime?
  periodEnd    DateTime?
  status       String    @default("PLANNED") // PLANNED | IN_PROGRESS | EVIDENCE_COLLECTION | REVIEW | COMPLETED | ARCHIVED
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, status])
}

// §67/§68: evidence requests inside an engagement.
model AuditEvidenceRequest {
  id            String    @id @default(uuid())
  workspaceId   String
  auditId       String
  controlId     String?
  requirementId String?
  title         String
  ownerId       String
  dueDate       DateTime?
  status        String    @default("OPEN") // OPEN | IN_PROGRESS | SUBMITTED | ACCEPTED | REJECTED | OVERDUE
  evidenceIds   Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, auditId])
  @@index([workspaceId, status])
}

// §69/§70: audit findings — deliberately SEPARATE from technical
// canonical Findings; links are references, never merges.
model AuditFinding {
  id               String    @id @default(uuid())
  workspaceId      String
  auditId          String
  title            String
  description      String    @default("")
  severity         String    @default("MEDIUM")
  requirementId    String?
  ownerId          String
  dueDate          DateTime?
  status           String    @default("OPEN") // OPEN | IN_REMEDIATION | RESOLVED | CLOSED
  remediation      String    @default("")
  linkedFindingIds Json      @default("[]") // technical Finding ids (§70)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, auditId])
  @@index([workspaceId, status])
}

// §71–§73: an issued audit evidence package — immutable manifest with
// per-file hashes; content is the redacted snapshot bundle (§73).
model AuditEvidencePackage {
  id               String    @id @default(uuid())
  workspaceId      String
  auditId          String
  assessmentId     String
  frameworkKey     String
  frameworkVersion String
  classification   String    @default("CONFIDENTIAL")
  manifest         Json      @default("{}") // AuditPackageManifest (SDK)
  manifestHash     String
  bundle           Json      @default("{}") // path → redacted content (integrity-verifiable)
  generatedBy      String
  generatedAt      DateTime  @default(now())
  downloadCount    Int       @default(0)
  lastDownloadAt   DateTime?

  @@index([workspaceId, auditId])
}

// §74/§75: restricted, time-limited auditor access to explicitly
// shared assessments/evidence only. Expiry revokes automatically —
// the service checks expiresAt on every access.
model AuditorAccessGrant {
  id            String    @id @default(uuid())
  workspaceId   String
  userId        String // the auditor's platform user (external label in metadata)
  assessmentIds Json      @default("[]")
  evidenceIds   Json      @default("[]")
  grantedBy     String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceId, userId])
  @@index([expiresAt])
}

// §84–§87: finding ↔ control links (automatic suggestions + analyst
// overrides, both preserved).
model FindingControlLink {
  id          String   @id @default(uuid())
  workspaceId String
  findingId   String
  controlId   String
  confidence  String // HIGH | MEDIUM | LOW
  origin      String   @default("AUTOMATIC") // AUTOMATIC | ANALYST_OVERRIDE
  ruleId      String?
  rationale   String   @default("")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, findingId])
  @@index([workspaceId, controlId])
}

// §106–§108: vendor risk foundation.
model ThirdPartyVendor {
  id                 String    @id @default(uuid())
  workspaceId        String
  name               String
  ownerId            String
  criticality        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  serviceDescription String    @default("")
  status             String    @default("ACTIVE") // ACTIVE | UNDER_REVIEW | OFFBOARDED
  reviewDate         DateTime?
  riskRating         String? // LOW | MEDIUM | HIGH | CRITICAL | null (not yet assessed)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId, status])
}

model VendorRiskAssessment {
  id          String   @id @default(uuid())
  workspaceId String
  vendorId    String
  method      String   @default("QUESTIONNAIRE") // QUESTIONNAIRE | MANUAL_EVIDENCE | INTEGRATION
  riskRating  String // LOW | MEDIUM | HIGH | CRITICAL
  findings    String   @default("")
  treatment   String   @default("")
  evidenceIds Json     @default("[]")
  assessedBy  String
  assessedAt  DateTime @default(now())

  @@index([workspaceId, vendorId])
}

// §114/§115: issued GRC reports are immutable snapshots (content +
// hash), rendered through the platform redaction discipline.
model GrcReportSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  reportType  String // COMPLIANCE_ASSESSMENT | CONTROL_EFFECTIVENESS | RISK_REGISTER | RISK_TREATMENT | AUDIT_READINESS | EVIDENCE_FRESHNESS | EXECUTIVE_GRC
  title       String
  content     Json     @default("{}")
  contentHash String
  generatedBy String
  createdAt   DateTime @default(now())

  @@index([workspaceId, reportType])
  @@index([workspaceId, createdAt])
}

// §118: GRC data-retention configuration per workspace.
model GrcRetentionPolicy {
  id                      String   @id @default(uuid())
  workspaceId             String   @unique
  assessmentRetentionDays Int      @default(2555)
  evidenceRetentionDays   Int      @default(2555)
  packageRetentionDays    Int      @default(2555)
  riskRetentionDays       Int      @default(2555)
  auditRetentionDays      Int      @default(2555)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ------------------------------- Prompt 27: Security Data Lake, Advanced Analytics & Enterprise Search -------------------------------

// §4: canonical analytics event — the append-only historical record of
// the lake. Events are NEVER rewritten when current state changes (§7);
// corrections arrive as new events. eventId is the stable idempotency
// key (§9): a duplicate delivery updates nothing. Tenant context
// (organizationId + workspaceId) is validated before landing (§12) and
// every query is scoped by it — analytics is never an authorization
// bypass. Attributes hold references/summaries only (§13): large raw
// artifacts stay in object storage.
model SecurityAnalyticsEvent {
  id             String   @id @default(uuid())
  eventId        String   @unique // stable producer id (§9)
  organizationId String
  workspaceId    String
  eventType      String // §5 catalog (ASSET_DISCOVERED | FINDING_CREATED | ...)
  eventTime      DateTime // when it happened (producer clock) — timelines sort by this (§132)
  ingestedAt     DateTime @default(now())
  sourceType     String // OUTBOX | FINDING_HISTORY | POSTURE_SNAPSHOT | MANUAL_SYNC | FIXTURE
  sourceId       String? // originating record id (outbox row / history row / snapshot id)
  resourceType   String // ASSET | FINDING | SCAN | CONTROL | RISK | REPOSITORY | IDENTITY | TICKET | PLATFORM
  resourceId     String
  assetId        String?
  findingId      String?
  scanId         String?
  severity       String? // CRITICAL | HIGH | MEDIUM | LOW | INFO (as recorded at event time)
  priority       String? // P0..P4
  riskScore      Float?
  classification String   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  schemaVersion  String   @default("1.0") // §6 controlled evolution
  attributes     Json     @default("{}") // bounded summary attributes — no secrets (§111)
  checksum       String // sha256 over the canonical event body (lineage, §8)

  @@index([organizationId, workspaceId])
  @@index([workspaceId, eventTime])
  @@index([workspaceId, eventType])
  @@index([workspaceId, assetId])
  @@index([workspaceId, findingId])
  @@index([workspaceId, severity])
  @@index([workspaceId, riskScore])
  @@index([workspaceId, classification])
}

// §10: per-consumer ingestion checkpoint. Partition = source stream
// (e.g. OUTBOX, FINDING_HISTORY). lastEventKey is the cursor of the
// last successfully landed source record; status surfaces lag (§118).
model AnalyticsIngestionCheckpoint {
  id           String    @id @default(uuid())
  workspaceId  String
  consumer     String // ANALYTICS_INGESTION
  partition    String // OUTBOX | FINDING_HISTORY | POSTURE_SNAPSHOT
  lastEventKey String? // source cursor (createdAt|id composite or history id)
  lastEventAt  DateTime?
  status       String    @default("IDLE") // IDLE | RUNNING | STALLED | ERROR
  processed    Int       @default(0)
  rejected     Int       @default(0)
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@unique([workspaceId, consumer, partition])
  @@index([workspaceId, status])
}

// §11: bounded dead-letter for invalid/unprocessable analytics events.
// Poison records are quarantined WITH their validation errors — never
// silently dropped, never blocking the stream.
model AnalyticsDeadLetterEvent {
  id          String    @id @default(uuid())
  workspaceId String?
  eventId     String?
  sourceType  String
  rawSummary  Json      @default("{}") // sanitized summary of the rejected envelope — no secrets
  errors      Json      @default("[]") // validation error codes (§12)
  status      String    @default("QUARANTINED") // QUARANTINED | REPLAYED | DISCARDED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([workspaceId, status])
  @@index([createdAt])
}

// §21: enterprise-search document. searchableText is built ONLY from
// redacted summaries (§112) — secrets never reach the index (§130).
// Classification is enforced BEFORE retrieval: a search executes with
// the caller's tenant + classification ceiling (§23/§24), it never
// retrieves globally and filters afterwards.
model SecuritySearchDocument {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String
  documentType   String // ASSET | FINDING | SCAN | REPORT | REPOSITORY | CONTROL | RISK | AUDIT | TICKET | SECURITY_EVENT
  resourceId     String
  title          String // escaped at render; stored as data (§129)
  summary        String   @default("")
  searchableText String // redacted, lowercased token text
  facets         Json     @default("{}") // severity/status/cwe/cve/technology/kev/exposure/... (§30)
  classification String   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  riskScore      Float?
  severity       String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([workspaceId, documentType, resourceId])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, documentType])
  @@index([workspaceId, classification])
  @@index([workspaceId, severity])
}

// §32: saved enterprise query. The query is stored as DSL TEXT plus its
// parsed AST — re-validated on every execution, never trusted blind.
model SavedSecurityQuery {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  name        String
  queryText   String // SecurityQueryDSL source (§34)
  filters     Json     @default("{}")
  visibility  String   @default("PRIVATE") // PRIVATE | WORKSPACE (§33)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, userId])
  @@index([workspaceId, visibility])
}

// §41: point-in-time asset security projection (analytics-optimized;
// the operational Asset row stays authoritative, §3).
model AssetSecuritySnapshot {
  id            String   @id @default(uuid())
  workspaceId   String
  assetId       String
  capturedAt    DateTime @default(now())
  exposure      String   @default("UNKNOWN") // INTERNET_FACING | INTERNAL | UNKNOWN
  criticality   String   @default("UNSPECIFIED")
  technologies  Json     @default("[]") // [{name, version}]
  services      Json     @default("[]") // [{port, protocol, name}]
  findingCounts Json     @default("{}") // severity → count (open only)
  riskScore     Float?
  postureState  String   @default("UNKNOWN")
  stateHash     String

  @@index([workspaceId, assetId, capturedAt])
  @@index([workspaceId, capturedAt])
}

// §43: finding lifecycle projection — derived deterministically from
// the analytics event history, so a replay/rebuild reproduces it
// exactly (§133). Timestamps are eventTime-based (§132).
model FindingLifecycleProjection {
  id                 String    @id @default(uuid())
  workspaceId        String
  findingId          String
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  triagedAt          DateTime?
  verifiedAt         DateTime?
  resolvedAt         DateTime?
  reopenedAt         DateTime?
  regressionCount    Int       @default(0) // resolve → reappear cycles (§48)
  remediationSeconds Int? // firstSeen → first resolution (MTTR input, §44)
  currentStatus      String    @default("OPEN")
  severity           String?
  cwe                String?
  cve                String?
  assetId            String?
  repositoryId       String?
  rebuiltAt          DateTime  @default(now())

  @@unique([workspaceId, findingId])
  @@index([workspaceId, currentStatus])
  @@index([workspaceId, severity])
}

// §50: risk history projection — risk score/priority/KEV/verification
// over time. Historical context is never overwritten by later EPSS
// updates (§65); each point is a recorded observation.
model RiskHistoryProjection {
  id                String   @id @default(uuid())
  workspaceId       String
  findingId         String?
  assetId           String?
  recordedAt        DateTime
  riskScore         Float?
  priority          String?
  kevListed         Boolean  @default(false)
  epssScore         Float?
  verificationState String?
  criticality       String?
  sourceEventId     String?

  @@index([workspaceId, recordedAt])
  @@index([workspaceId, findingId, recordedAt])
  @@index([workspaceId, assetId, recordedAt])
}

// §52: attack-surface exposure snapshot (one row per capture run).
model ExposureSnapshot {
  id                   String   @id @default(uuid())
  workspaceId          String
  capturedAt           DateTime @default(now())
  internetFacingAssets Int      @default(0)
  totalAssets          Int      @default(0)
  openServices         Int      @default(0)
  newServices          Int      @default(0)
  removedServices      Int      @default(0)
  highRiskTechnologies Int      @default(0)
  criticalFindings     Int      @default(0)
  kevFindings          Int      @default(0)
  unknownAssets        Int      @default(0)
  contentHash          String

  @@index([workspaceId, capturedAt])
}

// §55: shadow-asset SIGNAL — controlled evidence that an asset may be
// unowned/unexpected. A signal is never a maliciousness verdict.
model ShadowAssetSignal {
  id          String   @id @default(uuid())
  workspaceId String
  assetId     String?
  host        String
  signalType  String // UNEXPECTED_SUBDOMAIN | UNKNOWN_PUBLIC_HOST | UNOWNED_CLOUD_ASSET | UNMAPPED_SERVICE
  evidence    Json     @default("{}")
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | DISMISSED
  detectedAt  DateTime @default(now())

  @@index([workspaceId, status])
  @@index([workspaceId, detectedAt])
}

// §74: correlation rule — typed declarative conditions ONLY (§75).
// Conditions are data evaluated by the engine; a rule can never carry
// executable code (§148).
model CorrelationRule {
  id          String   @id @default(uuid())
  workspaceId String? // null = platform built-in rule
  name        String
  description String   @default("")
  inputTypes  Json     @default("[]") // resource types the rule reads
  conditions  Json     @default("[]") // [{field, op, value}] typed conditions
  severity    String   @default("MEDIUM")
  outputType  String // INTERNET_EXPOSED_KEV | CRITICAL_ASSET_CRITICAL_FINDING | ...
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, enabled])
}

// §76: correlation signal. Dedup by stable fingerprint (§78): repeated
// matches update the SAME row's lifecycle instead of spamming (§79).
// Signals may raise CONTEXTUAL risk / propose GRC risk candidates —
// they never overwrite canonical finding severity (§80).
model SecurityCorrelationSignal {
  id              String   @id @default(uuid())
  workspaceId     String
  ruleId          String?
  signalType      String
  fingerprint     String // workspace-scoped stable dedup key
  severity        String   @default("MEDIUM")
  confidence      String   @default("LOW") // LOW | MEDIUM | HIGH — evidence completeness (§77)
  status          String   @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | SUPPRESSED (§79)
  assetId         String?
  findingId       String?
  resourceType    String?
  resourceId      String?
  evidence        Json     @default("{}") // observed evidence references (§86 analogue)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  occurrenceCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status])
  @@index([workspaceId, signalType])
}

// §83: attack-path CANDIDATE — analytical correlation over known
// graph relationships + findings. It is never an exploitation plan
// (§148); every edge references observed evidence (§86) and snapshots
// are preserved so appearance/removal can be answered historically
// (§87).
model AttackPathCandidate {
  id          String   @id @default(uuid())
  workspaceId String
  fingerprint String
  title       String
  score       Float // §85: exposure/criticality/finding risk/verification/length/confidence
  confidence  String   @default("LOW")
  status      String   @default("ACTIVE") // ACTIVE | REMOVED
  nodes       Json     @default("[]") // [{kind, id, label}]
  edges       Json     @default("[]") // [{from, to, evidenceType, evidenceId}]
  assetId     String?
  findingId   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status])
  @@index([workspaceId, score])
}

// §113: analytics retention policy — by event type / classification /
// workspace. Retention NEVER destroys required audit/evidence records
// (§114/§148): only lake-owned projections and events are eligible.
model AnalyticsRetentionPolicy {
  id                           String   @id @default(uuid())
  workspaceId                  String   @unique
  eventRetentionDays           Int      @default(730)
  searchDocRetentionDays       Int      @default(730)
  snapshotRetentionDays        Int      @default(365)
  restrictedEventRetentionDays Int      @default(365)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// §115: controlled search reindex job. Reindex preserves tenant
// boundaries, classification and redaction (§116) — it rebuilds
// documents from operational records through the same indexing path.
model SecuritySearchReindexJob {
  id           String    @id @default(uuid())
  workspaceId  String
  documentType String? // null = all types
  status       String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  indexedCount Int       @default(0)
  requestedBy  String
  startedAt    DateTime?
  completedAt  DateTime?
  errorSummary String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, status])
}

// Scheduled/persisted analytics snapshot (§88 dashboards + brief):
// a deterministic capture of one analytics view at a point in time,
// content-hashed like every other platform snapshot.
model AnalyticsDashboardSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  view        String // OVERVIEW | FINDINGS | ASSETS | ATTACK_SURFACE | RISK | DEVSECOPS | CLOUD | IDENTITY | GRC
  capturedAt  DateTime @default(now())
  source      String   @default("MANUAL") // MANUAL | SCHEDULED
  content     Json     @default("{}")
  contentHash String
  generatedBy String?

  @@index([workspaceId, view, capturedAt])
}

// ------------------------------- SOC, SIEM, Threat Intelligence & Incident Response (Prompt 28) -------------------------------
// Defensive operations only (§161): telemetry → detection → alerts →
// incidents → APPROVED predefined response. No model here can hold a
// command, script or arbitrary action definition; response actions
// reference the closed SDK catalog by key.

// §8/§115: a registered telemetry source. authReference is a secret
// REFERENCE name only (§59) — credential material never lands here.
model SocTelemetrySource {
  id                      String    @id @default(uuid())
  organizationId          String
  workspaceId             String
  name                    String
  sourceCategory          String // TELEMETRY_SOURCE_CATEGORIES (SDK soc/types)
  authReference           String? // secret reference name, never a value
  expectedIntervalSeconds Int? // null = no gap expectation (§116)
  enabled                 Boolean   @default(true)
  lastEventAt             DateTime?
  lastIngestedAt          DateTime?
  eventsIngested          Int       @default(0)
  parseFailures           Int       @default(0)
  authFailures            Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
}

// §3: canonical telemetry event. The raw body stays in approved
// storage behind rawReference (§6); attributes are secret-scrubbed at
// ingestion (§157). contentHash is the §7 integrity anchor —
// historical evidence is verified against it (§143).
model SecurityTelemetryEvent {
  id                String   @id @default(uuid())
  organizationId    String
  workspaceId       String
  eventTime         DateTime
  ingestedAt        DateTime @default(now())
  source            String
  sourceCategory    String
  eventCategory     String
  eventAction       String
  assetId           String?
  identityReference String?
  severity          String // CRITICAL | HIGH | MEDIUM | LOW | INFO
  classification    String   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  attributes        Json     @default("{}")
  rawReference      String?
  schemaVersion     String   @default("1.0")
  fingerprint       String // §11 idempotency identity (provider id or stable hash)
  contentHash       String

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, eventTime])
  @@index([workspaceId, eventCategory, eventAction])
  @@index([workspaceId, assetId])
  @@index([workspaceId, identityReference])
  @@index([workspaceId, source])
}

// §14: detection rule. The rule row carries lifecycle; the actual
// definitions live in immutable versions (§16).
model DetectionRule {
  id                 String    @id @default(uuid())
  organizationId     String
  workspaceId        String? // null = global template (§14)
  templateKey        String?
  name               String
  description        String    @default("")
  category           String
  severity           String // CRITICAL | HIGH | MEDIUM | LOW | INFO
  status             String    @default("DRAFT") // DRAFT | TESTING | ACTIVE | DISABLED | DEPRECATED
  currentVersion     Int       @default(0)
  attackMappings     Json      @default("[]") // §26 ATT&CK context only
  dataSources        Json      @default("[]")
  matchCount         Int       @default(0)
  lastMatchedAt      DateTime?
  lastEvaluatedAt    DateTime?
  evaluationFailures Int       @default(0)
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, category])
}

// §16: published rule versions are immutable — editing an active rule
// creates a new version; matches forever cite the version they ran.
model DetectionRuleVersion {
  id         String   @id @default(uuid())
  ruleId     String
  version    Int
  definition Json // DetectionRuleDefinition (SDK soc/dsl) — declarative only
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([ruleId, version])
  @@index([ruleId])
}

// §28: one detection match. Event references are telemetry row ids.
model DetectionMatch {
  id                String   @id @default(uuid())
  organizationId    String
  workspaceId       String
  ruleId            String
  ruleVersion       Int
  eventIds          Json     @default("[]")
  matchedAt         DateTime @default(now())
  severity          String
  confidence        String // LOW | MEDIUM | HIGH (§29)
  reason            String
  assetId           String?
  identityReference String?
  indicatorId       String?
  groupKey          String?
  alertId           String?

  @@index([workspaceId, ruleId, matchedAt])
  @@index([workspaceId, alertId])
}

// §30: security alert. fingerprint dedupes equivalent detections
// into one lifecycle (§32); occurrenceCount grows instead of storms.
model SecurityAlert {
  id                String    @id @default(uuid())
  organizationId    String
  workspaceId       String
  fingerprint       String
  title             String
  description       String    @default("")
  severity          String
  priority          String // P1 | P2 | P3 | P4 (§35)
  priorityScore     Int       @default(0)
  priorityFactors   Json      @default("{}")
  status            String    @default("NEW") // §31 lifecycle
  source            String // DETECTION | CORRELATION | INDICATOR_MATCH | MANUAL
  ruleId            String?
  assetId           String?
  identityReference String?
  indicatorId       String?
  findingId         String?
  ownerId           String?
  firstSeen         DateTime  @default(now())
  lastSeen          DateTime  @default(now())
  occurrenceCount   Int       @default(1)
  acknowledgedAt    DateTime?
  containedAt       DateTime?
  resolvedAt        DateTime?
  slaBreached       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId, status, priority])
  @@index([workspaceId, fingerprint])
  @@index([workspaceId, assetId])
  @@index([workspaceId, ruleId])
}

// §36: an analyst triage decision on an alert.
model AlertTriage {
  id          String   @id @default(uuid())
  alertId     String
  workspaceId String
  analystId   String
  decision    String // TRUE_POSITIVE | FALSE_POSITIVE | BENIGN_EXPECTED | NEEDS_INVESTIGATION | DUPLICATE
  reason      String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([workspaceId, alertId])
}

// §39: scoped, expiring alert suppression. Broad permanent
// suppression does not exist in this model (§40): expiresAt required.
model AlertSuppressionRule {
  id                String   @id @default(uuid())
  organizationId    String
  workspaceId       String
  ruleId            String?
  assetId           String?
  identityReference String?
  reason            String
  createdBy         String
  approvedBy        String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([workspaceId, expiresAt])
}

// §41: security incident.
model SecurityIncident {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String
  title          String
  description    String    @default("")
  severity       String
  priority       String // P1..P4
  status         String    @default("DRAFT") // §42 lifecycle
  category       String    @default("GENERAL")
  commanderId    String?
  detectedAt     DateTime  @default(now())
  declaredAt     DateTime?
  containedAt    DateTime?
  recoveredAt    DateTime?
  closedAt       DateTime?
  businessImpact String    @default("")
  classification String    @default("INTERNAL")
  caseId         String? // originating InvestigationCase (§53)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, status, priority])
  @@index([workspaceId, detectedAt])
}

// §44: incident relationships — one generic, tenant-scoped link row
// per related record (alerts, events, assets, identities, findings,
// attack-path candidates, risks, controls, tickets, reports).
model IncidentLink {
  id           String   @id @default(uuid())
  incidentId   String
  workspaceId  String
  resourceType String // ALERT | EVENT | ASSET | IDENTITY | FINDING | ATTACK_PATH | RISK | CONTROL | TICKET | REPORT | INDICATOR
  resourceId   String
  createdBy    String?
  createdAt    DateTime @default(now())

  @@unique([incidentId, resourceType, resourceId])
  @@index([workspaceId, incidentId])
}

// §45: append-oriented incident timeline (§46). Corrections are new
// entries with amendsEntryId — history is never rewritten.
model IncidentTimelineEntry {
  id            String   @id @default(uuid())
  incidentId    String
  workspaceId   String
  entryType     String // §45 types
  summary       String
  detail        Json     @default("{}")
  actorId       String?
  amendsEntryId String?
  createdAt     DateTime @default(now())

  @@index([workspaceId, incidentId, createdAt])
}

// §47: incident evidence. Only references + hashes live here; the
// content stays in approved storage. No forensic-admissibility claim
// is made (§48) — this is a chain-of-custody FOUNDATION.
model IncidentEvidence {
  id              String   @id @default(uuid())
  incidentId      String
  workspaceId     String
  source          String // TELEMETRY_EVENT | FILE | REPORT | MANUAL
  classification  String   @default("CONFIDENTIAL")
  contentHash     String // §49 sha256 of the evidence content/reference body
  objectReference String // storage reference, never content
  description     String   @default("")
  relatedEventId  String?
  relatedAssetId  String?
  collectedAt     DateTime @default(now())
  collectedBy     String
  chainMetadata   Json     @default("{}") // collection context (§48)
  createdAt       DateTime @default(now())

  @@index([workspaceId, incidentId])
}

// §48: evidence access/transfer history (chain of custody log).
model IncidentEvidenceAccess {
  id          String   @id @default(uuid())
  evidenceId  String
  incidentId  String
  workspaceId String
  actorId     String
  action      String // VIEWED | VERIFIED | EXPORTED | TRANSFERRED
  result      String // ALLOWED | DENIED
  createdAt   DateTime @default(now())

  @@index([workspaceId, evidenceId, createdAt])
}

// §51: investigation case — may exist before/without an incident.
model InvestigationCase {
  id                  String   @id @default(uuid())
  organizationId      String
  workspaceId         String
  title               String
  description         String   @default("")
  status              String   @default("OPEN") // OPEN | INVESTIGATING | ESCALATED | CLOSED
  severity            String   @default("MEDIUM")
  ownerId             String?
  linkedAlertIds      Json     @default("[]")
  linkedEventIds      Json     @default("[]")
  escalatedIncidentId String?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([workspaceId, status])
}

// §58: threat intelligence source. authenticationReference is a
// secret REFERENCE name only (§59) — no provider credentials stored.
model ThreatIntelSource {
  id                      String   @id @default(uuid())
  organizationId          String
  workspaceId             String
  name                    String
  type                    String // STIX_TAXII | COMMERCIAL_FEED | PUBLIC_FEED | INTERNAL | FIXTURE
  trustLevel              Int      @default(50) // 0..100
  authenticationReference String?
  syncFrequencyMinutes    Int?
  enabled                 Boolean  @default(true)
  transportStatus         String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED — live transports unwired in this environment
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
}

// §56: threat indicator. Deduped per workspace+type+value (§62);
// multi-source provenance lives in IndicatorObservation.
model ThreatIndicator {
  id              String    @id @default(uuid())
  organizationId  String
  workspaceId     String
  type            String // IP | DOMAIN | URL | FILE_HASH | EMAIL_DOMAIN | CERTIFICATE_FINGERPRINT
  valueNormalized String
  confidence      Int       @default(0) // 0..100, deterministic policy (§63)
  severity        String    @default("MEDIUM")
  status          String    @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED | FALSE_POSITIVE
  firstSeen       DateTime  @default(now())
  lastSeen        DateTime  @default(now())
  validUntil      DateTime?
  tags            Json      @default("[]")
  references      Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, type, valueNormalized])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

// §54/§62: one source's observation of an indicator (provenance).
model IndicatorObservation {
  id          String   @id @default(uuid())
  indicatorId String
  sourceId    String
  workspaceId String
  observedAt  DateTime @default(now())
  confidence  Int?
  stixId      String?
  detail      Json     @default("{}")

  @@index([workspaceId, indicatorId])
  @@index([workspaceId, sourceId])
}

// §65: an indicator matched authorized platform telemetry.
model IndicatorMatch {
  id                String   @id @default(uuid())
  organizationId    String
  workspaceId       String
  indicatorId       String
  telemetryEventId  String?
  assetId           String?
  identityReference String?
  matchedAt         DateTime @default(now())
  confidence        Int // the indicator's confidence at match time
  context           Json     @default("{}") // provenance: source names/trust (§138)

  @@index([workspaceId, indicatorId, matchedAt])
  @@index([workspaceId, telemetryEventId])
}

// §54: a feed sync run. Fixture/imported syncs record mode honestly;
// live transports report NOT_CONFIGURED and sync nothing.
model ThreatIntelFeedSync {
  id           String    @id @default(uuid())
  sourceId     String
  workspaceId  String
  status       String // COMPLETED | NOT_CONFIGURED | FAILED
  mode         String // FIXTURE_IMPORT | MANUAL_IMPORT | LIVE
  indicatorsIn Int       @default(0)
  created      Int       @default(0)
  updated      Int       @default(0)
  errors       Json      @default("[]")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([workspaceId, sourceId, startedAt])
}

// §75/§80: one proposed response action on an incident. The action is
// identified by catalog KEY only (§76); executionId is the §81
// idempotency identity.
model ResponseActionExecution {
  id              String    @id @default(uuid())
  organizationId  String
  workspaceId     String
  incidentId      String
  actionKey       String
  targetReference String
  executionId     String
  status          String    @default("PROPOSED") // PROPOSED | PENDING_APPROVAL | APPROVED | EXECUTED | FAILED | REJECTED | NOT_CONFIGURED
  proposedBy      String
  result          Json      @default("{}")
  rollback        Json      @default("{}")
  executedAt      DateTime?
  executedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, executionId])
  @@index([workspaceId, incidentId])
}

// §78/§126: an approval decision on a response action.
model ResponseActionApproval {
  id          String   @id @default(uuid())
  executionId String // ResponseActionExecution.id
  workspaceId String
  approverId  String
  decision    String // APPROVED | REJECTED
  reason      String   @default("")
  createdAt   DateTime @default(now())

  @@unique([executionId, approverId])
  @@index([workspaceId, executionId])
}

// §88: a playbook run pinned to the exact template version (§87).
model IncidentPlaybookRun {
  id              String    @id @default(uuid())
  organizationId  String
  workspaceId     String
  incidentId      String
  playbookKey     String
  playbookVersion Int
  status          String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | CANCELLED
  currentStepKey  String?
  stepsState      Json      @default("[]") // [{key, status, completedAt, note}]
  startedBy       String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([workspaceId, incidentId])
}

// §93: structured incident communication (message SNAPSHOT — what was
// actually sent is what is recorded).
model IncidentCommunication {
  id              String   @id @default(uuid())
  incidentId      String
  workspaceId     String
  audience        String // INTERNAL | EXECUTIVE | TECHNICAL | CUSTOMER
  channel         String // IN_APP | EMAIL | SLACK | TEAMS | WEBHOOK
  template        String? // INTERNAL_STATUS | EXECUTIVE_UPDATE | TECHNICAL_UPDATE | RESOLUTION_NOTICE (§94)
  messageSnapshot String
  authorId        String
  deliveryStatus  String   @default("RECORDED") // RECORDED | QUEUED — external channels deliver via the P22/P24 routers
  createdAt       DateTime @default(now())

  @@index([workspaceId, incidentId, createdAt])
}

// §118: post-incident review. Root cause carries an honesty state
// (§119): CONFIRMED | LIKELY | UNKNOWN — never forced certainty.
model PostIncidentReview {
  id              String    @id @default(uuid())
  incidentId      String    @unique
  workspaceId     String
  summary         String    @default("")
  impact          String    @default("")
  rootCause       String    @default("")
  rootCauseState  String    @default("UNKNOWN") // CONFIRMED | LIKELY | UNKNOWN
  detectionGaps   Json      @default("[]")
  responseGaps    Json      @default("[]")
  lessons         Json      @default("[]")
  followUpActions Json      @default("[]") // §120 links: tickets/controls/risks/rules/findings
  ownerId         String?
  status          String    @default("DRAFT") // DRAFT | COMPLETED
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, status])
}

// §90: per-workspace SOC SLA targets (minutes) overriding defaults.
model SocSlaConfig {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  targets     Json     @default("{}") // { P1: {triage, acknowledge, containment, recovery}, ... }
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// §116: a telemetry data gap — an expected source stopped reporting.
model TelemetryDataGap {
  id          String    @id @default(uuid())
  workspaceId String
  sourceId    String
  sourceName  String
  detectedAt  DateTime  @default(now())
  lastEventAt DateTime?
  gapSeconds  Int
  status      String    @default("OPEN") // OPEN | RESOLVED
  resolvedAt  DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, sourceId])
}

// §117: generated incident report (redacted content + hash, in the
// P20 snapshot discipline). PIR documents live in PostIncidentReview.
model SocIncidentReport {
  id          String   @id @default(uuid())
  incidentId  String
  workspaceId String
  type        String // INCIDENT_REPORT | EXECUTIVE_SUMMARY | TECHNICAL_INVESTIGATION
  content     Json     @default("{}")
  contentHash String
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, incidentId, createdAt])
}

// ============================================================================
// Prompt 29 — Enterprise External Attack Surface Management (EASM).
// The authorization boundary is structural: candidates are DISCOVERED
// records only. A candidate carries activeTestingStatus NOT_AUTHORIZED
// until a named human with AUTHORIZE_EASM_ACTIVE_TESTING records a
// separate authorization — discovery, verification of ownership and
// promotion into the canonical inventory NEVER set it (§13/§71/§135).
// ============================================================================

// §3: an EASM program — a named external-surface scope inside a workspace.
model EasmProgram {
  id                String   @id @default(uuid())
  organizationId    String
  workspaceId       String
  name              String
  description       String   @default("")
  status            String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ARCHIVED (§4)
  monitoringEnabled Boolean  @default(false)
  monitoringTier    String   @default("DAILY") // HOURLY_LIGHT | DAILY | WEEKLY_DEEP (§87/§88)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId, status])
}

// §5–§9: an explicitly-scoped root asset. Ownership is NEVER inferred
// from WHOIS alone (§9): authorizationStatus stays PENDING until a
// controlled verification workflow completes (§8).
model EasmRootAsset {
  id                     String    @id @default(uuid())
  programId              String
  workspaceId            String
  type                   String // DOMAIN | IP | CIDR | CLOUD_ACCOUNT | REPOSITORY_ORGANIZATION
  value                  String // normalized identity (ascii domain / canonical IP / CIDR)
  unicodeValue           String? // §21 preserved Unicode form for IDN roots
  authorizationStatus    String    @default("PENDING") // PENDING | VERIFIED | REJECTED | EXPIRED (§7)
  authorizationMethod    String? // DNS_TXT | FILE_CHALLENGE | MANUAL_APPROVAL | CLOUD_INTEGRATION
  authorizedBy           String?
  authorizedAt           DateTime?
  authorizationExpiresAt DateTime?
  // §6: active testing is a SEPARATE grant from ownership verification.
  activeTestingAllowed   Boolean   @default(false)
  activeTestingStatus    String    @default("NOT_AUTHORIZED") // NOT_AUTHORIZED | AUTHORIZED_SAFE | AUTHORIZED_STANDARD (§19)
  activeTestingBy        String?
  activeTestingAt        DateTime?
  verificationChallenge  String? // opaque challenge value the owner must publish (§8)
  createdBy              String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([programId, type, value])
  @@index([workspaceId, programId])
}

// §10/§11: discovery policy. CUSTOM remains bounded by platform policy:
// unbounded brute force and unrestricted port sets are not expressible.
model EasmDiscoveryPolicy {
  id                   String   @id @default(uuid())
  programId            String   @unique
  workspaceId          String
  mode                 String   @default("PASSIVE_ONLY") // PASSIVE_ONLY | SAFE_ACTIVE | CUSTOM
  passiveDiscovery     Boolean  @default(true)
  dnsResolution        Boolean  @default(true)
  certificateDiscovery Boolean  @default(true)
  httpProbing          Boolean  @default(false)
  serviceDiscovery     Boolean  @default(false)
  technologyDetection  Boolean  @default(true)
  historicalUrls       Boolean  @default(false)
  frequency            String   @default("DAILY") // HOURLY | DAILY | WEEKLY
  maxCandidatesPerRun  Int      @default(1000) // §124/§125 backpressure bound
  allowPromotion       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId])
}

// §42/§43: conservative-by-default service discovery profile. The port
// set is an explicit approved list — never "all ports" (§153).
model EasmServiceDiscoveryProfile {
  id            String   @id @default(uuid())
  programId     String   @unique
  workspaceId   String
  ports         Int[]    @default([80, 443, 22, 21, 25, 53, 110, 143, 993, 995, 1723, 3306, 3389, 5432, 5900, 8000, 8080, 8443])
  ratePerSecond Int      @default(100)
  timeoutMs     Int      @default(1500)
  retries       Int      @default(1)
  probeLevel    String   @default("CONNECT") // CONNECT only — no aggressive probes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId])
}

// §16–§19 + §91: a discovered candidate asset. status = human review
// state; lifecycle = observation state; ownershipStatus/activeTesting
// Status are the authorization boundary, stored separately on purpose.
model EasmAssetCandidate {
  id                  String   @id @default(uuid())
  programId           String
  workspaceId         String
  rootAssetId         String?
  type                String // DOMAIN | FQDN | IP | URL | CLOUD_ASSET
  normalizedValue     String // canonical identity (dedupe key within program)
  unicodeValue        String? // §21 Unicode form for IDNs
  suspiciousIdn       Boolean  @default(false)
  status              String   @default("NEW") // NEW | REVIEWING | CONFIRMED | REJECTED | MERGED (§17)
  lifecycle           String   @default("DISCOVERED") // DISCOVERED | ACTIVE | STALE | DISAPPEARED | ARCHIVED (§91)
  confidence          Float    @default(0.5)
  ownershipStatus     String   @default("UNKNOWN") // UNKNOWN | LIKELY | VERIFIED | THIRD_PARTY | SHARED (§18)
  ownershipConfidence String   @default("UNKNOWN") // UNKNOWN | LOW | MEDIUM | HIGH | VERIFIED (§66)
  activeTestingStatus String   @default("NOT_AUTHORIZED") // §19 — discovery NEVER changes this
  exposureState       String   @default("UNKNOWN") // §74
  criticality         String   @default("UNSPECIFIED")
  firstSeen           DateTime @default(now())
  lastSeen            DateTime @default(now())
  missCount           Int      @default(0) // §92 disappearance confirmation counter
  promotedAssetId     String? // canonical Asset row after promotion (§70)
  promotedTargetId    String?
  mergedIntoId        String?
  technicalOwner      String? // §94
  businessOwner       String?
  team                String?
  application         String?
  businessUnit        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([programId, normalizedValue])
  @@index([workspaceId, status])
  @@index([workspaceId, ownershipStatus])
  @@index([workspaceId, exposureState])
}

// §14/§15: one provenance-preserving observation of a candidate.
model AssetDiscoveryObservation {
  id           String   @id @default(uuid())
  candidateId  String
  workspaceId  String
  programId    String
  rootAssetId  String?
  source       String // EasmSourceKind
  confidence   Float    @default(0.5)
  rawReference String   @default("") // recorded-output reference, never a live URL fetch
  relationship String? // e.g. SUBDOMAIN_OF | SAN_OF | RESOLVES_TO
  metadata     Json     @default("{}")
  observedAt   DateTime @default(now())

  @@index([workspaceId, candidateId])
  @@index([workspaceId, observedAt])
}

// §67: ownership evidence rows — every ownership conclusion references these.
model EasmOwnershipEvidence {
  id          String   @id @default(uuid())
  candidateId String?
  rootAssetId String?
  workspaceId String
  kind        String // OwnershipEvidenceKind
  reference   String
  detail      String   @default("")
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, candidateId])
}

// §26/§27: immutable DNS snapshot (history preserved; hash per §26).
model DnsSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  programId   String
  candidateId String?
  domain      String
  records     Json     @default("[]") // DnsRecord[]
  source      String
  hash        String
  observedAt  DateTime @default(now())

  @@index([workspaceId, domain, observedAt])
  @@index([workspaceId, candidateId])
}

// §29: dangling-DNS CANDIDATE — observable configuration only; the
// platform never attempts a takeover (§141/§153).
model DanglingDnsCandidate {
  id          String   @id @default(uuid())
  workspaceId String
  programId   String
  candidateId String
  domain      String
  cnameTarget String
  service     String?
  evidence    String   @default("")
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | DISMISSED
  detectedAt  DateTime @default(now())

  @@index([workspaceId, status])
}

// §35: certificate intelligence record, keyed by fingerprint.
model EasmCertificate {
  id                 String    @id @default(uuid())
  workspaceId        String
  fingerprint        String // normalized SHA-256 hex (§20)
  subject            String    @default("")
  issuer             String    @default("")
  sans               Json      @default("[]") // string[]
  notBefore          DateTime?
  notAfter           DateTime?
  signatureAlgorithm String    @default("")
  keyType            String    @default("")
  keyBits            Int?
  state              String    @default("HEALTHY") // §38
  firstSeen          DateTime  @default(now())
  lastSeen           DateTime  @default(now())

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, state])
}

// §35: which hosts a certificate was observed on.
model EasmCertificateObservation {
  id            String   @id @default(uuid())
  workspaceId   String
  certificateId String
  candidateId   String?
  host          String
  source        String // TLS_HANDSHAKE | CERT_TRANSPARENCY | SCAN_EVIDENCE
  observedAt    DateTime @default(now())

  @@index([workspaceId, certificateId])
  @@index([workspaceId, host])
}

// §40: point-in-time host exposure snapshot.
model HostExposureSnapshot {
  id                     String   @id @default(uuid())
  workspaceId            String
  programId              String
  candidateId            String
  host                   String
  resolvedIps            Json     @default("[]")
  internetVisibility     String   @default("UNKNOWN")
  httpState              Json     @default("{}")
  services               Json     @default("[]")
  technologies           Json     @default("[]")
  certificateFingerprint String?
  riskSignals            Json     @default("[]")
  capturedAt             DateTime @default(now())

  @@index([workspaceId, candidateId, capturedAt])
}

// §44: service observation (first/last seen per candidate+port).
model ServiceObservation {
  id             String   @id @default(uuid())
  workspaceId    String
  candidateId    String
  ip             String?
  port           Int
  transport      String   @default("tcp")
  service        String?
  product        String?
  version        String? // only when a tool actually reported it
  confidence     Float    @default(0.5)
  sensitiveClass String? // §46 classification only
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @default(now())

  @@unique([candidateId, port, transport])
  @@index([workspaceId, candidateId])
}

// §49: HTTP exposure snapshot. Headers subset only; no bodies stored.
model HttpExposureSnapshot {
  id                     String   @id @default(uuid())
  workspaceId            String
  programId              String
  candidateId            String
  url                    String
  status                 Int?
  title                  String?
  headers                Json     @default("{}")
  redirectTarget         String? // recorded, NEVER auto-followed into active scope (§48/§137)
  technologies           Json     @default("[]")
  certificateFingerprint String?
  capturedAt             DateTime @default(now())

  @@index([workspaceId, candidateId, capturedAt])
}

// §54: technology observation with per-source evidence.
model TechnologyObservation {
  id             String   @id @default(uuid())
  workspaceId    String
  candidateId    String
  technology     String
  normalizedName String
  version        String? // §57: null unless evidence states a version
  category       String   @default("OTHER") // §55
  confidence     String   @default("LOW") // LOW | MEDIUM | HIGH (§56)
  sources        Json     @default("[]")
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @default(now())

  @@unique([candidateId, normalizedName])
  @@index([workspaceId, candidateId])
}

// §72/§73: asset-graph relationships between candidates/roots with
// confidence + provenance.
model EasmAssetRelationship {
  id          String   @id @default(uuid())
  workspaceId String
  programId   String
  fromType    String // ROOT_ASSET | CANDIDATE
  fromId      String
  toType      String // CANDIDATE | CERTIFICATE
  toId        String
  kind        String // ROOT_DOMAIN_SUBDOMAIN | DOMAIN_IP | HOST_SERVICE | HOST_CERTIFICATE | HOST_TECHNOLOGY | CLOUD_ACCOUNT_ASSET | REPOSITORY_DEPLOYED_ASSET
  confidence  Float    @default(0.5)
  source      String
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@unique([workspaceId, fromId, toId, kind])
  @@index([workspaceId, programId])
}

// §96: deterministic ownership-assignment rules.
model AssetOwnershipRule {
  id              String   @id @default(uuid())
  workspaceId     String
  programId       String?
  ruleType        String // DOMAIN_SUFFIX | CLOUD_ACCOUNT | REPOSITORY | TAG | IP_RANGE
  pattern         String
  ownershipStatus String   @default("LIKELY")
  technicalOwner  String?
  team            String?
  application     String?
  businessUnit    String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([workspaceId, programId])
}

// §51/§52: screenshot METADATA only. Bytes live in private object
// storage; access is RBAC-gated + audited (VIEW_EASM_EVIDENCE) and
// retention is shorter than other evidence (§123).
model EasmScreenshot {
  id             String    @id @default(uuid())
  workspaceId    String
  candidateId    String
  storageKey     String
  classification String    @default("RESTRICTED")
  sha256         String?
  retentionUntil DateTime?
  capturedAt     DateTime  @default(now())

  @@index([workspaceId, candidateId])
}

// §127–§130: discovery run + per-adapter results (partial success is
// a first-class outcome, §126).
model EasmDiscoveryRun {
  id              String    @id @default(uuid())
  programId       String
  workspaceId     String
  status          String    @default("QUEUED") // QUEUED | RUNNING | PARTIAL | COMPLETED | FAILED | CANCELLED (§128)
  trigger         String    @default("MANUAL") // MANUAL | SCHEDULED
  candidatesFound Int       @default(0)
  candidatesNew   Int       @default(0)
  promoted        Int       @default(0)
  coverage        Json      @default("{}")
  errors          Json      @default("[]")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([workspaceId, programId, startedAt])
}

model EasmAdapterRunResult {
  id          String   @id @default(uuid())
  runId       String
  workspaceId String
  adapter     String
  version     String? // §130 recorded tool version (null when transport unconfigured)
  status      String // OK | ERROR | NOT_CONFIGURED | SKIPPED_POLICY
  durationMs  Int      @default(0)
  resultCount Int      @default(0)
  errorClass  String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, runId])
}

// §82: drift event (before/after evidence preserved).
model EasmDriftEvent {
  id            String   @id @default(uuid())
  workspaceId   String
  programId     String
  candidateId   String?
  assetIdentity String
  type          String // §81 drift types
  before        Json?
  after         Json?
  severity      String   @default("LOW")
  confidence    Float    @default(0.8)
  fingerprint   String // §79 correlation fingerprint
  status        String   @default("OPEN") // OPEN | ACKNOWLEDGED
  evidence      Json     @default("{}")
  detectedAt    DateTime @default(now())

  @@index([workspaceId, programId, detectedAt])
  @@index([workspaceId, fingerprint])
}

// §84/§85: baselines are immutable + versioned; a new baseline is a
// new row, never an edit.
model EasmBaseline {
  id          String   @id @default(uuid())
  workspaceId String
  programId   String
  version     Int
  snapshot    Json     @default("{}") // EasmSnapshot
  contentHash String
  createdBy   String
  createdAt   DateTime @default(now())

  @@unique([programId, version])
  @@index([workspaceId, programId])
}

// §120: EASM report snapshots in the P20 immutable discipline —
// content is rendered from real rows only and hash-anchored.
model EasmReportSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  programId   String?
  type        String // EXTERNAL_ATTACK_SURFACE | NEW_ASSET | EXPOSURE_DRIFT | CERTIFICATE_HEALTH | TECHNOLOGY_EXPOSURE | UNKNOWN_ASSET | EXECUTIVE_EASM
  content     Json     @default("{}")
  contentHash String
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, type, createdAt])
}

// ============================ Prompt 31: Remediation Orchestration ============================
// One ACTIVE case per canonical finding (§4); history is append-oriented
// (§9) — status changes land in RemediationStatusHistory, never rewrites.
// A case reaches VERIFIED_FIXED only through the verification engine
// (§52–§65) and CLOSED only through the closure engine (§68) — ticket
// state and AI output can never move it there (§157).

model RemediationCase {
  id                  String    @id @default(uuid())
  organizationId      String
  workspaceId         String
  findingId           String
  status              String    @default("NEW") // RemediationStatus (§5)
  priority            String? // P0..P4 — mirrors the finding priority at triage
  ownerType           String? // USER | TEAM | APPLICATION_OWNER | REPOSITORY_OWNER | ASSET_OWNER (§18)
  ownerId             String?
  teamId              String?
  ownershipConfidence String? // VERIFIED | HIGH | MEDIUM | LOW | UNKNOWN (§16)
  slaPolicyId         String?
  dueAt               DateTime?
  remediationPlanId   String?
  verificationState   String    @default("NOT_REQUESTED") // NOT_REQUESTED | PENDING | RUNNING | PASSED | FAILED | INCONCLUSIVE | ERROR
  regressionCount     Int       @default(0)
  lastRegressionAt    DateTime?
  verifiedFixedAt     DateTime?
  closureSnapshot     Json? // §70: reason/method/evidence/risk/ticket state at closure
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  closedAt            DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, findingId])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, ownerId])
}

model RemediationStatusHistory {
  id          String   @id @default(uuid())
  caseId      String
  workspaceId String
  fromStatus  String?
  toStatus    String
  actorId     String
  reason      String?
  evidence    Json?
  createdAt   DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([workspaceId])
}

model RemediationTriage {
  id                 String    @id @default(uuid())
  caseId             String
  workspaceId        String
  decision           String // ACTION_REQUIRED | FALSE_POSITIVE | DUPLICATE | ACCEPT_RISK_CANDIDATE | NEEDS_MORE_EVIDENCE | NOT_APPLICABLE (§11)
  analystId          String
  priority           String?
  reason             String
  notes              String?
  evidence           Json?
  canonicalFindingId String? // DUPLICATE: the canonical primary (§13)
  reviewAt           DateTime? // FALSE_POSITIVE optional expiration/review (§12)
  createdAt          DateTime  @default(now())

  @@index([caseId, createdAt])
  @@index([workspaceId])
}

model RemediationAssignment {
  id          String   @id @default(uuid())
  caseId      String
  workspaceId String
  ownerType   String
  ownerId     String?
  teamId      String?
  confidence  String? // ownership confidence at assignment time (§16)
  assignedBy  String
  reason      String?
  source      String // EXPLICIT_FINDING_ASSIGNMENT | APPLICATION_OWNER | REPOSITORY_OWNER | ASSET_OWNER | WORKSPACE_DEFAULT | MANUAL | AI_SUGGESTION_CONFIRMED
  createdAt   DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([workspaceId, ownerId])
}

// §24: the SLA decision is snapshotted — policy version, target and the
// exact inputs used — so a historical due date stays explainable even
// after the policy changes.
model RemediationSlaSnapshot {
  id               String    @id @default(uuid())
  caseId           String
  workspaceId      String
  policyId         String?
  policyVersion    Int?
  inputs           Json // { priority, severity, kevListed, internetExposed, criticality, category }
  targetHours      Float
  startedAt        DateTime
  dueAt            DateTime
  state            String    @default("ON_TRACK") // ON_TRACK | WARNING | AT_RISK | BREACHED | PAUSED | COMPLETED (§26)
  pausedDurationMs Int       @default(0)
  pausedAt         DateTime?
  pauseReason      String?
  completedAt      DateTime?
  lastEvaluatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([caseId])
  @@index([workspaceId, state])
  @@index([workspaceId, dueAt])
}

model RemediationSlaPause {
  id          String    @id @default(uuid())
  snapshotId  String
  caseId      String
  workspaceId String
  reason      String // WAITING_VENDOR | APPROVED_EXCEPTION | ENVIRONMENT_UNAVAILABLE | OTHER_APPROVED_REASON (§28)
  startedBy   String
  approvedBy  String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  endedBy     String?

  @@index([snapshotId])
  @@index([workspaceId])
}

model RemediationPlan {
  id                String    @id @default(uuid())
  caseId            String
  workspaceId       String
  summary           String
  recommendedAction String // PATCH | UPGRADE | CONFIGURATION_CHANGE | CODE_FIX | DEPENDENCY_UPDATE | REMOVE_COMPONENT | REDUCE_EXPOSURE | COMPENSATING_CONTROL | OTHER (§36)
  source            String // PATCH_INTELLIGENCE | VENDOR_ADVISORY | SCANNER_RECOMMENDATION | ANALYST | APPROVED_GUIDANCE (§33)
  patchReference    String?
  fixedVersion      String? // must trace to trusted Patch Intelligence (§34)
  targetVersion     String?
  mitigation        String? // temporary mitigation — tracked separately from the fix (§37)
  permanentFix      String?
  ownerId           String?
  plannedAt         DateTime?
  targetDate        DateTime?
  status            String    @default("DRAFT") // DRAFT | APPROVED | SUPERSEDED
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([caseId, createdAt])
  @@index([workspaceId])
}

// §38: the canonical work item exists BEFORE any provider ticket.
model RemediationWorkItem {
  id             String    @id @default(uuid())
  caseId         String
  workspaceId    String
  findingId      String
  idempotencyKey String    @unique // stable key — retries never duplicate (§46)
  provider       String // JIRA | GITHUB | GITLAB | SERVICENOW | INTERNAL
  integrationId  String?
  ticketId       String? // linked P24 RemediationTicket when one exists
  status         String    @default("PENDING") // PENDING | CREATED | SYNCED | FAILED | CLOSED | STALE (§39)
  externalId     String?
  externalUrl    String?
  externalStatus String?
  assignee       String?
  payload        Json? // the REDACTED payload actually sent (§45)
  failureCount   Int       @default(0)
  lastError      String?
  nextRetryAt    DateTime?
  lastSyncedAt   DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([caseId])
  @@index([workspaceId, status])
}

model RemediationFixClaim {
  id            String   @id @default(uuid())
  caseId        String
  workspaceId   String
  claimedBy     String
  claimSource   String // MANUAL | TICKET_SYNC | CI_CD | REPOSITORY_EVENT | DEPLOYMENT_EVENT (§51)
  description   String
  workItemId    String?
  deploymentRef String?
  commitRef     String?
  patchRef      String?
  evidence      Json?
  createdAt     DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([workspaceId])
}

model RemediationVerificationJob {
  id                        String    @id @default(uuid())
  caseId                    String
  workspaceId               String
  method                    String // SAFE_RESCAN | TARGETED_RETEST | SAST_RESCAN | SCA_RESCAN | SBOM_REEVALUATION | CONFIGURATION_RECHECK | CLOUD_POSTURE_RECHECK | MANUAL_EVIDENCE_REVIEW (§53)
  status                    String    @default("QUEUED") // QUEUED | RUNNING | PASSED | FAILED | INCONCLUSIVE | ERROR | CANCELLED (§58)
  requestedBy               String
  scannerProfile            String?
  scope                     Json? // smallest sufficient scope (§56)
  retestRequestId           String? // governed P11 retest, when the method rides it (§55)
  requiredCleanObservations Int       @default(1)
  cleanObservations         Int       @default(0)
  result                    Json?
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([caseId, createdAt])
  @@index([workspaceId, status])
}

model RemediationVerificationEvidence {
  id                String   @id @default(uuid())
  jobId             String
  caseId            String
  workspaceId       String
  beforeObservation Json? // observation of the finding before the fix (§59/§60)
  afterObservation  Json? // observation after the fix
  tool              String?
  toolVersion       String?
  comparisonResult  String // STILL_PRESENT | ABSENT | INSUFFICIENT | SCANNER_ERROR
  evidenceRefs      Json?
  recordedBy        String
  createdAt         DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([workspaceId])
}

model RemediationException {
  id                   String    @id @default(uuid())
  caseId               String
  workspaceId          String
  findingId            String
  type                 String // RISK_ACCEPTANCE | TEMPORARY_DEFERRAL | FALSE_POSITIVE_EXCEPTION | BUSINESS_EXCEPTION (§78)
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  reason               String
  scope                Json?
  ownerId              String
  requestedBy          String
  approverId           String?
  compensatingControls Json? // required where applicable (§79)
  riskExceptionId      String? // the P20 RiskException row — acceptance is NOT duplicated (§81)
  startsAt             DateTime  @default(now())
  expiresAt            DateTime // exceptions always expire or face review (§80)
  reviewAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([caseId])
  @@index([workspaceId, status])
  @@index([expiresAt])
}

model RemediationCampaign {
  id             String    @id @default(uuid())
  workspaceId    String
  name           String
  scope          Json // { cve?, componentPurl?, product?, technology?, kevOnly? } (§87)
  ownerId        String?
  targetDate     DateTime?
  status         String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  idempotencyKey String?   @unique
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, status])
}

model RemediationCampaignCase {
  id          String   @id @default(uuid())
  campaignId  String
  caseId      String
  workspaceId String
  createdAt   DateTime @default(now())

  @@unique([campaignId, caseId])
  @@index([workspaceId, caseId])
}

model RemediationRegressionEvent {
  id                 String    @id @default(uuid())
  caseId             String
  workspaceId        String
  findingId          String
  fingerprint        String? // regression identity (§72)
  detectedAt         DateTime  @default(now())
  previousVerifiedAt DateTime?
  source             String // RETEST | SCAN_OBSERVATION | SCHEDULED_CHECK
  riskRecalculation  Json?
  createdAt          DateTime  @default(now())

  @@index([caseId, detectedAt])
  @@index([workspaceId, detectedAt])
}

// §129: an issued report preserves the finding/risk/SLA/ticket/
// verification/exception state at generation time.
model RemediationReportSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  type        String // REMEDIATION_STATUS | SLA_COMPLIANCE | OVERDUE_VULNERABILITIES | KEV_REMEDIATION | REGRESSION | CAMPAIGN | EXECUTIVE_REMEDIATION (§128)
  content     Json     @default("{}")
  contentHash String
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, type, createdAt])
}

// ------------------------------- Web/API VAPT V2 (Prompt 32) -------------------------------
// V2 deepens the Prompt 5–9 engines on the SAME canonical models
// (Target / Asset / Endpoint / EndpointParameter / ApiService /
// ApiSpecification / Finding). The models below are the V2 planning
// and governance records only: targets, immutable scope snapshots,
// scan plans with budgets, preflight results, authorization matrices,
// business-logic scenarios, sessions, evidence and coverage. No
// credential VALUES exist anywhere in these models — references only
// (§50/§53).

// §4: a web VAPT target binds an existing verified asset to an
// authorization (an APPROVED assessment on the parent Target). It is
// a planning view — it never authorizes anything by itself (§6).
model WebVaptTarget {
  id                      String   @id @default(uuid())
  workspaceId             String
  assetId                 String
  targetId                String
  baseUrl                 String
  normalizedOrigin        String
  // The APPROVED assessment that carries the active authorization.
  authorizationId         String
  // PRODUCTION | STAGING | DEVELOPMENT | TEST | UNKNOWN (§5)
  environment             String   @default("UNKNOWN")
  criticality             String   @default("MEDIUM")
  authenticationProfileId String?
  scanProfileKey          String   @default("WEB_SAFE")
  // ACTIVE | PAUSED | ARCHIVED
  status                  String   @default("ACTIVE")
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([assetId])
}

// §136: the immutable scope snapshot frozen at scan start. There is
// deliberately no updatedAt — a snapshot never changes after creation;
// scope edits create a NEW snapshot for the NEXT scan (§137).
model ScanScopeSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  planId      String?
  scanId      String?
  origins     String[] @default([])
  hosts       String[] @default([])
  exclusions  String[] @default([])
  hash        String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([hash])
}

// §10/§11: a scan plan generated BEFORE execution — target, tools,
// stages, limits, authentication, scope snapshot and request budget,
// shown in the plan preview before any high-impact run.
model WebVaptScanPlan {
  id                      String   @id @default(uuid())
  workspaceId             String
  webTargetId             String
  scanId                  String?
  // WEB_PASSIVE | WEB_SAFE | WEB_STANDARD | API_SAFE | API_STANDARD |
  // TLS_ONLY | CONTENT_DISCOVERY | TARGETED_VERIFICATION (§122)
  profileKey              String
  stages                  Json     @default("[]")
  allowedTools            String[] @default([])
  // Modules dropped by the §16 gate, with reasons — never silent.
  blockedModules          Json     @default("[]")
  budget                  Json
  estimatedRequestClass   String   @default("MEDIUM")
  scopeSnapshotId         String
  authenticationProfileId String?
  // PLANNED | STARTED | BLOCKED | CANCELLED | COMPLETED
  status                  String   @default("PLANNED")
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([webTargetId])
}

// §7/§8: one preflight evaluation over authorization facts + probe
// observations. Checks are stored verbatim so a BLOCKED verdict always
// carries its reasons.
model WebVaptPreflightResult {
  id               String   @id @default(uuid())
  workspaceId      String
  webTargetId      String
  // READY | READY_WITH_WARNINGS | BLOCKED | UNREACHABLE | AUTH_REQUIRED
  status           String
  checks           Json     @default("[]")
  redirectRecorded String?
  probeTransport   String   @default("NOT_CONFIGURED")
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([workspaceId, webTargetId])
}

// §36/§37: an immutable snapshot of an imported API specification.
// The parent ApiSpecification tracks the live import; the snapshot
// freezes source/version/hash/counts at import time.
model ApiSpecificationSnapshot {
  id              String   @id @default(uuid())
  workspaceId     String
  specificationId String
  source          String
  version         String?
  hash            String
  endpointCount   Int      @default(0)
  schemaCount     Int      @default(0)
  // Hosts referenced by the document that scope validation rejected
  // (§139/§140) — recorded, never fetched.
  rejectedHosts   String[] @default([])
  importedAt      DateTime @default(now())

  @@index([workspaceId])
  @@index([specificationId])
}

// §99: one evaluated row of an AuthorizationTestMatrix, attached to a
// Prompt 9 AuthorizationTestCase (the governed design record). A
// MISMATCH stores the candidate finding (§100) — materialization into
// the canonical Finding pipeline happens only with a linked scan.
model AuthorizationMatrixEntry {
  id               String   @id @default(uuid())
  workspaceId      String
  testCaseId       String
  identityA        String
  identityB        String?
  role             String
  resource         String
  expectedAccess   String
  observedAccess   String   @default("NOT_TESTED")
  // MATCH | MISMATCH | NOT_TESTED
  result           String   @default("NOT_TESTED")
  candidateFinding Json?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, testCaseId])
}

// §102: a human-defined business-logic test scenario. Steps are
// descriptions evaluated by governed comparison — the platform does
// not pretend generic scanners automate business logic (§101).
model BusinessLogicScenario {
  id                   String   @id @default(uuid())
  workspaceId          String
  name                 String
  preconditions        String   @default("")
  authorizedIdentities String[] @default([])
  safeSteps            Json     @default("[]")
  expectedBehavior     String
  observedBehavior     String?
  // DRAFT | READY | EVALUATED
  status               String   @default("DRAFT")
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId, status])
}

// §51–§53: an isolated per-scan-run web session context. Only the
// credential REFERENCE and redacted presence metadata are stored —
// cookie/token VALUES never enter this record, logs or evidence.
model WebScanSession {
  id                      String    @id @default(uuid())
  workspaceId             String
  scanId                  String
  authenticationProfileId String?
  credentialReference     String?
  // ACTIVE | EXPIRED | LOGGED_OUT | FAILED
  status                  String    @default("ACTIVE")
  // Presence flags + fingerprints only (§53).
  redactedSummary         Json      @default("{}")
  expiresAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([workspaceId, scanId])
}

// §113–§116: sanitized V2 evidence. Request/response copies are
// redacted BEFORE persistence and body-capped; large material lives
// in object storage behind artifactRef — never as a Postgres blob.
model WebVaptEvidence {
  id                String   @id @default(uuid())
  workspaceId       String
  scanId            String?
  findingId         String?
  // REQUEST | RESPONSE | MARKER | SCREENSHOT | TOOL_OUTPUT | ENDPOINT_METADATA
  kind              String
  sanitizedRequest  String?
  sanitizedResponse String?
  marker            String?
  artifactRef       String?
  sizeBytes         Int      @default(0)
  sha256            String?
  createdAt         DateTime @default(now())

  @@index([workspaceId, scanId])
  @@index([findingId])
}

// §147: the coverage record of a V2 scan — the report's limitations
// section, computed from what was actually tested (§148).
model WebVaptCoverage {
  id                    String   @id @default(uuid())
  workspaceId           String
  scanId                String   @unique
  discoveredEndpoints   Int      @default(0)
  testedEndpoints       Int      @default(0)
  endpointCoverage      Float?
  parameterCoverage     Float?
  authenticatedCoverage Float?
  toolCoverage          Json     @default("{}")
  skipped               Json     @default("[]")
  limitations           Json     @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([workspaceId])
}

// §146: per-workspace tool health for the V2 tool set — installed,
// version, last success, error rate, parser compatibility.
model WebToolHealth {
  id                String    @id @default(uuid())
  workspaceId       String
  slug              String
  installed         Boolean   @default(false)
  version           String?
  lastSuccessfulRun DateTime?
  errorRate         Float     @default(0)
  parserCompatible  Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// =====================================================================
// Prompt 33 — Advanced Network VAPT V2.
// V2 deepens the Prompt 10 network engine on the SAME canonical data:
// targets bind a VERIFIED parent Target + APPROVED assessment (the
// authorization record), plans freeze an immutable ScanScopeSnapshot,
// host/service/OS observations accumulate per workspace, and packet
// captures + Metasploit verification requests are governed records.
// Credentials are secret REFERENCES only — no plaintext secret column
// exists anywhere in this block.
// =====================================================================

// §3: a governed network VAPT target.
model NetworkVaptTarget {
  id              String   @id @default(uuid())
  organizationId  String
  workspaceId     String
  assetId         String
  targetId        String
  targetType      String // IP | CIDR | HOSTNAME | AUTHORIZED_ASSET_GROUP
  targetValue     String // canonical value (normalization precedes scope, §6)
  authorizationId String // the APPROVED Assessment (the authorization record)
  environment     String   @default("PRODUCTION")
  criticality     String   @default("UNSPECIFIED")
  scanProfileId   String   @default("NETWORK_SAFE")
  status          String   @default("ACTIVE")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, targetType])
  @@index([workspaceId, assetId])
}

// §8/§9: one preflight evaluation per run — real authorization facts,
// transport honestly NOT_CONFIGURED where unwired.
model NetworkVaptPreflightResult {
  id             String   @id @default(uuid())
  workspaceId    String
  targetId       String
  status         String // READY | READY_WITH_WARNINGS | BLOCKED | UNREACHABLE | TOOL_UNAVAILABLE
  checks         Json     @default("[]")
  probeTransport String   @default("NOT_CONFIGURED")
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([workspaceId, targetId, createdAt])
}

// §10/§11/§17/§27/§37: a scan plan over a frozen scope snapshot, with
// the exact tools/scripts/budget and every blocked item visible.
model NetworkVaptScanPlan {
  id                     String   @id @default(uuid())
  workspaceId            String
  targetId               String
  scanId                 String?
  profile                String
  stages                 Json     @default("[]")
  tools                  Json     @default("[]")
  portPolicy             Json     @default("{}")
  rateLimits             Json     @default("{}")
  timeouts               Json     @default("{}")
  serviceDetection       Boolean  @default(true)
  vulnerabilityScanners  Json     @default("[]")
  verificationPolicy     Json     @default("{}")
  estimatedWorkloadClass String   @default("SMALL")
  budget                 Json     @default("{}")
  scopeSnapshotId        String?
  scriptsUsed            Json     @default("[]")
  blockedItems           Json     @default("[]")
  status                 String   @default("PLANNED") // PLANNED | BLOCKED | STARTED | CANCELLED
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([workspaceId, targetId, createdAt])
  @@index([workspaceId, scanId])
}

// §22: host observations from every discovery method — merged into
// canonical assets by the Asset service; observations never authorize
// scanning (§21).
model NetworkHostObservation {
  id              String   @id @default(uuid())
  workspaceId     String
  assetId         String?
  ip              String
  hostname        String?
  macAddress      String?
  vendorHint      String?
  discoveryMethod String // NMAP | NETDISCOVER | ARP_SCAN | DNS | IMPORT
  hostStatus      String   @default("UNKNOWN") // UP | DOWN | UNKNOWN | FILTERED
  scopeStatus     String // IN_SCOPE | CANDIDATE | EXCLUDED
  confidence      Float    @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, ip, discoveryMethod])
  @@index([workspaceId, scopeStatus])
}

// §40: OS fingerprint observations — confidence preserved, weak
// fingerprints never become confirmed OS facts.
model OsFingerprintObservation {
  id          String   @id @default(uuid())
  workspaceId String
  assetId     String?
  host        String
  family      String
  versionHint String?
  confidence  Float
  band        String // LOW | MEDIUM | HIGH | VERIFIED
  source      String
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([workspaceId, host])
}

// §95: a named network segment with zone + ownership.
model NetworkSegment {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  cidr        String
  environment String   @default("PRODUCTION")
  zone        String   @default("UNKNOWN") // INTERNET | DMZ | INTERNAL | RESTRICTED | MANAGEMENT | UNKNOWN
  criticality String   @default("MEDIUM")
  owner       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, cidr])
  @@index([workspaceId, zone])
}

// §104: baselines are immutable + versioned (no updatedAt by design).
model NetworkBaseline {
  id          String   @id @default(uuid())
  workspaceId String
  segmentId   String?
  version     Int
  hosts       Json     @default("[]")
  hash        String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, segmentId, version])
  @@index([workspaceId, createdAt])
}

// §102: drift events from snapshot comparison — contextual signals.
model NetworkDriftEvent {
  id           String   @id @default(uuid())
  workspaceId  String
  baselineId   String?
  host         String
  assetId      String?
  kind         String // HOST_ADDED | SERVICE_ADDED | VERSION_CHANGED | …
  detail       String
  riskSignal   String   @default("STANDARD") // ELEVATED | STANDARD
  signalReason String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, host])
}

// §121: per-scan V2 coverage — gaps make COMPLETED_WITH_GAPS (§123).
model NetworkVaptCoverage {
  id                   String   @id @default(uuid())
  workspaceId          String
  scanId               String   @unique
  authorizedHosts      Int      @default(0)
  discoveredHosts      Int      @default(0)
  scannedHosts         Int      @default(0)
  portCoverage         Float?
  serviceCoverage      Float?
  vulnScannerCoverage  Float?
  credentialedCoverage Float?
  limitations          Json     @default("[]")
  completion           String   @default("COMPLETED_WITH_GAPS")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId])
}

// §86: packet capture jobs — bounded, permissioned, passive. PCAP
// bytes live in restricted object storage (§88); this row is metadata.
model NetworkPacketCaptureJob {
  id                 String    @id @default(uuid())
  workspaceId        String
  targetId           String?
  scanId             String?
  interfaceReference String
  filter             String?
  durationSeconds    Int
  sizeLimitBytes     Int
  status             String    @default("REQUESTED") // REQUESTED | RUNNING | COMPLETED | FAILED | DENIED
  evidenceRef        String?
  summary            Json      @default("{}")
  transport          String    @default("NOT_CONFIGURED")
  createdById        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}

// §72: defensive exploit-reference metadata ONLY (global intel table,
// populated solely by governed dataset imports — never by execution).
model DefensiveExploitReference {
  id              String    @id @default(uuid())
  referenceId     String    @unique
  title           String
  affectedProduct String
  cveIds          Json      @default("[]")
  source          String
  referenceUrl    String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([affectedProduct])
}

// §77: controlled Metasploit verification requests — evaluated against
// the allowlist + payload policy + scope, recorded, NEVER executed by
// an automated path (transport NOT_PROVISIONED in this build).
model MetasploitVerificationRequest {
  id            String   @id @default(uuid())
  workspaceId   String
  targetId      String?
  findingId     String
  host          String
  moduleId      String
  decision      String // APPROVED_FOR_MANUAL_CONTROLLED_RUN | REJECTED | BLOCKED
  reasons       Json     @default("[]")
  transport     String   @default("NOT_PROVISIONED")
  requestedById String?
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ===================== Prompt 34 — Advanced Cloud, Container & Kubernetes Security V2 =====================
// Deepens Prompts 13/14 on the SAME canonical models: CloudAccount /
// CloudResource / CloudIdentity / CloudRelationship / CloudRiskPath /
// CloudDriftEvent, ContainerRegistry / ContainerImage (+ snapshots and
// the Prompt 12/30 SBOM subsystem), KubernetesCluster /
// KubernetesWorkload / RuntimeSecurityEvent. Nothing here can hold
// credential material, kubeconfig content or secret values: accounts
// and clusters store secret REFERENCES only (§10/§72), resource
// snapshots store bounded sanitized security configuration (§17), and
// Kubernetes inventory stores Secret METADATA only (§83).

// One governed connection test (§12): the outcome of evaluating an
// account's credential reference + provider transport. The record
// carries the verdict and the permission limitations discovered —
// never a credential value, and forbidden operations are never
// retried in a loop (§13).
model CloudConnectionTest {
  id                 String       @id @default(uuid())
  workspaceId        String
  cloudAccountId     String
  result             String // CONNECTED | CONNECTED_WITH_LIMITATIONS | AUTH_FAILED | PERMISSION_LIMITED | EXPIRED | UNREACHABLE
  limitations        Json         @default("[]") // [{ code, detail }] — incl. transport NOT_CONFIGURED honesty
  missingPermissions Json         @default("[]") // provider permission names only (§13)
  accountMatch       Boolean      @default(true) // §145: credential/account identity match
  testedById         String?
  testedAt           DateTime     @default(now())
  account            CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cloudAccountId, testedAt])
}

// An immutable per-resource configuration snapshot (§17): the bounded,
// sanitized security configuration of ONE CloudResource at a point in
// time. Snapshot-vs-snapshot comparison drives §18 drift. No
// updatedAt by design — snapshots are never rewritten.
model CloudResourceSnapshot {
  id                String        @id @default(uuid())
  workspaceId       String
  cloudAccountId    String
  cloudResourceId   String
  runId             String? // CloudV2AssessmentRun that captured it
  configuration     Json          @default("{}") // bounded sanitized security metadata only
  configurationHash String
  exposure          String        @default("UNKNOWN")
  capturedAt        DateTime      @default(now())
  account           CloudAccount  @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  resource          CloudResource @relation(fields: [cloudResourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cloudResourceId, capturedAt])
  @@index([cloudAccountId, capturedAt])
}

// One V2 orchestrator run (§103–§105): the pipeline record for a cloud,
// container or Kubernetes assessment. Stages advance over STORED
// inventory + governed adapter results only; a run whose inputs are
// incomplete ends COMPLETED_WITH_GAPS (§110) — never "clean".
model CloudV2AssessmentRun {
  id             String    @id @default(uuid())
  workspaceId    String
  domain         String // CLOUD | CONTAINER | KUBERNETES
  cloudAccountId String?
  clusterId      String?
  imageId        String?
  scanId         String?
  pipeline       Json      @default("[]") // [{ stage, status, detail }] in §103–§105 order
  status         String    @default("RUNNING") // RUNNING | COMPLETED | COMPLETED_WITH_GAPS | FAILED | BLOCKED
  blockedReason  String?
  startedById    String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([workspaceId, domain])
  @@index([cloudAccountId])
  @@index([clusterId])
  @@index([imageId])
}

// Versioned, immutable baselines (§97–§99). Rules are declarative
// expectations over posture facts (never provider mutations); drift is
// the deviation of current facts from the approved baseline (§100).
model CloudSecurityBaseline {
  id             String   @id @default(uuid())
  workspaceId    String
  cloudAccountId String? // null = workspace/provider-wide baseline
  provider       String?
  version        Int
  rules          Json     @default("[]") // [{ ruleId, expectation, severity }]
  hash           String
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([workspaceId, cloudAccountId, provider, version])
  @@index([workspaceId, createdAt])
}

model ContainerSecurityBaseline {
  id          String   @id @default(uuid())
  workspaceId String
  registryId  String? // null = workspace-wide baseline
  version     Int
  rules       Json     @default("[]") // [{ ruleId, expectation, severity }]
  hash        String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, registryId, version])
  @@index([workspaceId, createdAt])
}

model KubernetesSecurityBaseline {
  id          String   @id @default(uuid())
  workspaceId String
  clusterId   String? // null = workspace-wide baseline
  version     Int
  rules       Json     @default("[]") // [{ ruleId, expectation, severity }]
  hash        String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, clusterId, version])
  @@index([workspaceId, createdAt])
}

// Coverage records (§111–§114): what an assessment actually saw, and
// what it could not — every gap carries a §115 skipped reason. A
// coverage row with gaps makes its run COMPLETED_WITH_GAPS (§110);
// missing permission is never reported as a clean result (§166).
model CloudSecurityCoverage {
  id                String   @id @default(uuid())
  workspaceId       String
  runId             String?  @unique
  cloudAccountId    String
  accountsCovered   Int      @default(0)
  regionsCovered    Int      @default(0)
  regionsAuthorized Int      @default(0)
  servicesCovered   Int      @default(0)
  resourcesCovered  Int      @default(0)
  iamIdentities     Int      @default(0)
  postureChecks     Int      @default(0)
  gaps              Json     @default("[]") // [{ area, reason, detail }] — reason ∈ §115 set
  completion        String   @default("COMPLETED_WITH_GAPS")
  createdAt         DateTime @default(now())

  @@index([workspaceId])
  @@index([cloudAccountId, createdAt])
}

model ContainerSecurityCoverage {
  id                    String   @id @default(uuid())
  workspaceId           String
  runId                 String?  @unique
  imageId               String?
  registriesCovered     Int      @default(0)
  repositoriesCovered   Int      @default(0)
  imagesCovered         Int      @default(0)
  sbomCoverage          Float? // null when unknown — never fabricated (§113)
  vulnerabilityCoverage Float?
  deploymentCorrelated  Int      @default(0)
  gaps                  Json     @default("[]")
  completion            String   @default("COMPLETED_WITH_GAPS")
  createdAt             DateTime @default(now())

  @@index([workspaceId])
  @@index([imageId, createdAt])
}

model KubernetesSecurityCoverage {
  id                String   @id @default(uuid())
  workspaceId       String
  runId             String?  @unique
  clusterId         String
  namespacesCovered Int      @default(0)
  workloadsCovered  Int      @default(0)
  rbacSubjects      Int      @default(0)
  benchmarkChecks   Int      @default(0)
  imagesCorrelated  Int      @default(0)
  runtimeTelemetry  Boolean  @default(false)
  gaps              Json     @default("[]")
  completion        String   @default("COMPLETED_WITH_GAPS")
  createdAt         DateTime @default(now())

  @@index([workspaceId])
  @@index([clusterId, createdAt])
}

// Kubernetes RBAC inventory (§76): roles as DATA (rules are permission
// metadata — never credentials). Analysis is defensive: wildcards,
// cluster-admin-like bindings and dangerous verbs/resources become
// findings + graph edges (§77); privileges are never used (§152).
model KubernetesRole {
  id          String            @id @default(uuid())
  workspaceId String
  clusterId   String
  kind        String // Role | ClusterRole
  namespace   String? // null for ClusterRole
  name        String
  rules       Json              @default("[]") // [{ resources, verbs, apiGroups, resourceNames? }]
  labels      Json              @default("{}")
  firstSeen   DateTime          @default(now())
  lastSeen    DateTime          @updatedAt
  cluster     KubernetesCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, kind, namespace, name])
  @@index([workspaceId])
  @@index([clusterId])
}

model KubernetesRoleBinding {
  id          String            @id @default(uuid())
  workspaceId String
  clusterId   String
  kind        String // RoleBinding | ClusterRoleBinding
  namespace   String? // null for ClusterRoleBinding
  name        String
  roleKind    String // Role | ClusterRole
  roleName    String
  subjects    Json              @default("[]") // [{ kind: ServiceAccount|User|Group, name, namespace? }] — identities, never tokens (§84)
  firstSeen   DateTime          @default(now())
  lastSeen    DateTime          @updatedAt
  cluster     KubernetesCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, kind, namespace, name])
  @@index([workspaceId])
  @@index([clusterId])
}

// A Falco runtime event correlated to platform context (§94): the
// workload, image and known-vulnerability links evidence supports.
// Correlation raises CONTEXTUAL risk only — the original scanner
// severity is never altered (§95), and no response action is taken
// against the workload (§96).
model RuntimeEventCorrelation {
  id             String   @id @default(uuid())
  workspaceId    String
  eventId        String   @unique // RuntimeSecurityEvent id
  clusterId      String?
  workloadRef    String? // namespace/kind/name
  imageRef       String? // repository@digest where evidence supports it
  imageId        String? // ContainerImage id when the digest resolves
  findingIds     Json     @default("[]")
  confidence     String   @default("LOW") // LOW | MEDIUM | HIGH
  socAlertLinked Boolean  @default(false) // §141: high-confidence signals link a SOC alert without duplication
  detail         String   @default("")
  createdAt      DateTime @default(now())

  @@index([workspaceId])
  @@index([clusterId])
}
