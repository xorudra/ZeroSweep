  AWS
  AZURE
  GCP
  ACTIVE_DIRECTORY
  BINARY
  WIRELESS_LAB
}

enum TargetStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ARCHIVED
}

