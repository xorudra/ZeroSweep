  // DIRECTORY_INVENTORY, SMB_POSTURE, PINGCASTLE_POSTURE and ADCS_POSTURE
  // are tool/connector stages on DIRECTORY_ANALYSIS workers only.
  DOMAIN_DISCOVERY
  DIRECTORY_INVENTORY
  LDAP_POSTURE
  SMB_POSTURE
  GRAPH_COLLECTION
  PINGCASTLE_POSTURE
