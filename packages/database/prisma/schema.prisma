  MOBILE_STATIC_BASELINE
  MOBILE_STATIC_COMPREHENSIVE
  MOBILE_SECRETS_ONLY
  MOBILE_BINARY_ANALYSIS
  MOBILE_DYNAMIC_CONTROLLED
