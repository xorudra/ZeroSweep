// DSRclone — single Prisma schema (packages/database owns it; no competing schemas).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- Enums -------------------------------
