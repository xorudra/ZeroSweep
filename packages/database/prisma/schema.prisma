  MOBILE_STATIC_ANALYSIS
  MOBILE_BINARY_ANALYSIS
  MOBILE_DYNAMIC_SESSION
  MOBILE_TRAFFIC_ANALYSIS
  // Prompt 18 §10/§11: binary pipeline stages. BINARY_ARTIFACT_INTAKE
  // and BINARY_METADATA_EXTRACTION are PLATFORM stages (engine work
  // over the registered artifact: header parsing, string inventory,
  // platform findings); BINARY_HARDENING_ANALYSIS and
  // BINARY_STATIC_ANALYSIS are tool stages on BINARY_STATIC_ANALYSIS
  // workers only; BINARY_DEBUG_SESSION is the governed lab stage
  // (approved session + BINARY_DYNAMIC_LAB worker + kill switch).
  BINARY_ARTIFACT_INTAKE
  BINARY_METADATA_EXTRACTION
  BINARY_HARDENING_ANALYSIS
  BINARY_STATIC_ANALYSIS
  BINARY_DEBUG_SESSION
  // Prompt 19 §15: wireless pipeline stages. WIRELESS_CAPTURE_INTAKE
  // and WIRELESS_POSTURE_ANALYSIS are PLATFORM stages (intake proof +
  // deterministic posture/rogue/drift/gate analysis over persisted
  // inventory); WIRELESS_PASSIVE_DISCOVERY (Kismet) and
  // WIRELESS_PCAP_ANALYSIS (tshark/hcxtools/aircrack-metadata) are
  // tool stages on WIRELESS_PASSIVE_ANALYSIS workers only.
  WIRELESS_CAPTURE_INTAKE
  WIRELESS_PASSIVE_DISCOVERY
  WIRELESS_PCAP_ANALYSIS
  WIRELESS_POSTURE_ANALYSIS
  QUALITY_GATE
  NORMALIZATION
  CORRELATION
  RISK_ANALYSIS
  REPORT_GENERATION
