// Prompt 11 §47: the vulnerability-management lifecycle. This is the
// operational workflow state (triage → remediation → retest → closure);
// the Phase 7 FindingStatus remains the review verdict. The lifecycle
// service keeps the two mapped consistently.
enum VmLifecycleStatus {
  NEW
  TRIAGED
  CONFIRMED
  IN_PROGRESS
  REMEDIATED
  RETEST_PENDING
  RESOLVED
  FALSE_POSITIVE
  ACCEPTED_RISK
  // Prompt 20 §8: standardized lifecycle completion — a finding that was
  // resolved and recurred is REOPENED; an observation merged into a
  // canonical finding is DUPLICATE; risk reduced without full remediation
  // is MITIGATED. Existing values are untouched.
  REOPENED
  DUPLICATE
  MITIGATED
}

enum FindingVerificationStatus {
  UNVERIFIED
  LIKELY
